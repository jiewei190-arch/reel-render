        { "id": "ceo", "pose": "despair", "at": "head", "seated": true, "then": [{ "at": "10:Which", "pose": "fold" }] },
        { "id": "bm1", "pose": "idle", "at": "seatL1", "seated": true },
        { "id": "bm2", "pose": "idle", "at": "seatR1", "seated": true }
