{
  "kit": "biz3d",
  "slug": "segway-replace-cars",
  "format": "short",
  "hook": { "text": "THE *$100M* SCOOTER", "again": "7:And" },
  "music": "upbeat",
  "cast": {
    "inventor": { "suit": "#3A4A63", "tie": "#22C55E", "skin": "#E2B48E", "hair": "#2B1D14", "hairStyle": "short" },
    "investor": { "suit": "#2E3440", "tie": "#F5B324", "skin": "#D9A47E", "hair": "#8A8A8A", "hairStyle": "bald" }
  },
  "chart": {
    "pts": [0.3, 1.6, 4.2, 7.4, 9.0, 4.0, 1.6, 0.9, 0.6],
    "tags": [{ "i": 0, "text": "2001" }, { "i": 8, "text": "2020" }]
  },
  "shots": [
    {
      "at": 0, "set": "boardroom", "note": "frame 0: the stake on a giant board over the inventor",
      "cam": { "preset": "hookZoom", "target": "inventor", "dist": 3.4, "h": 0.35, "face": 0.84 },
      "actors": [{ "id": "inventor", "pose": "fold", "at": "head", "seated": true, "then": [{ "at": 0.45, "pose": "celebrate" }] }],
      "fx": [{ "fx": "shake", "at": 0.45, "gain": 0.8 }],
      "devices": [{ "do": "board", "size": "giant", "title": "to develop", "value": "$100M", "at": 0, "until": 1, "tone": "red" }]
    },
    {
      "at": 1.0, "set": "boardroom", "note": "the development money",
      "cam": { "preset": "pushIn", "target": "cash", "dist": 2.6, "h": 0.9, "az": -25, "face": 0.55 },
      "props": [{ "id": "cash", "kit": "cash", "at": "tableTop:0,0,1.2", "motion": "dropIn", "hit": 1.25 }],
      "devices": [{ "do": "counter", "title": "development cost", "from": 0, "to": 100000000, "at": 1.05, "dur": 0.8, "land": "1:million" }]
    },
    {
      "at": "1:It", "set": "city", "note": "the street it was meant to change",
      "cam": { "preset": "crane", "target": "stores:0,0.9,0", "dist": 9.5, "h": 1.4 },
      "devices": [{ "do": "stamp", "text": "REPLACE CARS?", "tone": "red", "at": "1:replace", "until": "2:It" }]
    },
    {
      "at": "2:It", "set": "city", "note": "the 2001 unveiling",
      "cam": { "preset": "slamZoom", "target": "hq:0,4.2,0", "dist": 16, "h": 1.5, "hit": "2:It+0.12" },
      "props": [{ "id": "hq", "kit": "tower", "at": "hq", "size": [2.6, 8.5, 2.4] }],
      "devices": [{ "do": "board", "title": "unveiled", "value": "2001", "at": "2:two", "pos": "top", "tone": "green" }]
    },
    {
      "at": "2:Its", "set": "boardroom", "note": "the inventor's promise",
      "cam": { "preset": "orbit", "target": "inventor", "dist": 3.7, "h": 0.5, "az": 200, "sweep": 30, "face": 0.56 },
      "actors": [{ "id": "inventor", "pose": "talk", "at": "foot", "then": [{ "at": "2:car", "pose": "point" }, { "at": "2:horse", "pose": "celebrate" }] }],
      "actions": [{ "do": "label", "on": "inventor.head", "text": "the inventor", "at": "2:inventor", "until": "2:car", "tone": "green" }]
    },
    {
      "at": "3:One", "set": "boardroom", "note": "one investor's forecast",
      "cam": { "preset": "medium", "target": "investor", "dist": 3.8, "h": 0.3, "az": 168, "face": 0.6 },
      "actors": [{ "id": "investor", "pose": "talk", "at": "foot", "then": [{ "at": "3:predicted", "pose": "point" }] }],
      "actions": [{ "do": "label", "on": "investor.head", "text": "one investor", "at": "3:investor", "until": "3:fastest", "tone": "green" }]
    },
    {
      "at": "3:fastest", "set": "chart", "note": "SIGNATURE: the forecast climb (illustrative)",
      "cam": { "preset": "chartFly", "from": 0, "to": 4.2, "dist": 7.5, "h": 2.4, "az": 40 },
      "devices": [{ "do": "counter", "title": "predicted sales", "from": 0, "to": 1000000000, "at": "3:climb", "dur": 1.0, "tone": "green", "land": "3:billion" }]
    },
    {
      "at": "4:The", "set": "warehouse", "note": "a factory built for volume",
      "cam": { "preset": "dolly", "target": "conveyor", "dist": 5.2, "h": 1.0, "az": 8, "sweep": 1.6 },
      "devices": [{ "do": "board", "title": "built for, monthly", "value": "40,000", "at": "4:forty", "pos": "top", "tone": "green" }]
    },
    {
      "at": "5:In", "set": "chart", "note": "what happened: the dive",
      "cam": { "preset": "chartFly", "from": 4.0, "to": 8, "dist": 7.5, "h": 2.4, "az": 40 },
      "devices": [{ "do": "board", "title": "sold, ~19 years", "value": "~140,000", "at": "5:about", "pos": "left", "tone": "red" }]
    },
    {
      "at": "6:Production", "set": "city", "note": "production ends",
      "cam": { "preset": "pushIn", "target": "stores:0,0.9,0", "dist": 10, "h": 2.2, "az": -8 },
      "actions": [{ "do": "dark", "on": "stores", "at": "6:ended", "stagger": 0.08, "order": "left" }],
      "devices": [{ "do": "stamp", "text": "ENDED 2020", "tone": "red", "at": "6:ended", "until": "7:The" }]
    },
    {
      "at": "7:The", "set": "boardroom", "note": "the lesson",
      "cam": { "preset": "closeUp", "target": "inventor.head", "dist": 2.9, "h": 0.3, "az": 15, "face": 0.38 },
      "actors": [{ "id": "inventor", "pose": "despair", "at": "head", "seated": true, "then": [{ "at": "7:not", "pose": "shrug" }] }]
    },
    {
      "at": "7:And", "set": "boardroom", "note": "loop: back to the inventor",
      "cam": { "preset": "hookZoom", "target": "inventor", "dist": 2.9, "h": 0.4, "face": 0.7 },
      "actors": [{ "id": "inventor", "pose": "shrug", "at": "head", "seated": true, "then": [{ "at": "7:yes,", "pose": "fold" }] }]
    }
  ]
}
