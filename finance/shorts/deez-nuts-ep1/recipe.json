  "8": { "speaker": "me", "text": "Then at lunch?! This BITCH-ASS MOTHERFUUUCKER would NOT! STOP! EVERY! DAMN! CHANCE!", "faces": { "me": "annoyed", "homie": "smug" }, "accent": ["lunch", "motherfucker", "not"] },
  "9": { "speaker": "homie", "text": "Yo bro. Deez nuts. Deez nuts. Deez nuts! DEEZ NUTS!", "faces": { "homie": "smug" }, "accent": ["bro", "nuts"] },
  "10": { "speaker": "me", "text": "NON! FUUUCKING! STOP!", "shout": true, "faces": { "me": "furious" } },
  "11": { "speaker": "me", "text": "BRO, SHUT THE FUUUCK UUUP!", "shout": true, "faces": { "me": "furious" }, "accent": ["bro", "shut", "fuck", "up"] },
  "12": { "speaker": "me", "text": "I yelled so FUUUCKING LOUD it broke the lunchroom windows!", "faces": { "homie": "shocked" }, "accent": ["yelled", "loud", "broke", "windows"] },
  "13": { "speaker": "homie", "text": "Deez nu—", "faces": { "homie": "smug" } }
 },
