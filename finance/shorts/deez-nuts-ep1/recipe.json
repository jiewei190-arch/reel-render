  "1": { "speaker": "homie", "text": "DEEZ NUTS! DEEZ NUTS!", "shout": true, "faces": { "homie": "yell" } },
  "2": { "speaker": "me", "text": "BRUH. My homie was watching YouTube in class the other day, and he turns to me like...", "faces": { "me": "deadpan" }, "accent": ["bruh", "homie", "youtube", "class", "turns"] },
  "3": { "speaker": "homie", "text": "Bro. Do you know who Deez is?", "faces": { "homie": "smug" }, "accent": ["bro", "deez"] },
  "4": { "speaker": "me", "text": "And me, not knowing this MOTHERFUUUCKER was watching old-ASS Vine videos about Deez Nuts... I said...", "faces": { "me": "sideeye" }, "accent": ["knowing", "vine", "deez", "said"] },
