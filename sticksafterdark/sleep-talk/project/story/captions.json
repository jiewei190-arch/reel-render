[
 {
  "start": 0.41,
  "end": 1.02,
  "text": "I use"
 },
 {
  "start": 1.04,
  "end": 1.44,
  "text": "an app"
 },
 {
  "start": 1.46,
  "end": 2.29,
  "text": "that records me"
 },
 {
  "start": 2.31,
  "end": 2.71,
  "text": "talking"
 },
 {
  "start": 2.73,
  "end": 3.75,
  "text": "in my sleep."
 },
 {
  "start": 4.11,
  "end": 4.57,
  "text": "Most nights,"
 },
 {
  "start": 4.59,
  "end": 6.19,
  "text": "it catches nothing."
 },
 {
  "start": 6.35,
  "end": 6.73,
  "text": "Maybe"
 },
 {
  "start": 6.75,
  "end": 7.75,
  "text": "a mumble."
 },
 {
  "start": 8.11,
  "end": 8.67,
  "text": "This morning,"
 },
 {
  "start": 8.69,
  "end": 9.06,
  "text": "it had"
 },
 {
  "start": 9.08,
  "end": 10.64,
  "text": "41 minutes."
 },
 {
  "start": 11.0,
  "end": 12.12,
  "text": "It's me."
 },
 {
  "start": 12.28,
  "end": 13.5,
  "text": "Whispering."
 },
 {
  "start": 13.66,
  "end": 14.65,
  "text": "Calm."
 },
 {
  "start": 15.01,
  "end": 15.61,
  "text": "Like I'm"
 },
 {
  "start": 15.63,
  "end": 17.06,
  "text": "answering questions."
 },
 {
  "start": 17.42,
  "end": 18.27,
  "text": "But there are"
 },
 {
  "start": 18.29,
  "end": 19.2,
  "text": "no questions."
 },
 {
  "start": 19.36,
  "end": 20.75,
  "text": "Just pauses."
 },
 {
  "start": 20.91,
  "end": 22.11,
  "text": "Long ones."
 },
 {
  "start": 23.92,
  "end": 25.34,
  "text": "Then my voice."
 },
 {
  "start": 25.7,
  "end": 26.81,
  "text": "Yes."
 },
 {
  "start": 28.22,
  "end": 29.29,
  "text": "The second door"
 },
 {
  "start": 29.31,
  "end": 30.52,
  "text": "on the left."
 },
 {
  "start": 31.63,
  "end": 32.09,
  "text": "She's a"
 },
 {
  "start": 32.11,
  "end": 33.47,
  "text": "heavy sleeper."
 },
 {
  "start": 35.28,
  "end": 36.18,
  "text": "The second door"
 },
 {
  "start": 36.2,
  "end": 36.87,
  "text": "on the left"
 },
 {
  "start": 36.89,
  "end": 37.78,
  "text": "is my little"
 },
 {
  "start": 37.8,
  "end": 38.88,
  "text": "sister's room."
 },
 {
  "start": 39.24,
  "end": 40.48,
  "text": "I ran in."
 },
 {
  "start": 40.64,
  "end": 41.94,
  "text": "She was fine."
 },
 {
  "start": 42.1,
  "end": 43.44,
  "text": "Still asleep."
 },
 {
  "start": 43.8,
  "end": 44.36,
  "text": "I went back"
 },
 {
  "start": 44.38,
  "end": 45.73,
  "text": "to the recording."
 },
 {
  "start": 46.64,
  "end": 47.37,
  "text": "At the very"
 },
 {
  "start": 47.39,
  "end": 47.56,
  "text": "end,"
 },
 {
  "start": 47.58,
  "end": 48.31,
  "text": "after a long"
 },
 {
  "start": 48.33,
  "end": 48.87,
  "text": "silence,"
 },
 {
  "start": 48.89,
  "end": 49.99,
  "text": "there's one more"
 },
 {
  "start": 50.01,
  "end": 50.77,
  "text": "voice."
 },
 {
  "start": 51.68,
  "end": 52.17,
  "text": "It isn't"
 },
 {
  "start": 52.19,
  "end": 53.08,
  "text": "mine."
 },
 {
  "start": 55.09,
  "end": 56.79,
  "text": "Thank you."
 }
]