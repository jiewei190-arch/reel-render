[
 {
  "i": 0,
  "start": 0.45,
  "end": 3.398,
  "text": "I use an app that records me talking in my sleep."
 },
 {
  "i": 1,
  "start": 4.148,
  "end": 5.843,
  "text": "Most nights, it catches nothing."
 },
 {
  "i": 2,
  "start": 6.393,
  "end": 7.397,
  "text": "Maybe a mumble."
 },
 {
  "i": 3,
  "start": 8.147,
  "end": 10.288,
  "text": "This morning, it had forty-one minutes."
 },
 {
  "i": 4,
  "start": 11.038,
  "end": 11.767,
  "text": "It's me."
 },
 {
  "i": 5,
  "start": 12.317,
  "end": 13.147,
  "text": "Whispering."
 },
 {
  "i": 6,
  "start": 13.697,
  "end": 14.296,
  "text": "Calm."
 },
 {
  "i": 7,
  "start": 15.046,
  "end": 16.714,
  "text": "Like I'm answering questions."
 },
 {
  "i": 8,
  "start": 17.464,
  "end": 18.85,
  "text": "But there are no questions."
 },
 {
  "i": 9,
  "start": 19.4,
  "end": 20.398,
  "text": "Just pauses."
 },
 {
  "i": 10,
  "start": 20.948,
  "end": 21.757,
  "text": "Long ones."
 },
 {
  "i": 11,
  "start": 23.957,
  "end": 24.991,
  "text": "Then my voice."
 },
 {
  "i": 12,
  "start": 25.741,
  "end": 26.457,
  "text": "Yes."
 },
 {
  "i": 13,
  "start": 28.257,
  "end": 30.168,
  "text": "The second door on the left."
 },
 {
  "i": 14,
  "start": 31.668,
  "end": 33.121,
  "text": "She's a heavy sleeper."
 },
 {
  "i": 15,
  "start": 35.321,
  "end": 38.53,
  "text": "The second door on the left is my little sister's room."
 },
 {
  "i": 16,
  "start": 39.28,
  "end": 40.132,
  "text": "I ran in."
 },
 {
  "i": 17,
  "start": 40.682,
  "end": 41.588,
  "text": "She was fine."
 },
 {
  "i": 18,
  "start": 42.138,
  "end": 43.088,
  "text": "Still asleep."
 },
 {
  "i": 19,
  "start": 43.838,
  "end": 45.383,
  "text": "I went back to the recording."
 },
 {
  "i": 20,
  "start": 46.683,
  "end": 50.422,
  "text": "At the very end, after a long silence, there's one more voice."
 },
 {
  "i": 21,
  "start": 51.722,
  "end": 52.727,
  "text": "It isn't mine."
 },
 {
  "i": 22,
  "start": 55.127,
  "end": 56.438,
  "text": "Thank you."
 },
 {
  "i": 23,
  "start": 58.238,
  "end": 59.284,
  "text": "Follow for more."
 }
]