[
 {
  "i": 0,
  "start": 0.08,
  "end": 4.4,
  "text": "My little brother is scared of the dark, so we leave the hall light on."
 },
 {
  "i": 1,
  "start": 4.4,
  "end": 6.6,
  "text": "Tonight, at midnight, it clicked off."
 },
 {
  "i": 2,
  "start": 7.12,
  "end": 9.0,
  "text": "I got up to turn it back on."
 },
 {
  "i": 3,
  "start": 9.0,
  "end": 10.94,
  "text": "From his room, he whispered:"
 },
 {
  "i": 4,
  "start": 12.02,
  "end": 12.54,
  "text": "Don't."
 },
 {
  "i": 5,
  "start": 12.54,
  "end": 15.24,
  "text": "It turned it off so you'd come out."
 },
 {
  "i": 6,
  "start": 16.22,
  "end": 17.68,
  "text": "I got back in bed."
 },
 {
  "i": 7,
  "start": 19.85,
  "end": 22.47,
  "text": "My brother is at Grandma's this week."
 },
 {
  "i": 8,
  "start": 24.39,
  "end": 25.69,
  "text": "Follow for more."
 }
]