[
 {
  "i": 0,
  "start": 0.45,
  "end": 3.138,
  "text": "Every night, I brush my teeth in the same mirror."
 },
 {
  "i": 1,
  "start": 3.888,
  "end": 6.245,
  "text": "Tonight, my reflection blinked a little late."
 },
 {
  "i": 2,
  "start": 6.995,
  "end": 7.876,
  "text": "Just once."
 },
 {
  "i": 3,
  "start": 8.626,
  "end": 10.423,
  "text": "I told myself I was tired."
 },
 {
  "i": 4,
  "start": 11.173,
  "end": 12.265,
  "text": "I leaned in close."
 },
 {
  "i": 5,
  "start": 12.815,
  "end": 14.602,
  "text": "I smiled, to prove I was fine."
 },
 {
  "i": 6,
  "start": 15.352,
  "end": 16.98,
  "text": "My reflection smiled too."
 },
 {
  "i": 7,
  "start": 18.28,
  "end": 19.634,
  "text": "Then I stopped smiling."
 },
 {
  "i": 8,
  "start": 22.034,
  "end": 22.832,
  "text": "It didn't."
 },
 {
  "i": 9,
  "start": 24.432,
  "end": 25.478,
  "text": "Follow for more."
 }
