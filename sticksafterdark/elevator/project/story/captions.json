[
 {
  "start": 0.41,
  "end": 1.737,
  "text": "I work late."
 },
 {
  "start": 1.897,
  "end": 2.404,
  "text": "Most nights,"
 },
 {
  "start": 2.384,
  "end": 3.135,
  "text": "I'm the last"
 },
 {
  "start": 3.115,
  "end": 4.235,
  "text": "one out."
 },
 {
  "start": 4.595,
  "end": 5.049,
  "text": "Last night,"
 },
 {
  "start": 5.029,
  "end": 5.7,
  "text": "I got in"
 },
 {
  "start": 5.68,
  "end": 6.785,
  "text": "the elevator"
 },
 {
  "start": 6.765,
  "end": 7.219,
  "text": "on the"
 },
 {
  "start": 7.199,
  "end": 7.653,
  "text": "9th floor"
 },
 {
  "start": 7.633,
  "end": 8.304,
  "text": "and pressed"
 },
 {
  "start": 8.284,
  "end": 9.108,
  "text": "lobby."
 },
 {
  "start": 9.468,
  "end": 9.938,
  "text": "On 8,"
 },
 {
  "start": 9.918,
  "end": 10.984,
  "text": "it stopped."
 },
 {
  "start": 11.144,
  "end": 12.616,
  "text": "The doors opened."
 },
 {
  "start": 12.976,
  "end": 14.323,
  "text": "Nobody there."
 },
 {
  "start": 14.483,
  "end": 15.283,
  "text": "Just a dark"
 },
 {
  "start": 15.263,
  "end": 16.172,
  "text": "hallway."
 },
 {
  "start": 16.532,
  "end": 18.018,
  "text": "The doors closed."
 },
 {
  "start": 18.378,
  "end": 18.967,
  "text": "On 7,"
 },
 {
  "start": 18.947,
  "end": 20.286,
  "text": "it stopped again."
 },
 {
  "start": 20.446,
  "end": 21.636,
  "text": "Nobody."
 },
 {
  "start": 21.996,
  "end": 22.997,
  "text": "6."
 },
 {
  "start": 23.157,
  "end": 24.186,
  "text": "5."
 },
 {
  "start": 24.346,
  "end": 25.346,
  "text": "4."
 },
 {
  "start": 25.706,
  "end": 26.478,
  "text": "Every floor,"
 },
 {
  "start": 26.458,
  "end": 27.788,
  "text": "the doors opened."
 },
 {
  "start": 27.948,
  "end": 28.734,
  "text": "Every floor,"
 },
 {
  "start": 28.714,
  "end": 29.308,
  "text": "nobody"
 },
 {
  "start": 29.288,
  "end": 30.062,
  "text": "got on."
 },
 {
  "start": 30.422,
  "end": 31.166,
  "text": "I figured"
 },
 {
  "start": 31.146,
  "end": 32.26,
  "text": "it was broken."
 },
 {
  "start": 32.62,
  "end": 33.254,
  "text": "I stared"
 },
 {
  "start": 33.234,
  "end": 34.072,
  "text": "at my phone"
 },
 {
  "start": 34.052,
  "end": 34.685,
  "text": "and tried not"
 },
 {
  "start": 34.665,
  "end": 35.094,
  "text": "to look"
 },
 {
  "start": 35.074,
  "end": 36.486,
  "text": "into the hallways."
 },
 {
  "start": 36.846,
  "end": 38.319,
  "text": "The light flickered."
 },
 {
  "start": 38.679,
  "end": 39.631,
  "text": "The elevator"
 },
 {
  "start": 39.611,
  "end": 40.561,
  "text": "got slower."
 },
 {
  "start": 40.721,
  "end": 41.79,
  "text": "Heavier."
 },
 {
  "start": 42.15,
  "end": 43.214,
  "text": "The cable groaned,"
 },
 {
  "start": 43.194,
  "end": 44.049,
  "text": "like it was"
 },
 {
  "start": 44.029,
  "end": 44.883,
  "text": "carrying more"
 },
 {
  "start": 44.863,
  "end": 45.879,
  "text": "than just me."
 },
 {
  "start": 46.789,
  "end": 47.855,
  "text": "Lobby."
 },
 {
  "start": 48.015,
  "end": 48.982,
  "text": "The doors opened,"
 },
 {
  "start": 48.962,
  "end": 50.298,
  "text": "and I stepped out."
 },
 {
  "start": 51.208,
  "end": 51.897,
  "text": "Behind me,"
 },
 {
  "start": 51.877,
  "end": 52.789,
  "text": "the doors started"
 },
 {
  "start": 52.769,
  "end": 53.827,
  "text": "to close."
 },
 {
  "start": 54.187,
  "end": 54.914,
  "text": "I glanced back"
 },
 {
  "start": 54.894,
  "end": 55.62,
  "text": "at the mirror"
 },
 {
  "start": 55.6,
  "end": 55.973,
  "text": "on the"
 },
 {
  "start": 55.953,
  "end": 57.226,
  "text": "elevator wall."
 },
 {
  "start": 59.236,
  "end": 59.764,
  "text": "Someone"
 },
 {
  "start": 59.744,
  "end": 60.441,
  "text": "had gotten on"
 },
 {
  "start": 60.421,
  "end": 61.657,
  "text": "at every floor."
 }
]