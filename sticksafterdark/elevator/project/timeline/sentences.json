[
 {
  "i": 0,
  "start": 0.45,
  "end": 1.387,
  "text": "I work late."
 },
 {
  "i": 1,
  "start": 1.937,
  "end": 3.885,
  "text": "Most nights, I'm the last one out."
 },
 {
  "i": 2,
  "start": 4.635,
  "end": 8.758,
  "text": "Last night, I got in the elevator on the ninth floor and pressed lobby."
 },
 {
  "i": 3,
  "start": 9.508,
  "end": 10.634,
  "text": "On eight, it stopped."
 },
 {
  "i": 4,
  "start": 11.184,
  "end": 12.266,
  "text": "The doors opened."
 },
 {
  "i": 5,
  "start": 13.016,
  "end": 13.973,
  "text": "Nobody there."
 },
 {
  "i": 6,
  "start": 14.523,
  "end": 15.822,
  "text": "Just a dark hallway."
 },
 {
  "i": 7,
  "start": 16.572,
  "end": 17.668,
  "text": "The doors closed."
 },
 {
  "i": 8,
  "start": 18.418,
  "end": 19.936,
  "text": "On seven, it stopped again."
 },
 {
  "i": 9,
  "start": 20.486,
  "end": 21.286,
  "text": "Nobody."
 },
 {
  "i": 10,
  "start": 22.036,
  "end": 22.647,
  "text": "Six."
 },
 {
  "i": 11,
  "start": 23.197,
  "end": 23.836,
  "text": "Five."
 },
 {
  "i": 12,
  "start": 24.386,
  "end": 24.996,
  "text": "Four."
 },
 {
  "i": 13,
  "start": 25.746,
  "end": 27.438,
  "text": "Every floor, the doors opened."
 },
 {
  "i": 14,
  "start": 27.988,
  "end": 29.712,
  "text": "Every floor, nobody got on."
 },
 {
  "i": 15,
  "start": 30.462,
  "end": 31.91,
  "text": "I figured it was broken."
 },
 {
  "i": 16,
  "start": 32.66,
  "end": 36.136,
  "text": "I stared at my phone and tried not to look into the hallways."
 },
 {
  "i": 17,
  "start": 36.886,
  "end": 37.969,
  "text": "The light flickered."
 },
 {
  "i": 18,
  "start": 38.719,
  "end": 40.211,
  "text": "The elevator got slower."
 },
 {
  "i": 19,
  "start": 40.761,
  "end": 41.44,
  "text": "Heavier."
 },
 {
  "i": 20,
  "start": 42.19,
  "end": 45.529,
  "text": "The cable groaned, like it was carrying more than just me."
 },
 {
  "i": 21,
  "start": 46.829,
  "end": 47.505,
  "text": "Lobby."
 },
 {
  "i": 22,
  "start": 48.055,
  "end": 49.948,
  "text": "The doors opened, and I stepped out."
 },
 {
  "i": 23,
  "start": 51.248,
  "end": 53.477,
  "text": "Behind me, the doors started to close."
 },
 {
  "i": 24,
  "start": 54.227,
  "end": 56.876,
  "text": "I glanced back at the mirror on the elevator wall."
 },
 {
  "i": 25,
  "start": 59.276,
  "end": 61.307,
  "text": "Someone had gotten on at every floor."
 },
 {
  "i": 26,
  "start": 63.107,
  "end": 64.153,
  "text": "Follow for more."
 }
]