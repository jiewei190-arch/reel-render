[
 {
  "i": 0,
  "start": 0.45,
  "end": 3.077,
  "text": "Our cabin is six miles from the nearest road."
 },
 {
  "i": 1,
  "start": 3.827,
  "end": 6.719,
  "text": "Last night, it snowed for the first time this winter."
 },
 {
  "i": 2,
  "start": 7.469,
  "end": 10.134,
  "text": "This morning, I looked out my bedroom window."
 },
 {
  "i": 3,
  "start": 10.884,
  "end": 11.671,
  "text": "Footprints."
 },
 {
  "i": 4,
  "start": 12.221,
  "end": 13.023,
  "text": "Bare feet."
 },
 {
  "i": 5,
  "start": 13.773,
  "end": 17.802,
  "text": "They started right under my window and walked away into the woods."
 },
 {
  "i": 6,
  "start": 18.552,
  "end": 20.594,
  "text": "No tracks coming toward the cabin."
 },
 {
  "i": 7,
  "start": 21.144,
  "end": 22.084,
  "text": "Only away."
 },
 {
  "i": 8,
  "start": 23.884,
  "end": 25.141,
  "text": "My window was locked."
 },
 {
  "i": 9,
  "start": 25.691,
  "end": 26.766,
  "text": "From the inside."
 },
 {
  "i": 10,
  "start": 27.516,
  "end": 28.741,
  "text": "I checked it twice."
 },
 {
  "i": 11,
  "start": 30.541,
  "end": 32.875,
  "text": "So whatever made them was in here with me."
 },
 {
  "i": 12,
  "start": 33.625,
  "end": 34.517,
  "text": "In my room."
 },
 {
  "i": 13,
  "start": 35.067,
  "end": 36.041,
  "text": "While I slept."
 },
 {
  "i": 14,
  "start": 36.791,
  "end": 37.743,
  "text": "And then it left."
 },
 {
  "i": 15,
  "start": 39.543,
  "end": 41.767,
  "text": "I told myself that was the good part."
 },
 {
  "i": 16,
  "start": 42.317,
  "end": 43.024,
  "text": "It left."
 },
 {
  "i": 17,
  "start": 43.774,
  "end": 45.111,
  "text": "I locked every door."
 },
 {
  "i": 18,
  "start": 45.661,
  "end": 46.689,
  "text": "I didn't sleep."
 },
 {
  "i": 19,
  "start": 48.489,
  "end": 49.848,
  "text": "It snowed again tonight."
 },
 {
  "i": 20,
  "start": 50.598,
  "end": 51.97,
  "text": "I just checked the window."
 },
 {
  "i": 21,
  "start": 54.37,
  "end": 55.806,
  "text": "There's a new set of tracks."
 },
 {
  "i": 22,
  "start": 57.606,
  "end": 58.473,
  "text": "Coming back."
 },
 {
  "i": 23,
  "start": 60.673,
  "end": 61.719,
  "text": "Follow for more."
 }
]