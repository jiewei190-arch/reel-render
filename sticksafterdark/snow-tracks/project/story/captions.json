[
 {
  "start": 0.41,
  "end": 1.306,
  "text": "Our cabin is"
 },
 {
  "start": 1.286,
  "end": 2.181,
  "text": "6 miles from"
 },
 {
  "start": 2.161,
  "end": 3.427,
  "text": "the nearest road."
 },
 {
  "start": 3.787,
  "end": 4.252,
  "text": "Last night,"
 },
 {
  "start": 4.232,
  "end": 5.142,
  "text": "it snowed for"
 },
 {
  "start": 5.122,
  "end": 6.031,
  "text": "the first time"
 },
 {
  "start": 6.011,
  "end": 7.069,
  "text": "this winter."
 },
 {
  "start": 7.429,
  "end": 8.115,
  "text": "This morning,"
 },
 {
  "start": 8.095,
  "end": 9.004,
  "text": "I looked out"
 },
 {
  "start": 8.984,
  "end": 10.484,
  "text": "my bedroom window."
 },
 {
  "start": 10.844,
  "end": 12.021,
  "text": "Footprints."
 },
 {
  "start": 12.181,
  "end": 13.373,
  "text": "Bare feet."
 },
 {
  "start": 13.733,
  "end": 14.649,
  "text": "They started right"
 },
 {
  "start": 14.629,
  "end": 15.768,
  "text": "under my window"
 },
 {
  "start": 15.748,
  "end": 16.887,
  "text": "and walked away"
 },
 {
  "start": 16.867,
  "end": 18.152,
  "text": "into the woods."
 },
 {
  "start": 18.512,
  "end": 19.44,
  "text": "No tracks coming"
 },
 {
  "start": 19.42,
  "end": 20.944,
  "text": "toward the cabin."
 },
 {
  "start": 21.104,
  "end": 22.434,
  "text": "Only away."
 },
 {
  "start": 23.844,
  "end": 24.702,
  "text": "My window was"
 },
 {
  "start": 24.682,
  "end": 25.491,
  "text": "locked."
 },
 {
  "start": 25.651,
  "end": 27.116,
  "text": "From the inside."
 },
 {
  "start": 27.476,
  "end": 28.312,
  "text": "I checked it"
 },
 {
  "start": 28.292,
  "end": 29.091,
  "text": "twice."
 },
 {
  "start": 30.501,
  "end": 31.598,
  "text": "So whatever made"
 },
 {
  "start": 31.578,
  "end": 32.136,
  "text": "them was in"
 },
 {
  "start": 32.116,
  "end": 33.225,
  "text": "here with me."
 },
 {
  "start": 33.585,
  "end": 34.867,
  "text": "In my room."
 },
 {
  "start": 35.027,
  "end": 36.391,
  "text": "While I slept."
 },
 {
  "start": 36.751,
  "end": 37.485,
  "text": "And then it"
 },
 {
  "start": 37.465,
  "end": 38.093,
  "text": "left."
 },
 {
  "start": 39.503,
  "end": 40.511,
  "text": "I told myself"
 },
 {
  "start": 40.491,
  "end": 41.253,
  "text": "that was the"
 },
 {
  "start": 41.233,
  "end": 42.117,
  "text": "good part."
 },
 {
  "start": 42.277,
  "end": 43.374,
  "text": "It left."
 },
 {
  "start": 43.734,
  "end": 44.9,
  "text": "I locked every"
 },
 {
  "start": 44.88,
  "end": 45.461,
  "text": "door."
 },
 {
  "start": 45.621,
  "end": 47.039,
  "text": "I didn't sleep."
 },
 {
  "start": 48.449,
  "end": 49.44,
  "text": "It snowed again"
 },
 {
  "start": 49.42,
  "end": 50.198,
  "text": "tonight."
 },
 {
  "start": 50.558,
  "end": 51.362,
  "text": "I just checked"
 },
 {
  "start": 51.342,
  "end": 52.32,
  "text": "the window."
 },
 {
  "start": 54.33,
  "end": 55.17,
  "text": "There's a new"
 },
 {
  "start": 55.15,
  "end": 56.156,
  "text": "set of tracks."
 },
 {
  "start": 57.566,
  "end": 58.823,
  "text": "Coming back."
 }
]