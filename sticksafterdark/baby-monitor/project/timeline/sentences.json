[
 {
  "i": 0,
  "start": 0.45,
  "end": 4.042,
  "text": "We put a baby monitor in our daughter's room when she turned two."
 },
 {
  "i": 1,
  "start": 4.792,
  "end": 6.97,
  "text": "Last night, around three, it crackled on."
 },
 {
  "i": 2,
  "start": 7.72,
  "end": 8.845,
  "text": "Someone was humming."
 },
 {
  "i": 3,
  "start": 9.395,
  "end": 10.031,
  "text": "Soft."
 },
 {
  "i": 4,
  "start": 10.581,
  "end": 11.227,
  "text": "Slow."
 },
 {
  "i": 5,
  "start": 11.777,
  "end": 12.639,
  "text": "A lullaby."
 },
 {
  "i": 6,
  "start": 14.439,
  "end": 15.898,
  "text": "I shook my wife awake."
 },
 {
  "i": 7,
  "start": 16.448,
  "end": 17.551,
  "text": "She heard it too."
 },
 {
  "i": 8,
  "start": 18.301,
  "end": 20.476,
  "text": "We ran down the hall and opened the door."
 },
 {
  "i": 9,
  "start": 21.226,
  "end": 23.056,
  "text": "Our daughter was sitting up in her crib."
 },
 {
  "i": 10,
  "start": 23.606,
  "end": 24.457,
  "text": "Wide awake."
 },
 {
  "i": 11,
  "start": 25.207,
  "end": 26.567,
  "text": "Nobody else in the room."
 },
 {
  "i": 12,
  "start": 27.117,
  "end": 28.115,
  "text": "The window locked."
 },
 {
  "i": 13,
  "start": 28.865,
  "end": 30.051,
  "text": "\"Who was singing to you?\""
 },
 {
  "i": 14,
  "start": 30.051,
  "end": 30.644,
  "text": "I asked."
 },
 {
  "i": 15,
  "start": 31.394,
  "end": 33.26,
  "text": "She pointed at the corner of the ceiling."
 },
 {
  "i": 16,
  "start": 35.26,
  "end": 36.576,
  "text": "The tall lady."
 },
 {
  "i": 17,
  "start": 36.576,
  "end": 38.88,
  "text": "She stopped when you came."
 },
 {
  "i": 18,
  "start": 40.48,
  "end": 42.201,
  "text": "We brought her to sleep in our bed."
 },
 {
  "i": 19,
  "start": 44.801,
  "end": 45.851,
  "text": "It's quiet now."
 },
 {
  "i": 20,
  "start": 46.401,
  "end": 47.937,
  "text": "Everyone's asleep but me."
 },
 {
  "i": 21,
  "start": 50.337,
  "end": 52.272,
  "text": "The monitor is still on the nightstand."
 },
 {
  "i": 22,
  "start": 53.022,
  "end": 54.313,
  "text": "Her room is empty."
 },
 {
  "i": 23,
  "start": 56.713,
  "end": 58.4,
  "text": "And it just started humming again."
 },
 {
  "i": 24,
  "start": 60.8,
  "end": 61.846,
  "text": "Follow for more."
 }
]