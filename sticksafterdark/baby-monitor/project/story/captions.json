[
 {
  "start": 0.41,
  "end": 1.03,
  "text": "We put a"
 },
 {
  "start": 1.01,
  "end": 2.0,
  "text": "baby monitor"
 },
 {
  "start": 2.0,
  "end": 3.02,
  "text": "in our daughter's room"
 },
 {
  "start": 3.0,
  "end": 4.6,
  "text": "when she turned 2."
 },
 {
  "start": 4.75,
  "end": 5.26,
  "text": "Last night,"
 },
 {
  "start": 5.24,
  "end": 5.98,
  "text": "around 3:00,"
 },
 {
  "start": 5.96,
  "end": 6.71,
  "text": "it crackled"
 },
 {
  "start": 6.69,
  "end": 7.4,
  "text": "on."
 },
 {
  "start": 7.68,
  "end": 9.2,
  "text": "Someone was humming."
 },
 {
  "start": 9.36,
  "end": 10.38,
  "text": "Soft."
 },
 {
  "start": 10.54,
  "end": 11.58,
  "text": "Slow."
 },
 {
  "start": 11.74,
  "end": 13.4,
  "text": "A lullaby."
 },
 {
  "start": 14.4,
  "end": 14.97,
  "text": "I shook my"
 },
 {
  "start": 14.95,
  "end": 16.25,
  "text": "wife awake."
 },
 {
  "start": 16.41,
  "end": 17.9,
  "text": "She heard it too."
 },
 {
  "start": 18.26,
  "end": 18.87,
  "text": "We ran down"
 },
 {
  "start": 18.85,
  "end": 19.47,
  "text": "the hall"
 },
 {
  "start": 19.45,
  "end": 20.83,
  "text": "and opened the door."
 },
 {
  "start": 21.19,
  "end": 21.94,
  "text": "Our daughter was"
 },
 {
  "start": 21.92,
  "end": 22.67,
  "text": "sitting up"
 },
 {
  "start": 22.65,
  "end": 23.41,
  "text": "in her crib."
 },
 {
  "start": 23.57,
  "end": 24.81,
  "text": "Wide awake."
 },
 {
  "start": 25.17,
  "end": 25.75,
  "text": "Nobody else"
 },
 {
  "start": 25.73,
  "end": 26.92,
  "text": "in the room."
 },
 {
  "start": 27.08,
  "end": 27.7,
  "text": "The window"
 },
 {
  "start": 27.68,
  "end": 28.46,
  "text": "locked."
 },
 {
  "start": 28.82,
  "end": 29.64,
  "text": "Who was singing"
 },
 {
  "start": 29.62,
  "end": 30.03,
  "text": "to you?"
 },
 {
  "start": 30.01,
  "end": 30.99,
  "text": "I asked."
 },
 {
  "start": 31.35,
  "end": 32.05,
  "text": "She pointed at"
 },
 {
  "start": 32.03,
  "end": 32.73,
  "text": "the corner"
 },
 {
  "start": 32.71,
  "end": 33.8,
  "text": "of the ceiling."
 },
 {
  "start": 35.22,
  "end": 35.9,
  "text": "The tall"
 },
 {
  "start": 35.88,
  "end": 36.56,
  "text": "lady."
 },
 {
  "start": 36.54,
  "end": 37.87,
  "text": "She stopped"
 },
 {
  "start": 37.85,
  "end": 39.23,
  "text": "when you came."
 },
 {
  "start": 40.44,
  "end": 41.11,
  "text": "We brought her"
 },
 {
  "start": 41.09,
  "end": 41.75,
  "text": "to sleep"
 },
 {
  "start": 41.73,
  "end": 42.7,
  "text": "in our bed."
 },
 {
  "start": 44.76,
  "end": 46.2,
  "text": "It's quiet now."
 },
 {
  "start": 46.36,
  "end": 47.2,
  "text": "Everyone's asleep"
 },
 {
  "start": 47.18,
  "end": 48.4,
  "text": "but me."
 },
 {
  "start": 50.3,
  "end": 51.28,
  "text": "The monitor is"
 },
 {
  "start": 51.27,
  "end": 51.86,
  "text": "still on"
 },
 {
  "start": 51.84,
  "end": 52.7,
  "text": "the nightstand."
 },
 {
  "start": 52.98,
  "end": 53.78,
  "text": "Her room is"
 },
 {
  "start": 53.76,
  "end": 54.9,
  "text": "empty."
 },
 {
  "start": 56.67,
  "end": 57.25,
  "text": "And it just"
 },
 {
  "start": 57.23,
  "end": 58.0,
  "text": "started humming"
 },
 {
  "start": 57.98,
  "end": 58.9,
  "text": "again."
 }
]