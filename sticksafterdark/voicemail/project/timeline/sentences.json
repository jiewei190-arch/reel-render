[
 {
  "i": 0,
  "start": 0.45,
  "end": 2.718,
  "text": "I always sleep with my phone on silent."
 },
 {
  "i": 1,
  "start": 3.468,
  "end": 5.166,
  "text": "So it was the light that woke me."
 },
 {
  "i": 2,
  "start": 5.716,
  "end": 6.853,
  "text": "One new voicemail."
 },
 {
  "i": 3,
  "start": 7.603,
  "end": 8.749,
  "text": "From my own number."
 },
 {
  "i": 4,
  "start": 9.499,
  "end": 10.935,
  "text": "Three twelve a.m."
 },
 {
  "i": 5,
  "start": 11.685,
  "end": 12.937,
  "text": "I thought it was a glitch."
 },
 {
  "i": 6,
  "start": 13.487,
  "end": 14.149,
  "text": "Spam."
 },
 {
  "i": 7,
  "start": 14.699,
  "end": 16.016,
  "text": "I almost deleted it."
 },
 {
  "i": 8,
  "start": 16.766,
  "end": 17.787,
  "text": "I pressed play."
 },
 {
  "i": 9,
  "start": 20.387,
  "end": 21.787,
  "text": "At first, just breathing."
 },
 {
  "i": 10,
  "start": 22.337,
  "end": 22.983,
  "text": "Slow."
 },
 {
  "i": 11,
  "start": 23.533,
  "end": 24.639,
  "text": "Close to the phone."
 },
 {
  "i": 12,
  "start": 25.389,
  "end": 28.928,
  "text": "Like someone lying very still, trying not to make a sound."
 },
 {
  "i": 13,
  "start": 29.678,
  "end": 31.239,
  "text": "Then my own voice, whispering."
 },
 {
  "i": 14,
  "start": 31.989,
  "end": 33.151,
  "text": "Don't get out of bed."
 },
 {
  "i": 15,
  "start": 33.151,
  "end": 34.312,
  "text": "Don't look under it."
 },
 {
  "i": 16,
  "start": 34.312,
  "end": 35.474,
  "text": "It's under there."
 },
 {
  "i": 17,
  "start": 38.474,
  "end": 39.457,
  "text": "I didn't move."
 },
 {
  "i": 18,
  "start": 40.207,
  "end": 41.76,
  "text": "I played it again, to be sure."
 },
 {
  "i": 19,
  "start": 42.31,
  "end": 43.142,
  "text": "It was me."
 },
 {
  "i": 20,
  "start": 43.692,
  "end": 45.017,
  "text": "It was definitely me."
 },
 {
  "i": 21,
  "start": 45.767,
  "end": 47.026,
  "text": "But I never said that."
 },
 {
  "i": 22,
  "start": 49.526,
  "end": 50.64,
  "text": "I checked the time."
 },
 {
  "i": 23,
  "start": 53.84,
  "end": 54.983,
  "text": "It was three eleven."
 },
 {
  "i": 24,
  "start": 57.583,
  "end": 58.629,
  "text": "Follow for more."
 }
]