  "end": 3.04,
  "text": "In 1752, Britain deleted 11 days."
 },
 {
  "i": 1,
  "start": 3.66,
  "end": 5.86,
  "text": "Its calendar had drifted out of step with the seasons."
 },
 {
  "i": 2,
  "start": 6.56,
  "end": 8.7,
  "text": "So Parliament just..."
 },
 {
  "i": 3,
  "start": 8.7,
  "end": 9.16,
  "text": "skipped them."
 },
 {
  "i": 4,
  "start": 9.74,
  "end": 11.34,
  "text": "Wednesday, September second."
 },
 {
  "i": 5,
  "start": 11.34,
  "end": 11.86,
  "text": "Next day?"
 },
 {
  "i": 6,
  "start": 12.3,
  "end": 14.16,
  "text": "Thursday, September fourteenth."
 },
 {
  "i": 7,
  "start": 14.16,
  "end": 15.78,
  "text": "The American colonies lost them too."
 },
 {
  "i": 8,
  "start": 16.32,
