[
 {
  "i": 0,
  "start": 0.0,
  "end": 5.16,
  "text": "In 2007, scientists strapped tiny animals to the OUTSIDE of a satellite."
 },
 {
  "i": 1,
  "start": 5.66,
  "end": 6.22,
  "text": "No suits."
 },
 {
  "i": 2,
  "start": 6.6,
  "end": 7.26,
  "text": "No oxygen."
 },
 {
  "i": 3,
  "start": 7.72,
  "end": 9.88,
  "text": "Just open space, for 10 straight days."
 },
 {
  "i": 4,
  "start": 10.34,
  "end": 13.98,
  "text": "The radiation out there is 1000x stronger than on Earth."
 },
 {
  "i": 5,
  "start": 14.48,
  "end": 16.86,
  "text": "When the satellite came home, they checked the bodies."
 },
 {
  "i": 6,
  "start": 17.5,
  "end": 18.76,
  "text": "And the animals were ALIVE."
 },
 {
  "i": 7,
  "start": 19.4,
  "end": 20.36,
  "text": "Some even laid eggs."
 },
 {
  "i": 8,
  "start": 20.36,
  "end": 21.94,
  "text": "They're called TARDIGRADES."
 },
 {
  "i": 9,
  "start": 22.42,
  "end": 26.6,
  "text": "Half a millimeter long, lives in moss, looks like a gummy bear with 8 legs."
 },
 {
  "i": 10,
  "start": 27.14,
  "end": 30.98,
  "text": "And now it's the first animal in history to survive outer space."
 },
 {
  "i": 11,
  "start": 31.6,
  "end": 31.98,
  "text": "NAKED."
 },
 {
  "i": 12,
  "start": 32.7,
  "end": 34.55,
  "text": "Which means the toughest astronaut ever."
 },
 {
  "i": 13,
  "start": 34.96,
  "end": 35.7,
  "text": "Is this guy."
 },
 {
  "i": 14,
  "start": 36.2,
  "end": 37.1,
  "text": "Subscribe for more."
 }
]