[
 {
  "i": 0,
  "start": 0.0,
  "end": 1.48,
  "text": "This rodent barely ages..."
 },
 {
  "i": 1,
  "start": 2.34,
  "end": 3.64,
  "text": "and almost never gets cancer."
 },
 {
  "i": 2,
  "start": 4.04,
  "end": 8.22,
  "text": "Meet the naked mole-rat: pink, wrinkly, nearly hairless, and all teeth."
 },
 {
  "i": 3,
  "start": 8.62,
  "end": 11.0,
  "text": "A house mouse this size lives four years, tops."
 },
 {
  "i": 4,
  "start": 11.58,
  "end": 11.98,
  "text": "This one?"
 },
 {
  "i": 5,
  "start": 12.36,
  "end": 12.84,
  "text": "Over 30."
 },
 {
  "i": 6,
  "start": 13.42,
  "end": 16.64,
  "text": "But here's the crazy part: its risk of dying doesn't go up with age."
 },
 {
  "i": 7,
  "start": 17.22,
  "end": 19.0,
  "text": "And big colonies watched for years?"
 },
 {
  "i": 8,
  "start": 19.5,
  "end": 20.72,
  "text": "Not a single case of cancer."
 },
 {
  "i": 9,
  "start": 21.3,
  "end": 22.28,
  "text": "But it gets weirder."
 },
 {
  "i": 10,
  "start": 22.64,
  "end": 24.76,
  "text": "They live like ants, with one queen in charge."
 },
 {
  "i": 11,
  "start": 25.24,
  "end": 26.24,
  "text": "Only the queen has babies."
 },
 {
  "i": 12,
  "start": 26.68,
  "end": 28.72,
  "text": "The rest dig tunnels, guard, and babysit."
 },
 {
  "i": 13,
  "start": 28.72,
  "end": 30.56,
  "text": "And when the air runs out?"
 },
 {
  "i": 14,
  "start": 30.82,
  "end": 32.94,
  "text": "It survives 18 minutes with zero oxygen."
 },
 {
  "i": 15,
  "start": 33.36,
  "end": 37.16,
  "text": "Its body switches to burning fructose, a sugar, instead."
 },
 {
  "i": 16,
  "start": 38.26,
  "end": 39.76,
  "text": "Scientists now study it for clues to aging..."
 },
 {
  "i": 17,
  "start": 40.26,
  "end": 40.7,
  "text": "in us."
 },
 {
  "i": 18,
  "start": 41.4,
  "end": 42.3,
  "text": "Subscribe for more."
 }
]