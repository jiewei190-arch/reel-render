[
 {
  "i": 0,
  "start": 0.0,
  "end": 2.86,
  "text": "A masked stranger hijacked Chicago TV in 1987."
 },
 {
  "i": 1,
  "start": 3.6,
  "end": 3.72,
  "text": "Twice."
 },
 {
  "i": 2,
  "start": 4.36,
  "end": 5.22,
  "text": "The nine o'clock news."
 },
 {
  "i": 3,
  "start": 5.64,
  "end": 6.38,
  "text": "The sports report..."
 },
 {
  "i": 4,
  "start": 6.9,
  "end": 7.94,
  "text": "and then, this."
 },
 {
  "i": 5,
  "start": 8.44,
  "end": 12.32,
  "text": "A man in a rubber mask and sunglasses, dressed as an 80s TV character."
 },
 {
  "i": 6,
  "start": 12.86,
  "end": 16.84,
  "text": "Behind him, a swiveling sheet of metal, mimicking the character's fancy background."
 },
 {
  "i": 7,
  "start": 17.24,
  "end": 17.74,
  "text": "No voice."
 },
 {
  "i": 8,
  "start": 18.18,
  "end": 18.9,
  "text": "Just a loud buzz."
 },
 {
  "i": 9,
  "start": 19.32,
  "end": 21.54,
  "text": "Then engineers switched frequencies, and he vanished."
 },
 {
  "i": 10,
  "start": 21.96,
  "end": 24.94,
  "text": "The sportscaster, live: Well, if you're wondering what's happened..."
 },
 {
  "i": 11,
  "start": 25.54,
  "end": 26.14,
  "text": "so am I."
 },
 {
  "i": 12,
  "start": 26.54,
  "end": 27.66,
  "text": "But here's the part..."
 },
 {
  "i": 13,
  "start": 27.98,
  "end": 29.26,
  "text": "two hours later, he came back."
 },
 {
  "i": 14,
  "start": 29.26,
  "end": 31.26,
  "text": "On another station, during Doctor Who."
 },
 {
  "i": 15,
  "start": 31.62,
  "end": 32.64,
  "text": "This time with sound."
 },
 {
  "i": 16,
  "start": 33.14,
  "end": 35.74,
  "text": "About 90 seconds of distorted, bizarre nonsense."
 },
 {
  "i": 17,
  "start": 36.24,
  "end": 37.28,
  "text": "And nobody could stop him."
 },
 {
  "i": 18,
  "start": 37.66,
  "end": 39.1,
  "text": "No engineers were on duty at the tower."
 },
 {
  "i": 19,
  "start": 39.7,
  "end": 40.88,
  "text": "The FCC investigated."
 },
 {
  "i": 20,
  "start": 41.46,
  "end": 42.08,
  "text": "To this day..."
 },
 {
  "i": 21,
  "start": 42.8,
  "end": 44.24,
  "text": "nobody knows who was under the mask."
 },
 {
  "i": 22,
  "start": 44.86,
  "end": 45.76,
  "text": "Subscribe for more."
 }
]