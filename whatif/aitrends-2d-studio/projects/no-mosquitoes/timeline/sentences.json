  "end": 1.78,
  "text": "Every mosquito on Earth just vanished."
 },
 {
  "i": 1,
  "start": 2.48,
  "end": 5.58,
  "text": "Good news: way fewer deadly diseases, like malaria."
 },
 {
  "i": 2,
  "start": 6.36,
  "end": 6.82,
  "text": "Bad news?"
 },
 {
  "i": 3,
  "start": 7.46,
  "end": 10.76,
  "text": "One scientist says Arctic birds that eat them could drop by half."
 },
 {
  "i": 4,
  "start": 11.3,
  "end": 13.42,
  "text": "Another says those birds eat more midges anyway."
 },
 {
  "i": 5,
  "start": 14.2,
  "end": 14.52,
  "text": "Chocolate?"
 },
 {
  "i": 6,
  "start": 14.84,
  "end": 15.1,
  "text": "Safe."
 },
 {
  "i": 7,
  "start": 15.62,
  "end": 16.98,
  "text": "Midges pollinate it, not mosquitoes."
 },
 {
  "i": 8,
  "start": 17.76,
  "end": 18.14,
  "text": "The verdict?"
 },
 {
  "i": 9,
  "start": 18.8,
  "end": 20.52,
  "text": "A CDC entomologist told Nature..."
 },
 {
  "i": 10,
  "start": 21.24,
