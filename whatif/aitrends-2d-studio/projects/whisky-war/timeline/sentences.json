[
 {
  "i": 0,
  "start": 0.187,
  "end": 2.427,
  "text": "Canada and Denmark fought a war with whisky."
 },
 {
  "i": 1,
  "start": 3.369,
  "end": 4.494,
  "text": "For almost 50 years."
 },
 {
  "i": 2,
  "start": 5.403,
  "end": 6.123,
  "text": "Over a rock."
 },
 {
  "i": 3,
  "start": 6.608,
  "end": 7.321,
  "text": "Hans Island."
 },
 {
  "i": 4,
  "start": 7.803,
  "end": 11.269,
  "text": "Just over one square kilometer, between Canada and Greenland."
 },
 {
  "i": 5,
  "start": 11.721,
  "end": 14.875,
  "text": "In 1973, the two countries drew a border..."
 },
 {
  "i": 6,
  "start": 15.346,
  "end": 16.423,
  "text": "and left the rock out."
 },
 {
  "i": 7,
  "start": 16.868,
  "end": 21.414,
  "text": "In 1984, Denmark's minister for Greenland left a bottle on it."
 },
 {
  "i": 8,
  "start": 21.865,
  "end": 23.317,
  "text": "\"Welcome to the Danish island.\""
 },
 {
  "i": 9,
  "start": 23.786,
  "end": 25.425,
  "text": "Then Canadian soldiers showed up."
 },
 {
  "i": 10,
  "start": 25.963,
  "end": 26.588,
  "text": "With a flag."
 },
 {
  "i": 11,
  "start": 27.068,
  "end": 28.133,
  "text": "And Canadian whisky."
 },
 {
  "i": 12,
  "start": 28.626,
  "end": 29.047,
  "text": "Wait."
 },
 {
  "i": 13,
  "start": 29.519,
  "end": 30.437,
  "text": "How is this a war?"
 },
 {
  "i": 14,
  "start": 31.347,
  "end": 32.73,
  "text": "You see, nobody fired a shot."
 },
 {
  "i": 15,
  "start": 33.286,
  "end": 34.297,
  "text": "They just took turns."
 },
 {
  "i": 16,
  "start": 34.777,
  "end": 36.074,
  "text": "Plant a flag, leave a bottle."
 },
 {
  "i": 17,
  "start": 36.61,
  "end": 37.345,
  "text": "For decades."
 },
 {
  "i": 18,
  "start": 37.794,
  "end": 40.27,
  "text": "In 2022, they finally made peace."
 },
 {
  "i": 19,
  "start": 40.702,
  "end": 42.157,
  "text": "They split the island in two..."
 },
 {
  "i": 20,
  "start": 43.082,
  "end": 44.079,
  "text": "and swapped bottles."
 },
 {
  "i": 21,
  "start": 44.527,
  "end": 45.567,
  "text": "Subscribe for more."
 }
]