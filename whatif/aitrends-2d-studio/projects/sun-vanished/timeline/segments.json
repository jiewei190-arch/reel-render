{
 "segments": [
  {
   "start": 0.15,
   "end": 1.632,
   "spoken": "Imagine the Sun just vanished.",
   "caption": "Imagine the Sun just vanished."
  },
  {
   "start": 1.932,
   "end": 3.369,
   "spoken": "You wouldn't know for eight minutes.",
   "caption": "You wouldn't know for 8 minutes."
  },
  {
   "start": 4.119,
   "end": 6.671,
   "spoken": "Even gravity takes eight minutes to get the news.",
   "caption": "Even gravity takes 8 minutes to get the news."
  },
  {
   "start": 6.971,
   "end": 8.995,
   "spoken": "Sunlight needs eight minutes to reach us.",
   "caption": "Sunlight needs 8 minutes to reach us."
  },
  {
   "start": 9.295,
   "end": 11.22,
   "spoken": "So the sky still looks totally normal.",
   "caption": "So the sky still looks totally normal."
  },
  {
   "start": 11.52,
   "end": 13.343,
   "spoken": "And Earth keeps circling... nothing.",
   "caption": "And Earth keeps circling... nothing."
  },
  {
   "start": 13.643,
   "end": 14.364,
   "spoken": "Wait, how?",
   "caption": "Wait, how?"
  },
  {
   "start": 14.664,
   "end": 16.723,
   "spoken": "You see, gravity is not instant either.",
   "caption": "You see, gravity is not instant either."
  },
  {
   "start": 17.023,
   "end": 18.563,
   "spoken": "It travels at the speed of light.",
   "caption": "It travels at the speed of light."
  },
  {
   "start": 18.863,
   "end": 19.902,
   "spoken": "Then, at minute eight...",
   "caption": "Then, at minute 8..."
  },
  {
   "start": 20.652,
   "end": 21.412,
   "spoken": "lights out.",
   "caption": "lights out."
  },
  {
   "start": 21.712,
   "end": 23.001,
   "spoken": "The Moon goes dark too.",
   "caption": "The Moon goes dark too."
  },
  {
   "start": 23.301,
   "end": 24.632,
   "spoken": "Only the stars are left.",
   "caption": "Only the stars are left."
  },
  {
   "start": 24.932,
   "end": 27.338,
   "spoken": "Earth flies off in a straight line, into space.",
   "caption": "Earth flies off in a straight line, into space."
  },
  {
   "start": 27.638,
   "end": 29.766,
   "spoken": "In a few weeks, the whole planet freezes.",
   "caption": "In a few weeks, the whole planet freezes."
  },
  {
   "start": 30.066,
   "end": 32.041,
   "spoken": "So that last bit of sunshine you saw...",
   "caption": "So that last bit of sunshine you saw..."
  },
  {
   "start": 32.791,
   "end": 34.253,
   "spoken": "was already eight minutes old.",
   "caption": "was already 8 minutes old."
  },
  {
   "start": 34.553,
   "end": 35.678,
   "spoken": "Subscribe for more.",
   "caption": "Subscribe for more."
  }
 ],
