{
 "segments": [
  {
   "start": 0.15,
   "end": 3.269,
   "spoken": "In eighteen seventy-six, it rained meat in Kentucky.",
   "caption": "In 1876, it rained meat in Kentucky."
  },
  {
   "start": 4.019,
   "end": 5.284,
   "spoken": "Out of a clear blue sky.",
   "caption": "Out of a clear blue sky."
  },
  {
   "start": 5.584,
   "end": 10.641,
   "spoken": "A woman was outside, making soap, when chunks of meat started falling all around her.",
   "caption": "A woman was outside, making soap, when chunks of meat started falling all around her."
  },
  {
   "start": 10.941,
   "end": 12.858,
   "spoken": "Some pieces were four inches wide.",
   "caption": "Some pieces were 4 inches wide."
  },
  {
   "start": 13.158,
   "end": 14.841,
   "spoken": "So two men did the obvious thing.",
   "caption": "So two men did the obvious thing."
  },
  {
   "start": 15.591,
   "end": 16.471,
   "spoken": "They tasted it.",
   "caption": "They tasted it."
  },
  {
   "start": 16.771,
   "end": 17.722,
   "spoken": "Verdict: mutton.",
   "caption": "Verdict: mutton."
  },
  {
   "start": 18.022,
   "end": 19.056,
   "spoken": "Or maybe venison.",
   "caption": "Or maybe venison."
  },
  {
   "start": 19.356,
   "end": 20.727,
   "spoken": "It made The New York Times.",
   "caption": "It made The New York Times."
  },
  {
   "start": 21.027,
   "end": 23.486,
   "spoken": "Scientists found lung, muscle and cartilage.",
   "caption": "Scientists found lung, muscle and cartilage."
  },
  {
   "start": 23.786,
   "end": 25.947,
   "spoken": "Wait, how does meat fall out of a clear sky?",
   "caption": "Wait, how does meat fall out of a clear sky?"
  },
  {
   "start": 26.247,
   "end": 28.0,
   "spoken": "You see, the best guess is vultures.",
   "caption": "You see, the best guess is vultures."
  },
  {
   "start": 28.3,
   "end": 30.935,
   "spoken": "Scared vultures throw up, to fly away lighter.",
   "caption": "Scared vultures throw up, to fly away lighter."
  },
  {
   "start": 31.235,
   "end": 33.779,
   "spoken": "And when one does it... the whole flock joins in.",
   "caption": "And when one does it... the whole flock joins in."
  },
  {
   "start": 34.529,
   "end": 36.852,
   "spoken": "So that clear blue sky... wasn't empty.",
   "caption": "So that clear blue sky... wasn't empty."
  },
  {
   "start": 37.152,
   "end": 38.277,
   "spoken": "Subscribe for more.",
   "caption": "Subscribe for more."
  }
 ],
