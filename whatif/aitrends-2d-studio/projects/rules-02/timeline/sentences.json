[
 {
  "i": 0,
  "start": 0.05,
  "end": 2.39,
  "text": "Your first night shift at the gas station."
 },
 {
  "i": 1,
  "start": 3.45,
  "end": 5.51,
  "text": "Your manager left a note on the register."
 },
 {
  "i": 2,
  "start": 5.51,
  "end": 7.15,
  "text": "Three rules."
 },
 {
  "i": 3,
  "start": 8.69,
  "end": 10.29,
  "text": "Rule one."
 },
 {
  "i": 4,
  "start": 10.29,
  "end": 12.01,
  "text": "At two a.m., lock the door."
 },
 {
  "i": 5,
  "start": 13.27,
  "end": 14.63,
  "text": "Serve customers through the window."
 },
 {
  "i": 6,
  "start": 16.25,
  "end": 18.01,
  "text": "Rule two."
 },
 {
  "i": 7,
  "start": 18.01,
  "end": 20.65,
  "text": "If someone asks for the usual, tell them we're out."
 },
 {
  "i": 8,
  "start": 22.35,
  "end": 24.13,
  "text": "Rule three."
 },
 {
  "i": 9,
  "start": 24.13,
  "end": 25.82,
  "text": "Never look at camera four."
 },
 {
  "i": 10,
  "start": 25.82,
  "end": 27.64,
  "text": "Two a.m."
 },
 {
  "i": 11,
  "start": 27.64,
  "end": 29.75,
  "text": "You lock the door."
 },
 {
  "i": 12,
  "start": 29.75,
  "end": 32.47,
  "text": "Two forty."
 },
 {
  "i": 13,
  "start": 32.47,
  "end": 33.63,
  "text": "A man taps on the glass."
 },
 {
  "i": 14,
  "start": 34.63,
  "end": 35.33,
  "text": "He doesn't blink."
 },
 {
  "i": 15,
  "start": 36.59,
  "end": 37.13,
  "text": "The usual."
 },
 {
  "i": 16,
  "start": 38.59,
  "end": 39.63,
  "text": "We're out, you tell him."
 },
 {
  "i": 17,
  "start": 40.51,
  "end": 43.23,
  "text": "He smiles too wide, and walks back into the dark."
 },
 {
  "i": 18,
  "start": 43.23,
  "end": 45.95,
  "text": "Three a.m."
 },
 {
  "i": 19,
  "start": 45.95,
  "end": 46.67,
  "text": "The phone rings."
 },
 {
  "i": 20,
  "start": 47.63,
  "end": 48.35,
  "text": "It's your manager."
 },
 {
  "i": 21,
  "start": 49.59,
  "end": 49.77,
  "text": "Hey!"
 },
 {
  "i": 22,
  "start": 49.91,
  "end": 51.51,
  "text": "Sorry, I forgot to leave you a note."
 },
 {
  "i": 23,
  "start": 52.01,
  "end": 52.43,
  "text": "Easy night."
 },
 {
  "i": 24,
  "start": 52.97,
  "end": 54.53,
  "text": "Nothing weird ever happens there."
 },
 {
  "i": 25,
  "start": 56.07,
  "end": 57.59,
  "text": "You look down at the note."
 },
 {
  "i": 26,
  "start": 58.53,
  "end": 61.95,
  "text": "Then, without meaning to, you look at camera four."
 },
 {
  "i": 27,
  "start": 61.95,
  "end": 63.01,
  "text": "It shows the counter."
 },
 {
  "i": 28,
  "start": 64.03,
  "end": 65.01,
  "text": "From behind you."
 },
 {
  "i": 29,
  "start": 65.91,
  "end": 67.85,
  "text": "And something standing right behind you."
 }
]