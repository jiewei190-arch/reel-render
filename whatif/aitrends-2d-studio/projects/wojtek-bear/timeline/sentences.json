[
 {
  "i": 0,
  "start": 0.0,
  "end": 3.32,
  "text": "A bear served in the Polish army in World War II."
 },
 {
  "i": 1,
  "start": 3.32,
  "end": 3.96,
  "text": "He had a rank."
 },
 {
  "i": 2,
  "start": 3.96,
  "end": 5.42,
  "text": "And a serial number."
 },
 {
  "i": 3,
  "start": 5.88,
  "end": 9.92,
  "text": "In 1942, Polish soldiers in Iran adopted a bear cub."
 },
 {
  "i": 4,
  "start": 10.48,
  "end": 11.94,
  "text": "They named him Wojtek."
 },
 {
  "i": 5,
  "start": 11.94,
  "end": 12.92,
  "text": "His favourite drink?"
 },
 {
  "i": 6,
  "start": 13.46,
  "end": 13.66,
  "text": "Beer."
 },
 {
  "i": 7,
  "start": 14.22,
  "end": 14.7,
  "text": "His hobby?"
 },
 {
  "i": 8,
  "start": 15.34,
  "end": 16.3,
  "text": "Wrestling the soldiers."
 },
 {
  "i": 9,
  "start": 16.88,
  "end": 19.46,
  "text": "Then the British ship to Italy said: no pets allowed."
 },
 {
  "i": 10,
  "start": 20.02,
  "end": 21.9,
  "text": "Wait, how do you get a bear on a troop ship?"
 },
 {
  "i": 11,
  "start": 22.44,
  "end": 23.44,
  "text": "You see, he wasn't a pet."
 },
 {
  "i": 12,
  "start": 24.23,
  "end": 25.2,
  "text": "He was a private."
 },
 {
  "i": 13,
  "start": 25.8,
  "end": 31.78,
  "text": "In 1944, at Monte Cassino, he is reported to have carried crates of artillery shells."
 },
 {
  "i": 14,
  "start": 32.4,
  "end": 35.0,
  "text": "So his company made its badge a bear carrying a shell."
 },
 {
  "i": 15,
  "start": 35.5,
  "end": 38.7,
  "text": "He was promoted to corporal, and retired to Edinburgh Zoo."
 },
 {
  "i": 16,
  "start": 39.26,
  "end": 40.2,
  "text": "Subscribe for more."
 }
]