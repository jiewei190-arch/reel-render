[
 {
  "line": 1,
  "text": "According to one general, rabbits attacked Napoleon.",
  "start": 0.187,
  "end": 3.112
 },
 {
  "line": 2,
  "text": "Hundreds of them.",
  "start": 3.564,
  "end": 4.496
 },
 {
  "line": 3,
  "text": "And they won.",
  "start": 5.478,
  "end": 6.151
 },
 {
  "line": 4,
  "text": "It's eighteen-oh-seven.",
  "start": 6.568,
  "end": 7.654
 },
 {
  "line": 4,
  "text": "Napoleon just signed a peace treaty.",
  "start": 8.079,
  "end": 9.862
 },
 {
  "line": 5,
  "text": "To celebrate, his chief of staff sets up a rabbit hunt.",
  "start": 10.302,
  "end": 13.207
 },
 {
  "line": 6,
  "text": "Hundreds of rabbits.",
  "start": 13.635,
  "end": 14.686
 },
 {
  "line": 6,
  "text": "Some say three thousand.",
  "start": 15.098,
  "end": 16.393
 },
 {
  "line": 7,
  "text": "The cages open...",
  "start": 16.834,
  "end": 17.863
 },
 {
  "line": 8,
  "text": "and the rabbits charge.",
  "start": 18.857,
  "end": 20.035
 },
 {
  "line": 8,
  "text": "Straight at Napoleon.",
  "start": 20.464,
  "end": 21.458
 },
 {
  "line": 9,
  "text": "Wait, why would rabbits charge?",
  "start": 21.889,
  "end": 23.399
 },
 {
  "line": 10,
  "text": "You see, they were tame farm rabbits.",
  "start": 23.808,
  "end": 25.447
 },
 {
  "line": 10,
  "text": "They thought he was bringing dinner.",
  "start": 25.846,
  "end": 27.216
 },
 {
  "line": 11,
  "text": "He swats them with his riding crop.",
  "start": 27.65,
  "end": 29.51
 },
 {
  "line": 11,
  "text": "The coachmen crack their whips.",
  "start": 29.932,
  "end": 31.374
 },
 {
  "line": 12,
  "text": "More rabbits.",
  "start": 31.773,
  "end": 32.498
 },
 {
  "line": 13,
  "text": "Napoleon runs for his carriage.",
  "start": 32.907,
  "end": 34.542
 },
 {
  "line": 13,
  "text": "Reportedly, some jump in after him.",
  "start": 34.954,
  "end": 36.819
 },
 {
  "line": 14,
  "text": "The man who conquered Europe...",
  "start": 37.809,
  "end": 39.185
 },
 {
  "line": 14,
  "text": "defeated by bunnies.",
  "start": 39.598,
  "end": 40.71
 },
 {
  "line": 15,
  "text": "Subscribe for more.",
  "start": 41.108,
  "end": 42.173
 }
]