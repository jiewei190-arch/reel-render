[
 {
  "i": 0,
  "start": 0.0,
  "end": 2.24,
  "text": "Ohio and Michigan once nearly went to war..."
 },
 {
  "i": 1,
  "start": 2.64,
  "end": 3.1,
  "text": "over Toledo."
 },
 {
  "i": 2,
  "start": 3.64,
  "end": 4.22,
  "text": "Blame a bad map."
 },
 {
  "i": 3,
  "start": 4.52,
  "end": 7.2,
  "text": "Both claimed one strip of land, 5 to 8 miles wide."
 },
 {
  "i": 4,
  "start": 7.52,
  "end": 10.06,
  "text": "In 1835, both sent militias to the Maumee River..."
 },
 {
  "i": 5,
  "start": 10.06,
  "end": 11.52,
  "text": "and traded taunts."
 },
 {
  "i": 6,
  "start": 11.94,
  "end": 12.52,
  "text": "The one battle?"
 },
 {
  "i": 7,
  "start": 12.52,
  "end": 14.6,
  "text": "Reportedly, shots fired into the air."
 },
 {
  "i": 8,
  "start": 14.98,
  "end": 15.6,
  "text": "Nobody was hit."
 },
 {
  "i": 9,
  "start": 16.2,
  "end": 17.26,
  "text": "But here's the part..."
 },
 {
  "i": 10,
  "start": 17.68,
  "end": 20.24,
  "text": "the war's only injury: a deputy, hurt with a penknife."
 },
 {
  "i": 11,
  "start": 20.54,
  "end": 22.14,
  "text": "By a man named Two Stickney."
 },
 {
  "i": 12,
  "start": 22.46,
  "end": 22.82,
  "text": "His brother?"
 },
 {
  "i": 13,
  "start": 22.82,
  "end": 24.22,
  "text": "Reportedly named One."
 },
 {
  "i": 14,
  "start": 24.52,
  "end": 25.54,
  "text": "Congress stepped in."
 },
 {
  "i": 15,
  "start": 25.86,
  "end": 26.62,
  "text": "Ohio got Toledo."
 },
 {
  "i": 16,
  "start": 27.22,
  "end": 28.22,
  "text": "Michigan got statehood..."
 },
 {
  "i": 17,
  "start": 28.62,
  "end": 29.52,
  "text": "and the Upper Peninsula."
 },
 {
  "i": 18,
  "start": 29.52,
  "end": 33.08,
  "text": "A consolation prize almost everyone called a worthless wilderness."
 },
 {
  "i": 19,
  "start": 33.66,
  "end": 36.0,
  "text": "But in the 1840s, they found copper and iron."
 },
 {
  "i": 20,
  "start": 36.4,
  "end": 39.64,
  "text": "By the 1860s, it supplied 90% of America's copper."
 },
 {
  "i": 21,
  "start": 40.28,
  "end": 41.12,
  "text": "Michigan lost Toledo..."
 },
 {
  "i": 22,
  "start": 41.8,
  "end": 43.66,
  "text": "and won the jackpot."
 },
 {
  "i": 23,
  "start": 44.24,
  "end": 45.18,
  "text": "Subscribe for more."
 }
]