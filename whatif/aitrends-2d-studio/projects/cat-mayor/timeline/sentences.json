[
 {
  "i": 0,
  "start": 0.0,
  "end": 1.46,
  "text": "This town's mayor was a cat."
 },
 {
  "i": 1,
  "start": 1.9,
  "end": 2.98,
  "text": "For almost 20 years."
 },
 {
  "i": 2,
  "start": 3.58,
  "end": 5.72,
  "text": "And according to legend, he beat the humans."
 },
 {
  "i": 3,
  "start": 5.72,
  "end": 7.14,
  "text": "Talkeetna, Alaska."
 },
 {
  "i": 4,
  "start": 8.32,
  "end": 10.14,
  "text": "Population: about 900."
 },
 {
  "i": 5,
  "start": 10.14,
  "end": 11.08,
  "text": "No human mayor."
 },
 {
  "i": 6,
  "start": 11.6,
  "end": 12.08,
  "text": "Wait, how?"
 },
 {
  "i": 7,
  "start": 12.66,
  "end": 15.38,
  "text": "You see, it's a historic district, not a real city."
 },
 {
  "i": 8,
  "start": 15.84,
  "end": 20.9,
  "text": "So in 1998, the story goes, voters wrote in a kitten named Stubbs."
 },
 {
  "i": 9,
  "start": 21.68,
  "end": 22.12,
  "text": "He won."
 },
 {
  "i": 10,
  "start": 22.68,
  "end": 23.22,
  "text": "His office?"
 },
 {
  "i": 11,
  "start": 23.74,
  "end": 24.58,
  "text": "The general store."
 },
 {
  "i": 12,
  "start": 25.18,
  "end": 25.64,
  "text": "His drink?"
 },
 {
  "i": 13,
  "start": 26.34,
  "end": 28.12,
  "text": "Catnip water, from a margarita glass."
 },
 {
  "i": 14,
  "start": 28.12,
  "end": 30.98,
  "text": "In 2014, he even ran for the Senate."
 },
 {
  "i": 15,
  "start": 32.06,
  "end": 32.44,
  "text": "He lost."
 },
 {
  "i": 16,
  "start": 33.08,
  "end": 36.7,
  "text": "But he stayed honorary mayor until 2017."
 },
 {
  "i": 17,
  "start": 36.7,
  "end": 40.3,
  "text": "As one local put it: he never voted for anything I wouldn't have."
 },
 {
  "i": 18,
  "start": 40.84,
  "end": 41.72,
  "text": "Subscribe for more."
 }
]