[
 {
  "i": 0,
  "start": 0.0,
  "speechStart": 0.0,
  "speechEnd": 1.4,
  "text": "Blackout.",
  "end": 1.25
 },
 {
  "i": 1,
  "start": 1.25,
  "speechStart": 1.4,
  "speechEnd": 7.28,
  "text": "Every light on your street dies at once. You keep walking. Round the coffee table. Over the shoe.",
  "end": 7.61
 },
 {
  "i": 2,
  "start": 7.61,
  "speechStart": 7.76,
  "speechEnd": 10.0,
  "text": "Past the door that always eats your knee.",
  "end": 10.37
 },
 {
  "i": 3,
  "start": 10.37,
  "speechStart": 10.52,
  "speechEnd": 13.72,
  "text": "You find the cat on top of the fridge. Biscuit blinks.",
  "end": 14.17
 },
 {
  "i": 4,
  "start": 14.17,
  "speechStart": 14.32,
  "speechEnd": 15.68,
  "text": "She looks offended.",
  "end": 16.21
 },
 {
  "i": 5,
  "start": 16.21,
  "speechStart": 16.36,
  "speechEnd": 19.12,
  "text": "Your little sister Mina stumbles in, torch first.",
  "end": 19.55
 },
 {
  "i": 6,
  "start": 19.55,
  "speechStart": 19.7,
  "speechEnd": 21.96,
  "text": "How are you doing this? You shrug.",
  "end": 22.33
 },
 {
  "i": 7,
  "start": 22.33,
  "speechStart": 22.48,
  "speechEnd": 24.08,
  "text": "You can see the mouse by the bin.",
  "end": 24.47
 },
 {
  "i": 8,
  "start": 24.47,
  "speechStart": 24.62,
  "speechEnd": 26.26,
  "text": "You can see the toast cooling.",
  "end": 26.61
 },
 {
  "i": 9,
  "start": 26.61,
  "speechStart": 26.76,
  "speechEnd": 28.7,
  "text": "You still cannot find your phone charger.",
  "end": 29.17
 },
 {
  "i": 10,
  "start": 29.17,
  "speechStart": 29.32,
  "speechEnd": 31.04,
  "text": "What if you could see in complete darkness?",
  "end": 30.89
 },
 {
  "i": 11,
  "start": 30.89,
  "speechStart": 31.04,
  "speechEnd": 33.34,
  "text": "Rule one...",
  "end": 33.19
 },
 {
  "i": 12,
  "start": 33.19,
  "speechStart": 33.34,
  "speechEnd": 34.68,
  "text": "your eyes quit first.",
  "end": 35.05
 },
 {
  "i": 13,
  "start": 35.05,
  "speechStart": 35.2,
  "speechEnd": 39.96,
  "text": "A human eye holds about one hundred and twenty million rods. Rods handle the dark.",
  "end": 40.35
 },
 {
  "i": 14,
  "start": 40.35,
  "speechStart": 40.5,
  "speechEnd": 42.94,
  "text": "It also holds about six million cones.",
  "end": 43.53
 },
 {
  "i": 15,
  "start": 43.53,
  "speechStart": 43.68,
  "speechEnd": 45.02,
  "text": "Cones handle colour.",
  "end": 44.87
 },
 {
  "i": 16,
  "start": 44.87,
  "speechStart": 45.02,
  "speechEnd": 46.38,
  "text": "And at night, they clock out.",
  "end": 46.75
 },
 {
  "i": 17,
  "start": 46.75,
  "speechStart": 46.9,
  "speechEnd": 49.98,
  "text": "Walk from sunshine into a cinema. You are blind.",
  "end": 50.39
 },
 {
  "i": 18,
  "start": 50.39,
  "speechStart": 50.54,
  "speechEnd": 53.18,
  "text": "Your rods need twenty to thirty minutes to catch up.",
  "end": 53.53
 },
 {
  "i": 19,
  "start": 53.53,
  "speechStart": 53.68,
  "speechEnd": 57.22,
  "text": "Dev shuffles in beside you, orange beanie first, popcorn flying.",
  "end": 57.67
 },
 {
  "i": 20,
  "start": 57.67,
  "speechStart": 57.82,
  "speechEnd": 61.68,
  "text": "Where is row F? he groans. You walk straight to it.",
  "end": 61.93
 },
 {
  "i": 21,
  "start": 61.93,
  "speechStart": 62.08,
  "speechEnd": 64.88,
  "text": "A cat needs roughly a sixth of the light you do.",
  "end": 64.73
 },
 {
  "i": 22,
  "start": 64.73,
  "speechStart": 64.88,
  "speechEnd": 66.42,
  "text": "You? None.",
  "end": 66.79
 },
 {
  "i": 23,
  "start": 66.79,
  "speechStart": 66.94,
  "speechEnd": 69.04,
  "text": "But even a cat is blind in true darkness.",
  "end": 69.57
 },
 {
  "i": 24,
  "start": 69.57,
  "speechStart": 69.72,
  "speechEnd": 71.36,
  "text": "Humans are not hopeless, though.",
  "end": 71.65
 },
 {
  "i": 25,
  "start": 71.65,
  "speechStart": 71.8,
  "speechEnd": 73.38,
  "text": "In a 2016 experiment,",
  "end": 74.13
 },
 {
  "i": 26,
  "start": 74.13,
  "speechStart": 74.28,
  "speechEnd": 78.56,
  "text": "volunteers spotted single photons better than chance. One photon. One.",
  "end": 79.05
 },
 {
  "i": 27,
  "start": 79.05,
  "speechStart": 79.2,
  "speechEnd": 80.64,
  "text": "Upside, no more stubbed toes.",
  "end": 81.17
 },
 {
  "i": 28,
  "start": 81.17,
  "speechStart": 81.32,
  "speechEnd": 85.7,
  "text": "Downside, Dev wants to know why you keep staring at him. Fair question.",
  "end": 86.51
 },
 {
  "i": 29,
  "start": 86.51,
  "speechStart": 86.66,
  "speechEnd": 91.32,
  "text": "So how do you see where nothing shines? Simple... nothing has to shine.",
  "end": 91.77
 },
 {
  "i": 30,
  "start": 91.77,
  "speechStart": 91.92,
  "speechEnd": 93.46,
  "text": "Everything is already glowing.",
  "end": 94.61
 },
 {
  "i": 31,
  "start": 94.61,
  "speechStart": 94.76,
  "speechEnd": 96.06,
  "text": "Rule two...",
  "end": 95.91
 },
 {
  "i": 32,
  "start": 95.91,
  "speechStart": 96.06,
  "speechEnd": 97.26,
  "text": "dark isn't empty.",
  "end": 97.57
 },
 {
  "i": 33,
  "start": 97.57,
  "speechStart": 97.72,
  "speechEnd": 104.06,
  "text": "Anything above absolute zero glows with infrared. Your couch. Your cat. You.",
  "end": 104.61
 },
 {
  "i": 34,
  "start": 104.61,
  "speechStart": 104.76,
  "speechEnd": 104.96,
  "text": "Dr.",
  "end": 105.59
 },
 {
  "i": 35,
  "start": 105.59,
  "speechStart": 105.74,
  "speechEnd": 109.86,
  "text": "Lin, in her green lanyard, kills every light in the lab. She holds up one hand.",
  "end": 110.21
 },
 {
  "i": 36,
  "start": 110.21,
  "speechStart": 110.36,
  "speechEnd": 113.36,
  "text": "You count five warm fingers. She is not scared.",
  "end": 113.83
 },
 {
  "i": 37,
  "start": 113.83,
  "speechStart": 113.98,
  "speechEnd": 115.2,
  "text": "She is thrilled.",
  "end": 115.65
 },
 {
  "i": 38,
  "start": 115.65,
  "speechStart": 115.8,
  "speechEnd": 120.32,
  "text": "This is thermal vision, she whispers. Not magic. Physics.",
  "end": 120.97
 },
 {
  "i": 39,
  "start": 120.97,
  "speechStart": 121.12,
  "speechEnd": 125.32,
  "text": "Human skin glows most strongly near nine and a half micrometres.",
  "end": 125.17
 },
 {
  "i": 40,
  "start": 125.17,
  "speechStart": 125.32,
  "speechEnd": 126.68,
  "text": "That is long-wave infrared.",
  "end": 127.04
 },
 {
  "i": 41,
  "start": 127.04,
  "speechStart": 127.19,
  "speechEnd": 129.62,
  "text": "Thermal cameras read exactly that band.",
  "end": 130.03
 },
 {
  "i": 42,
  "start": 130.03,
  "speechStart": 130.18,
  "speechEnd": 133.76,
  "text": "Your own eyes can't. One reason? They are warm too.",
  "end": 134.09
 },
 {
  "i": 43,
  "start": 134.09,
  "speechStart": 134.24,
  "speechEnd": 138.56,
  "text": "It's like reading a dim screen with a torch in your face. Nature found a workaround.",
  "end": 139.03
 },
 {
  "i": 44,
  "start": 139.03,
  "speechStart": 139.18,
  "speechEnd": 141.74,
  "text": "Pit vipers have a hollow pit on their face.",
  "end": 142.17
 },
 {
  "i": 45,
  "start": 142.17,
  "speechStart": 142.32,
  "speechEnd": 144.34,
  "text": "It works like a pinhole camera for heat.",
  "end": 144.77
 },
 {
  "i": 46,
  "start": 144.77,
  "speechStart": 144.92,
  "speechEnd": 148.32,
  "text": "Its nerves use a heat-sensitive protein called TRPA1.",
  "end": 148.83
 },
 {
  "i": 47,
  "start": 148.83,
  "speechStart": 148.98,
  "speechEnd": 151.08,
  "text": "Scientists pinned that down in 2010.",
  "end": 151.31
 },
 {
  "i": 48,
  "start": 151.31,
  "speechStart": 151.46,
  "speechEnd": 153.98,
  "text": "A snake finds a mouse in total darkness.",
  "end": 153.83
 },
 {
  "i": 49,
  "start": 153.83,
  "speechStart": 153.98,
  "speechEnd": 157.26,
  "text": "You? The mouse... and the remote.",
  "end": 157.67
 },
 {
  "i": 50,
  "start": 157.67,
  "speechStart": 157.82,
  "speechEnd": 160.9,
  "text": "Out on the dark street, you spot a kitten under a parked car.",
  "end": 160.75
 },
 {
  "i": 51,
  "start": 160.75,
  "speechStart": 160.9,
  "speechEnd": 164.08,
  "text": "A small orange glow. You rescue it.",
  "end": 164.37
 },
 {
  "i": 52,
  "start": 164.37,
  "speechStart": 164.52,
  "speechEnd": 167.44,
  "text": "Then you walk face first into a shop window.",
  "end": 167.99
 },
 {
  "i": 53,
  "start": 167.99,
  "speechStart": 168.14,
  "speechEnd": 170.2,
  "text": "Ordinary glass blocks thermal infrared.",
  "end": 170.69
 },
 {
  "i": 54,
  "start": 170.69,
  "speechStart": 170.84,
  "speechEnd": 174.76,
  "text": "To you, it is a flat, cold wall. Dev wheezes with laughter.",
  "end": 174.61
 },
 {
  "i": 55,
  "start": 174.61,
  "speechStart": 174.76,
  "speechEnd": 177.16,
  "text": "Mate... that was a window.",
  "end": 177.01
 },
 {
  "i": 56,
  "start": 177.01,
  "speechStart": 177.16,
  "speechEnd": 179.46,
  "text": "Ten out of ten.",
  "end": 179.31
 },
 {
  "i": 57,
  "start": 179.31,
  "speechStart": 179.46,
  "speechEnd": 181.28,
  "text": "Rule three...",
  "end": 181.13
 },
 {
  "i": 58,
  "start": 181.13,
  "speechStart": 181.28,
  "speechEnd": 183.22,
  "text": "heat has no colour.",
  "end": 183.07
 },
 {
  "i": 59,
  "start": 183.07,
  "speechStart": 183.22,
  "speechEnd": 185.34,
  "text": "Mina slides a birthday card across the table.",
  "end": 185.65
 },
 {
  "i": 60,
  "start": 185.65,
  "speechStart": 185.8,
  "speechEnd": 188.6,
  "text": "In the dark, it is a blank, warm rectangle.",
  "end": 189.19
 },
 {
  "i": 61,
  "start": 189.19,
  "speechStart": 189.34,
  "speechEnd": 193.78,
  "text": "Ink and paper sit at the same temperature. No contrast. No words.",
  "end": 194.25
 },
 {
  "i": 62,
  "start": 194.25,
  "speechStart": 194.4,
  "speechEnd": 195.88,
  "text": "You guess happy birthday.",
  "end": 196.51
 },
 {
  "i": 63,
  "start": 196.51,
  "speechStart": 196.66,
  "speechEnd": 198.06,
  "text": "It says get well soon.",
  "end": 198.53
 },
 {
  "i": 64,
  "start": 198.53,
  "speechStart": 198.68,
  "speechEnd": 202.5,
  "text": "She tucks a hand warmer into your hoodie pocket. Keep it, she says.",
  "end": 202.93
 },
 {
  "i": 65,
  "start": 202.93,
  "speechStart": 203.08,
  "speechEnd": 204.32,
  "text": "I have the twin.",
  "end": 204.67
 },
 {
  "i": 66,
  "start": 204.67,
  "speechStart": 204.82,
  "speechEnd": 206.82,
  "text": "In your sight, it burns like a coal.",
  "end": 206.67
 },
 {
  "i": 67,
  "start": 206.67,
  "speechStart": 206.82,
  "speechEnd": 209.02,
  "text": "Night-vision goggles work differently.",
  "end": 209.47
 },
 {
  "i": 68,
  "start": 209.47,
  "speechStart": 209.62,
  "speechEnd": 216.8,
  "text": "They amplify the faint light already there. Starlight. Moonlight. In true darkness? Nothing to amplify.",
  "end": 217.31
 },
 {
  "i": 69,
  "start": 217.31,
  "speechStart": 217.46,
  "speechEnd": 219.52,
  "text": "So thermal wins the pitch black...",
  "end": 219.91
 },
 {
  "i": 70,
  "start": 219.91,
  "speechStart": 220.06,
  "speechEnd": 221.28,
  "text": "but only for warm things.",
  "end": 221.13
 },
 {
  "i": 71,
  "start": 221.13,
  "speechStart": 221.28,
  "speechEnd": 223.36,
  "text": "Colour is a bigger ask.",
  "end": 223.79
 },
 {
  "i": 72,
  "start": 223.79,
  "speechStart": 223.94,
  "speechEnd": 228.14,
  "text": "Helmet geckos told blue from grey at moonlight levels in 2004. You?",
  "end": 228.47
 },
 {
  "i": 73,
  "start": 228.47,
  "speechStart": 228.62,
  "speechEnd": 230.08,
  "text": "Hot, warm, cold.",
  "end": 230.47
 },
 {
  "i": 74,
  "start": 230.47,
  "speechStart": 230.62,
  "speechEnd": 232.18,
  "text": "That is your entire palette.",
  "end": 232.03
 },
 {
  "i": 75,
  "start": 232.03,
  "speechStart": 232.18,
  "speechEnd": 235.52,
  "text": "Upside, you win hide and seek forever.",
  "end": 235.83
 },
 {
  "i": 76,
  "start": 235.83,
  "speechStart": 235.98,
  "speechEnd": 241.02,
  "text": "Downside, you can't read a menu. Rule four... light is the enemy.",
  "end": 241.45
 },
 {
  "i": 77,
  "start": 241.45,
  "speechStart": 241.6,
  "speechEnd": 243.12,
  "text": "You step off the kerb at midnight.",
  "end": 243.57
 },
 {
  "i": 78,
  "start": 243.57,
  "speechStart": 243.72,
  "speechEnd": 246.56,
  "text": "A cyclist, no lamp, glows like a ghost.",
  "end": 246.95
 },
 {
  "i": 79,
  "start": 246.95,
  "speechStart": 247.1,
  "speechEnd": 252.38,
  "text": "You yank Dev back. Saved him. Dev stares at you. How did you see that?",
  "end": 252.59
 },
 {
  "i": 80,
  "start": 252.59,
  "speechStart": 252.74,
  "speechEnd": 255.02,
  "text": "Then the cyclist's lamp snaps on.",
  "end": 255.37
 },
 {
  "i": 81,
  "start": 255.37,
  "speechStart": 255.52,
  "speechEnd": 256.8,
  "text": "It is one bright flash.",
  "end": 257.25
 },
 {
  "i": 82,
  "start": 257.25,
  "speechStart": 257.4,
  "speechEnd": 258.92,
  "text": "Your thermal view whites out.",
  "end": 258.77
 },
 {
  "i": 83,
  "start": 258.77,
  "speechStart": 258.92,
  "speechEnd": 262.22,
  "text": "Your old eyes are not ready either. Total blindness.",
  "end": 262.85
 },
 {
  "i": 84,
  "start": 262.85,
  "speechStart": 263.0,
  "speechEnd": 264.26,
  "text": "Bright light floods your rods.",
  "end": 264.71
 },
 {
  "i": 85,
  "start": 264.71,
  "speechStart": 264.86,
  "speechEnd": 266.64,
  "text": "They need twenty to thirty minutes to recover.",
  "end": 267.05
 },
 {
  "i": 86,
  "start": 267.05,
  "speechStart": 267.2,
  "speechEnd": 268.8,
  "text": "Your new sight takes about a minute.",
  "end": 269.27
 },
 {
  "i": 87,
  "start": 269.27,
  "speechStart": 269.42,
  "speechEnd": 270.74,
  "text": "A long, shaky minute.",
  "end": 271.39
 },
 {
  "i": 88,
  "start": 271.39,
  "speechStart": 271.54,
  "speechEnd": 277.48,
  "text": "Dev guides you home by the sleeve. Amazing. And awful. Usually both at once.",
  "end": 277.97
 },
 {
  "i": 89,
  "start": 277.97,
  "speechStart": 278.12,
  "speechEnd": 283.96,
  "text": "So the rule is simple. Dark is your friend. Light is a punch. Remember that...",
  "end": 284.21
 },
 {
  "i": 90,
  "start": 284.21,
  "speechStart": 284.36,
  "speechEnd": 286.54,
  "text": "because you are about to need it.",
  "end": 287.07
 },
 {
  "i": 91,
  "start": 287.07,
  "speechStart": 287.22,
  "speechEnd": 293.7,
  "text": "Rule five... cold hides. A school camping trip. Rain on the trees. Mina is gone.",
  "end": 294.07
 },
 {
  "i": 92,
  "start": 294.07,
  "speechStart": 294.22,
  "speechEnd": 297.14,
  "text": "You scan the forest. Deer. A fox.",
  "end": 298.21
 },
 {
  "i": 93,
  "start": 298.21,
  "speechStart": 298.36,
  "speechEnd": 299.84,
  "text": "Dev, glowing beside you.",
  "end": 300.11
 },
 {
  "i": 94,
  "start": 300.11,
  "speechStart": 300.26,
  "speechEnd": 303.58,
  "text": "Everything alive shows up. Except her. Why?",
  "end": 304.39
 },
 {
  "i": 95,
  "start": 304.39,
  "speechStart": 304.54,
  "speechEnd": 306.06,
  "text": "Rain has soaked everything cold.",
  "end": 306.51
 },
 {
  "i": 96,
  "start": 306.51,
  "speechStart": 306.66,
  "speechEnd": 309.82,
  "text": "Warm and cool fade to the same grey. So where is she?",
  "end": 310.21
 },
 {
  "i": 97,
  "start": 310.21,
  "speechStart": 310.36,
  "speechEnd": 313.64,
  "text": "Ranger Tomas, in his blue cap, shouts that it is hopeless.",
  "end": 313.49
 },
 {
  "i": 98,
  "start": 313.49,
  "speechStart": 313.64,
  "speechEnd": 315.42,
  "text": "You find a cave mouth.",
  "end": 315.79
 },
 {
  "i": 99,
  "start": 315.79,
  "speechStart": 315.94,
  "speechEnd": 321.94,
  "text": "Mina's coat is zipped, her skin cool, her body blending into the rock. Almost enough. Not quite.",
  "end": 321.79
 },
 {
  "i": 100,
  "start": 321.79,
  "speechStart": 321.94,
  "speechEnd": 324.54,
  "text": "Tomas swings his torch at the cave.",
  "end": 325.01
 },
 {
  "i": 101,
  "start": 325.01,
  "speechStart": 325.16,
  "speechEnd": 331.48,
  "text": "Light slams into your eyes. Everything goes white. You are blind... again. Time is short.",
  "end": 331.85
 },
 {
  "i": 102,
  "start": 331.85,
  "speechStart": 332.0,
  "speechEnd": 335.14,
  "text": "Mina is cold, and you are blind. Run in blind...",
  "end": 335.57
 },
 {
  "i": 103,
  "start": 335.57,
  "speechStart": 335.72,
  "speechEnd": 337.16,
  "text": "or wait in the dark?",
  "end": 337.01
 },
 {
  "i": 104,
  "start": 337.01,
  "speechStart": 337.16,
  "speechEnd": 339.58,
  "text": "Lights out, you croak. Everybody.",
  "end": 339.43
 },
 {
  "i": 105,
  "start": 339.43,
  "speechStart": 339.58,
  "speechEnd": 341.62,
  "text": "Tomas clicks off his torch.",
  "end": 342.05
 },
 {
  "i": 106,
  "start": 342.05,
  "speechStart": 342.2,
  "speechEnd": 347.5,
  "text": "You count sixty seconds in the dark. Then it comes back. Grey rock. Grey rain.",
  "end": 347.85
 },
 {
  "i": 107,
  "start": 347.85,
  "speechStart": 348.0,
  "speechEnd": 355.0,
  "text": "And one tiny white spark, as a small hand pulls it from a coat. Mina's hand warmer. The twin.",
  "end": 355.37
 },
 {
  "i": 108,
  "start": 355.37,
  "speechStart": 355.52,
  "speechEnd": 360.42,
  "text": "You reach her, curled under a rock ledge. She is cold. She is smiling.",
  "end": 360.91
 },
 {
  "i": 109,
  "start": 360.91,
  "speechStart": 361.06,
  "speechEnd": 365.16,
  "text": "You found me, she mumbles. Of course you did. Dev cheers.",
  "end": 365.01
 },
 {
  "i": 110,
  "start": 365.01,
  "speechStart": 365.16,
  "speechEnd": 369.74,
  "text": "Tomas wipes his eyes and blames the rain. Mina waves the little brick.",
  "end": 369.59
 },
 {
  "i": 111,
  "start": 369.59,
  "speechStart": 369.74,
  "speechEnd": 371.0,
  "text": "Best twin ever...",
  "end": 371.57
 },
 {
  "i": 112,
  "start": 371.57,
  "speechStart": 371.72,
  "speechEnd": 373.52,
  "text": "and you owe me hot chocolate.",
  "end": 373.37
 },
 {
  "i": 113,
  "start": 373.37,
  "speechStart": 373.52,
  "speechEnd": 377.8,
  "text": "So... is any of this real? Pit vipers are.",
  "end": 378.13
 },
 {
  "i": 114,
  "start": 378.13,
  "speechStart": 378.28,
  "speechEnd": 379.48,
  "text": "Thermal cameras are.",
  "end": 379.33
 },
 {
  "i": 115,
  "start": 379.33,
  "speechStart": 379.48,
  "speechEnd": 381.28,
  "text": "Night-vision goggles are.",
  "end": 381.57
 },
 {
  "i": 116,
  "start": 381.57,
  "speechStart": 381.72,
  "speechEnd": 384.0,
  "text": "Even single photons are, barely.",
  "end": 384.25
 },
 {
  "i": 117,
  "start": 384.25,
  "speechStart": 384.4,
  "speechEnd": 386.02,
  "text": "But no human can see heat.",
  "end": 386.47
 },
 {
  "i": 118,
  "start": 386.47,
  "speechStart": 386.62,
  "speechEnd": 388.22,
  "text": "Goggles are not eyes.",
  "end": 388.67
 },
 {
  "i": 119,
  "start": 388.67,
  "speechStart": 388.82,
  "speechEnd": 391.5,
  "text": "And without any light, cats and goggles are blind.",
  "end": 391.95
 },
 {
  "i": 120,
  "start": 391.95,
  "speechStart": 392.1,
  "speechEnd": 398.66,
  "text": "Your power would need infrared sensors, and a body that doesn't glow itself. Are we close? Not yet.",
  "end": 399.13
 },
 {
  "i": 121,
  "start": 399.13,
  "speechStart": 399.28,
  "speechEnd": 403.4,
  "text": "The dark was never empty. It was only quiet. So what would you do...",
  "end": 403.77
 },
 {
  "i": 122,
  "start": 403.77,
  "speechStart": 403.92,
  "speechEnd": 407.04,
  "text": "if you could see in complete darkness? Tell us in the comments.",
  "end": 407.61
 },
 {
  "i": 123,
  "start": 407.61,
  "speechStart": 407.76,
  "speechEnd": 410.24,
  "text": "And if you would trust that tiny white spark...",
  "end": 410.51
 },
 {
  "i": 124,
  "start": 410.51,
  "speechStart": 410.66,
  "speechEnd": 413.06,
  "text": "hit like, and subscribe for more What Ifs.",
  "end": 414.56
 }
]