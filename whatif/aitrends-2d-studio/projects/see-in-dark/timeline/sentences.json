[
 {
  "i": 0,
  "start": 0.0,
  "end": 1.4,
  "text": "Blackout."
 },
 {
  "i": 1,
  "start": 1.4,
  "end": 3.12,
  "text": "Every light on your street dies at once."
 },
 {
  "i": 2,
  "start": 3.64,
  "end": 4.4,
  "text": "You keep walking."
 },
 {
  "i": 3,
  "start": 5.08,
  "end": 6.16,
  "text": "Round the coffee table."
 },
 {
  "i": 4,
  "start": 6.6,
  "end": 7.28,
  "text": "Over the shoe."
 },
 {
  "i": 5,
  "start": 7.76,
  "end": 10.0,
  "text": "Past the door that always eats your knee."
 },
 {
  "i": 6,
  "start": 10.52,
  "end": 12.46,
  "text": "You find the cat on top of the fridge."
 },
 {
  "i": 7,
  "start": 13.04,
  "end": 13.72,
  "text": "Biscuit blinks."
 },
 {
  "i": 8,
  "start": 14.32,
  "end": 15.68,
  "text": "She looks offended."
 },
 {
  "i": 9,
  "start": 16.36,
  "end": 19.12,
  "text": "Your little sister Mina stumbles in, torch first."
 },
 {
  "i": 10,
  "start": 19.7,
  "end": 21.46,
  "text": "How are you doing this?"
 },
 {
  "i": 11,
  "start": 21.46,
  "end": 21.96,
  "text": "You shrug."
 },
 {
  "i": 12,
  "start": 22.48,
  "end": 24.08,
  "text": "You can see the mouse by the bin."
 },
 {
  "i": 13,
  "start": 24.62,
  "end": 26.26,
  "text": "You can see the toast cooling."
 },
 {
  "i": 14,
  "start": 26.76,
  "end": 28.7,
  "text": "You still cannot find your phone charger."
 },
 {
  "i": 15,
  "start": 29.32,
  "end": 31.04,
  "text": "What if you could see in complete darkness?"
 },
 {
  "i": 16,
  "start": 31.04,
  "end": 33.34,
  "text": "Rule one..."
 },
 {
  "i": 17,
  "start": 33.34,
  "end": 34.68,
  "text": "your eyes quit first."
 },
 {
  "i": 18,
  "start": 35.2,
  "end": 38.32,
  "text": "A human eye holds about one hundred and twenty million rods."
 },
 {
  "i": 19,
  "start": 39.04,
  "end": 39.96,
  "text": "Rods handle the dark."
 },
 {
  "i": 20,
  "start": 40.5,
  "end": 42.94,
  "text": "It also holds about six million cones."
 },
 {
  "i": 21,
  "start": 43.68,
  "end": 45.02,
  "text": "Cones handle colour."
 },
 {
  "i": 22,
  "start": 45.02,
  "end": 46.38,
  "text": "And at night, they clock out."
 },
 {
  "i": 23,
  "start": 46.9,
  "end": 48.56,
  "text": "Walk from sunshine into a cinema."
 },
 {
  "i": 24,
  "start": 49.06,
  "end": 49.98,
  "text": "You are blind."
 },
 {
  "i": 25,
  "start": 50.54,
  "end": 53.18,
  "text": "Your rods need twenty to thirty minutes to catch up."
 },
 {
  "i": 26,
  "start": 53.68,
  "end": 57.22,
  "text": "Dev shuffles in beside you, orange beanie first, popcorn flying."
 },
 {
  "i": 27,
  "start": 57.82,
  "end": 59.28,
  "text": "Where is row F?"
 },
 {
  "i": 28,
  "start": 59.28,
  "end": 60.06,
  "text": "he groans."
 },
 {
  "i": 29,
  "start": 60.5,
  "end": 61.68,
  "text": "You walk straight to it."
 },
 {
  "i": 30,
  "start": 62.08,
  "end": 64.88,
  "text": "A cat needs roughly a sixth of the light you do."
 },
 {
  "i": 31,
  "start": 64.88,
  "end": 66.24,
  "text": "You?"
 },
 {
  "i": 32,
  "start": 66.24,
  "end": 66.42,
  "text": "None."
 },
 {
  "i": 33,
  "start": 66.94,
  "end": 69.04,
  "text": "But even a cat is blind in true darkness."
 },
 {
  "i": 34,
  "start": 69.72,
  "end": 71.36,
  "text": "Humans are not hopeless, though."
 },
 {
  "i": 35,
  "start": 71.8,
  "end": 73.38,
  "text": "In a 2016 experiment,"
 },
 {
  "i": 36,
  "start": 74.28,
  "end": 76.56,
  "text": "volunteers spotted single photons better than chance."
 },
 {
  "i": 37,
  "start": 77.2,
  "end": 77.8,
  "text": "One photon."
 },
 {
  "i": 38,
  "start": 78.24,
  "end": 78.56,
  "text": "One."
 },
 {
  "i": 39,
  "start": 79.2,
  "end": 80.64,
  "text": "Upside, no more stubbed toes."
 },
 {
  "i": 40,
  "start": 81.32,
  "end": 84.4,
  "text": "Downside, Dev wants to know why you keep staring at him."
 },
 {
  "i": 41,
  "start": 85.04,
  "end": 85.7,
  "text": "Fair question."
 },
 {
  "i": 42,
  "start": 86.66,
  "end": 88.6,
  "text": "So how do you see where nothing shines?"
 },
 {
  "i": 43,
  "start": 89.62,
  "end": 89.62,
  "text": "Simple..."
 },
 {
  "i": 44,
  "start": 90.36,
  "end": 91.32,
  "text": "nothing has to shine."
 },
 {
  "i": 45,
  "start": 91.92,
  "end": 93.46,
  "text": "Everything is already glowing."
 },
 {
  "i": 46,
  "start": 94.76,
  "end": 96.06,
  "text": "Rule two..."
 },
 {
  "i": 47,
  "start": 96.06,
  "end": 97.26,
  "text": "dark isn't empty."
 },
 {
  "i": 48,
  "start": 97.72,
  "end": 100.78,
  "text": "Anything above absolute zero glows with infrared."
 },
 {
  "i": 49,
  "start": 101.52,
  "end": 102.1,
  "text": "Your couch."
 },
 {
  "i": 50,
  "start": 102.5,
  "end": 103.14,
  "text": "Your cat."
 },
 {
  "i": 51,
  "start": 103.62,
  "end": 104.06,
  "text": "You."
 },
 {
  "i": 52,
  "start": 104.76,
  "end": 104.96,
  "text": "Dr."
 },
 {
  "i": 53,
  "start": 105.74,
  "end": 108.22,
  "text": "Lin, in her green lanyard, kills every light in the lab."
 },
 {
  "i": 54,
  "start": 108.82,
  "end": 109.86,
  "text": "She holds up one hand."
 },
 {
  "i": 55,
  "start": 110.36,
  "end": 111.92,
  "text": "You count five warm fingers."
 },
 {
  "i": 56,
  "start": 112.54,
  "end": 113.36,
  "text": "She is not scared."
 },
 {
  "i": 57,
  "start": 113.98,
  "end": 115.2,
  "text": "She is thrilled."
 },
 {
  "i": 58,
  "start": 115.8,
  "end": 117.86,
  "text": "This is thermal vision, she whispers."
 },
 {
  "i": 59,
  "start": 118.7,
  "end": 119.48,
  "text": "Not magic."
 },
 {
  "i": 60,
  "start": 120.26,
  "end": 120.32,
  "text": "Physics."
 },
 {
  "i": 61,
  "start": 121.12,
  "end": 125.32,
  "text": "Human skin glows most strongly near nine and a half micrometres."
 },
 {
  "i": 62,
  "start": 125.32,
  "end": 126.68,
  "text": "That is long-wave infrared."
 },
 {
  "i": 63,
  "start": 127.19,
  "end": 129.62,
  "text": "Thermal cameras read exactly that band."
 },
 {
  "i": 64,
  "start": 130.18,
  "end": 131.42,
  "text": "Your own eyes can't."
 },
 {
  "i": 65,
  "start": 131.78,
  "end": 132.4,
  "text": "One reason?"
 },
 {
  "i": 66,
  "start": 132.86,
  "end": 133.76,
  "text": "They are warm too."
 },
 {
  "i": 67,
  "start": 134.24,
  "end": 136.74,
  "text": "It's like reading a dim screen with a torch in your face."
 },
 {
  "i": 68,
  "start": 137.5,
  "end": 138.56,
  "text": "Nature found a workaround."
 },
 {
  "i": 69,
  "start": 139.18,
  "end": 141.74,
  "text": "Pit vipers have a hollow pit on their face."
 },
 {
  "i": 70,
  "start": 142.32,
  "end": 144.34,
  "text": "It works like a pinhole camera for heat."
 },
 {
  "i": 71,
  "start": 144.92,
  "end": 148.32,
  "text": "Its nerves use a heat-sensitive protein called TRPA1."
 },
 {
  "i": 72,
  "start": 148.98,
  "end": 151.08,
  "text": "Scientists pinned that down in 2010."
 },
 {
  "i": 73,
  "start": 151.46,
  "end": 153.98,
  "text": "A snake finds a mouse in total darkness."
 },
 {
  "i": 74,
  "start": 153.98,
  "end": 155.34,
  "text": "You?"
 },
 {
  "i": 75,
  "start": 155.34,
  "end": 156.06,
  "text": "The mouse..."
 },
 {
  "i": 76,
  "start": 156.46,
  "end": 157.26,
  "text": "and the remote."
 },
 {
  "i": 77,
  "start": 157.82,
  "end": 160.9,
  "text": "Out on the dark street, you spot a kitten under a parked car."
 },
 {
  "i": 78,
  "start": 160.9,
  "end": 162.62,
  "text": "A small orange glow."
 },
 {
  "i": 79,
  "start": 163.22,
  "end": 164.08,
  "text": "You rescue it."
 },
 {
  "i": 80,
  "start": 164.52,
  "end": 167.44,
  "text": "Then you walk face first into a shop window."
 },
 {
  "i": 81,
  "start": 168.14,
  "end": 170.2,
  "text": "Ordinary glass blocks thermal infrared."
 },
 {
  "i": 82,
  "start": 170.84,
  "end": 173.04,
  "text": "To you, it is a flat, cold wall."
 },
 {
  "i": 83,
  "start": 173.68,
  "end": 174.76,
  "text": "Dev wheezes with laughter."
 },
 {
  "i": 84,
  "start": 174.76,
  "end": 176.32,
  "text": "Mate..."
 },
 {
  "i": 85,
  "start": 176.32,
  "end": 177.16,
  "text": "that was a window."
 },
 {
  "i": 86,
  "start": 177.16,
  "end": 179.46,
  "text": "Ten out of ten."
 },
 {
  "i": 87,
  "start": 179.46,
  "end": 181.28,
  "text": "Rule three..."
 },
 {
  "i": 88,
  "start": 181.28,
  "end": 183.22,
  "text": "heat has no colour."
 },
 {
  "i": 89,
  "start": 183.22,
  "end": 185.34,
  "text": "Mina slides a birthday card across the table."
 },
 {
  "i": 90,
  "start": 185.8,
  "end": 188.6,
  "text": "In the dark, it is a blank, warm rectangle."
 },
 {
  "i": 91,
  "start": 189.34,
  "end": 191.28,
  "text": "Ink and paper sit at the same temperature."
 },
 {
  "i": 92,
  "start": 191.8,
  "end": 192.56,
  "text": "No contrast."
 },
 {
  "i": 93,
  "start": 193.16,
  "end": 193.78,
  "text": "No words."
 },
 {
  "i": 94,
  "start": 194.4,
  "end": 195.88,
  "text": "You guess happy birthday."
 },
 {
  "i": 95,
  "start": 196.66,
  "end": 198.06,
  "text": "It says get well soon."
 },
 {
  "i": 96,
  "start": 198.68,
  "end": 200.86,
  "text": "She tucks a hand warmer into your hoodie pocket."
 },
 {
  "i": 97,
  "start": 201.46,
  "end": 202.5,
  "text": "Keep it, she says."
 },
 {
  "i": 98,
  "start": 203.08,
  "end": 204.32,
  "text": "I have the twin."
 },
 {
  "i": 99,
  "start": 204.82,
  "end": 206.82,
  "text": "In your sight, it burns like a coal."
 },
 {
  "i": 100,
  "start": 206.82,
  "end": 209.02,
  "text": "Night-vision goggles work differently."
 },
 {
  "i": 101,
  "start": 209.62,
  "end": 211.8,
  "text": "They amplify the faint light already there."
 },
 {
  "i": 102,
  "start": 212.52,
  "end": 212.82,
  "text": "Starlight."
 },
 {
  "i": 103,
  "start": 213.4,
  "end": 213.8,
  "text": "Moonlight."
 },
 {
  "i": 104,
  "start": 214.3,
  "end": 215.18,
  "text": "In true darkness?"
 },
 {
  "i": 105,
  "start": 215.9,
  "end": 216.8,
  "text": "Nothing to amplify."
 },
 {
  "i": 106,
  "start": 217.46,
  "end": 219.52,
  "text": "So thermal wins the pitch black..."
 },
 {
  "i": 107,
  "start": 220.06,
  "end": 221.28,
  "text": "but only for warm things."
 },
 {
  "i": 108,
  "start": 221.28,
  "end": 223.36,
  "text": "Colour is a bigger ask."
 },
 {
  "i": 109,
  "start": 223.94,
  "end": 227.16,
  "text": "Helmet geckos told blue from grey at moonlight levels in 2004."
 },
 {
  "i": 110,
  "start": 227.96,
  "end": 228.14,
  "text": "You?"
 },
 {
  "i": 111,
  "start": 228.62,
  "end": 230.08,
  "text": "Hot, warm, cold."
 },
 {
  "i": 112,
  "start": 230.62,
  "end": 232.18,
  "text": "That is your entire palette."
 },
 {
  "i": 113,
  "start": 232.18,
  "end": 235.52,
  "text": "Upside, you win hide and seek forever."
 },
 {
  "i": 114,
  "start": 235.98,
  "end": 237.84,
  "text": "Downside, you can't read a menu."
 },
 {
  "i": 115,
  "start": 239.0,
  "end": 240.08,
  "text": "Rule four..."
 },
 {
  "i": 116,
  "start": 240.08,
  "end": 241.02,
  "text": "light is the enemy."
 },
 {
  "i": 117,
  "start": 241.6,
  "end": 243.12,
  "text": "You step off the kerb at midnight."
 },
 {
  "i": 118,
  "start": 243.72,
  "end": 246.56,
  "text": "A cyclist, no lamp, glows like a ghost."
 },
 {
  "i": 119,
  "start": 247.1,
  "end": 248.48,
  "text": "You yank Dev back."
 },
 {
  "i": 120,
  "start": 249.06,
  "end": 249.68,
  "text": "Saved him."
 },
 {
  "i": 121,
  "start": 250.32,
  "end": 251.14,
  "text": "Dev stares at you."
 },
 {
  "i": 122,
  "start": 251.56,
  "end": 252.38,
  "text": "How did you see that?"
 },
 {
  "i": 123,
  "start": 252.74,
  "end": 255.02,
  "text": "Then the cyclist's lamp snaps on."
 },
 {
  "i": 124,
  "start": 255.52,
  "end": 256.8,
  "text": "It is one bright flash."
 },
 {
  "i": 125,
  "start": 257.4,
  "end": 258.92,
  "text": "Your thermal view whites out."
 },
 {
  "i": 126,
  "start": 258.92,
  "end": 260.98,
  "text": "Your old eyes are not ready either."
 },
 {
  "i": 127,
  "start": 261.72,
  "end": 262.22,
  "text": "Total blindness."
 },
 {
  "i": 128,
  "start": 263.0,
  "end": 264.26,
  "text": "Bright light floods your rods."
 },
 {
  "i": 129,
  "start": 264.86,
  "end": 266.64,
  "text": "They need twenty to thirty minutes to recover."
 },
 {
  "i": 130,
  "start": 267.2,
  "end": 268.8,
  "text": "Your new sight takes about a minute."
 },
 {
  "i": 131,
  "start": 269.42,
  "end": 270.74,
  "text": "A long, shaky minute."
 },
 {
  "i": 132,
  "start": 271.54,
  "end": 272.92,
  "text": "Dev guides you home by the sleeve."
 },
 {
  "i": 133,
  "start": 273.52,
  "end": 273.82,
  "text": "Amazing."
 },
 {
  "i": 134,
  "start": 274.64,
  "end": 275.44,
  "text": "And awful."
 },
 {
  "i": 135,
  "start": 276.56,
  "end": 277.48,
  "text": "Usually both at once."
 },
 {
  "i": 136,
  "start": 278.12,
  "end": 279.58,
  "text": "So the rule is simple."
 },
 {
  "i": 137,
  "start": 280.2,
  "end": 281.08,
  "text": "Dark is your friend."
 },
 {
  "i": 138,
  "start": 281.62,
  "end": 282.6,
  "text": "Light is a punch."
 },
 {
  "i": 139,
  "start": 283.24,
  "end": 283.96,
  "text": "Remember that..."
 },
 {
  "i": 140,
  "start": 284.36,
  "end": 286.54,
  "text": "because you are about to need it."
 },
 {
  "i": 141,
  "start": 287.22,
  "end": 288.56,
  "text": "Rule five..."
 },
 {
  "i": 142,
  "start": 288.56,
  "end": 289.34,
  "text": "cold hides."
 },
 {
  "i": 143,
  "start": 289.92,
  "end": 291.12,
  "text": "A school camping trip."
 },
 {
  "i": 144,
  "start": 291.56,
  "end": 292.4,
  "text": "Rain on the trees."
 },
 {
  "i": 145,
  "start": 293.14,
  "end": 293.7,
  "text": "Mina is gone."
 },
 {
  "i": 146,
  "start": 294.22,
  "end": 295.24,
  "text": "You scan the forest."
 },
 {
  "i": 147,
  "start": 296.02,
  "end": 296.24,
  "text": "Deer."
 },
 {
  "i": 148,
  "start": 296.88,
  "end": 297.14,
  "text": "A fox."
 },
 {
  "i": 149,
  "start": 298.36,
  "end": 299.84,
  "text": "Dev, glowing beside you."
 },
 {
  "i": 150,
  "start": 300.26,
  "end": 301.74,
  "text": "Everything alive shows up."
 },
 {
  "i": 151,
  "start": 302.06,
  "end": 302.82,
  "text": "Except her."
 },
 {
  "i": 152,
  "start": 303.28,
  "end": 303.58,
  "text": "Why?"
 },
 {
  "i": 153,
  "start": 304.54,
  "end": 306.06,
  "text": "Rain has soaked everything cold."
 },
 {
  "i": 154,
  "start": 306.66,
  "end": 308.76,
  "text": "Warm and cool fade to the same grey."
 },
 {
  "i": 155,
  "start": 308.76,
  "end": 309.82,
  "text": "So where is she?"
 },
 {
  "i": 156,
  "start": 310.36,
  "end": 313.64,
  "text": "Ranger Tomas, in his blue cap, shouts that it is hopeless."
 },
 {
  "i": 157,
  "start": 313.64,
  "end": 315.42,
  "text": "You find a cave mouth."
 },
 {
  "i": 158,
  "start": 315.94,
  "end": 319.66,
  "text": "Mina's coat is zipped, her skin cool, her body blending into the rock."
 },
 {
  "i": 159,
  "start": 320.14,
  "end": 320.8,
  "text": "Almost enough."
 },
 {
  "i": 160,
  "start": 321.36,
  "end": 321.94,
  "text": "Not quite."
 },
 {
  "i": 161,
  "start": 321.94,
  "end": 324.54,
  "text": "Tomas swings his torch at the cave."
 },
 {
  "i": 162,
  "start": 325.16,
  "end": 326.54,
  "text": "Light slams into your eyes."
 },
 {
  "i": 163,
  "start": 327.08,
  "end": 328.08,
  "text": "Everything goes white."
 },
 {
  "i": 164,
  "start": 328.58,
  "end": 329.26,
  "text": "You are blind..."
 },
 {
  "i": 165,
  "start": 329.74,
  "end": 330.14,
  "text": "again."
 },
 {
  "i": 166,
  "start": 330.76,
  "end": 331.48,
  "text": "Time is short."
 },
 {
  "i": 167,
  "start": 332.0,
  "end": 333.84,
  "text": "Mina is cold, and you are blind."
 },
 {
  "i": 168,
  "start": 334.34,
  "end": 335.14,
  "text": "Run in blind..."
 },
 {
  "i": 169,
  "start": 335.72,
  "end": 337.16,
  "text": "or wait in the dark?"
 },
 {
  "i": 170,
  "start": 337.16,
  "end": 338.78,
  "text": "Lights out, you croak."
 },
 {
  "i": 171,
  "start": 338.78,
  "end": 339.58,
  "text": "Everybody."
 },
 {
  "i": 172,
  "start": 339.58,
  "end": 341.62,
  "text": "Tomas clicks off his torch."
 },
 {
  "i": 173,
  "start": 342.2,
  "end": 344.0,
  "text": "You count sixty seconds in the dark."
 },
 {
  "i": 174,
  "start": 344.68,
  "end": 345.42,
  "text": "Then it comes back."
 },
 {
  "i": 175,
  "start": 345.42,
  "end": 346.46,
  "text": "Grey rock."
 },
 {
  "i": 176,
  "start": 346.46,
  "end": 347.5,
  "text": "Grey rain."
 },
 {
  "i": 177,
  "start": 348.0,
  "end": 351.6,
  "text": "And one tiny white spark, as a small hand pulls it from a coat."
 },
 {
  "i": 178,
  "start": 352.18,
  "end": 353.1,
  "text": "Mina's hand warmer."
 },
 {
  "i": 179,
  "start": 353.96,
  "end": 355.0,
  "text": "The twin."
 },
 {
  "i": 180,
  "start": 355.52,
  "end": 357.72,
  "text": "You reach her, curled under a rock ledge."
 },
 {
  "i": 181,
  "start": 358.36,
  "end": 359.16,
  "text": "She is cold."
 },
 {
  "i": 182,
  "start": 359.68,
  "end": 360.42,
  "text": "She is smiling."
 },
 {
  "i": 183,
  "start": 361.06,
  "end": 362.74,
  "text": "You found me, she mumbles."
 },
 {
  "i": 184,
  "start": 363.36,
  "end": 364.14,
  "text": "Of course you did."
 },
 {
  "i": 185,
  "start": 364.68,
  "end": 365.16,
  "text": "Dev cheers."
 },
 {
  "i": 186,
  "start": 365.16,
  "end": 367.88,
  "text": "Tomas wipes his eyes and blames the rain."
 },
 {
  "i": 187,
  "start": 368.56,
  "end": 369.74,
  "text": "Mina waves the little brick."
 },
 {
  "i": 188,
  "start": 369.74,
  "end": 371.0,
  "text": "Best twin ever..."
 },
 {
  "i": 189,
  "start": 371.72,
  "end": 373.52,
  "text": "and you owe me hot chocolate."
 },
 {
  "i": 190,
  "start": 373.52,
  "end": 375.32,
  "text": "So..."
 },
 {
  "i": 191,
  "start": 375.32,
  "end": 376.4,
  "text": "is any of this real?"
 },
 {
  "i": 192,
  "start": 376.92,
  "end": 377.8,
  "text": "Pit vipers are."
 },
 {
  "i": 193,
  "start": 378.28,
  "end": 379.48,
  "text": "Thermal cameras are."
 },
 {
  "i": 194,
  "start": 379.48,
  "end": 381.28,
  "text": "Night-vision goggles are."
 },
 {
  "i": 195,
  "start": 381.72,
  "end": 384.0,
  "text": "Even single photons are, barely."
 },
 {
  "i": 196,
  "start": 384.4,
  "end": 386.02,
  "text": "But no human can see heat."
 },
 {
  "i": 197,
  "start": 386.62,
  "end": 388.22,
  "text": "Goggles are not eyes."
 },
 {
  "i": 198,
  "start": 388.82,
  "end": 391.5,
  "text": "And without any light, cats and goggles are blind."
 },
 {
  "i": 199,
  "start": 392.1,
  "end": 396.26,
  "text": "Your power would need infrared sensors, and a body that doesn't glow itself."
 },
 {
  "i": 200,
  "start": 396.78,
  "end": 397.36,
  "text": "Are we close?"
 },
 {
  "i": 201,
  "start": 398.12,
  "end": 398.66,
  "text": "Not yet."
 },
 {
  "i": 202,
  "start": 399.28,
  "end": 400.44,
  "text": "The dark was never empty."
 },
 {
  "i": 203,
  "start": 400.96,
  "end": 401.76,
  "text": "It was only quiet."
 },
 {
  "i": 204,
  "start": 402.34,
  "end": 403.4,
  "text": "So what would you do..."
 },
 {
  "i": 205,
  "start": 403.92,
  "end": 405.62,
  "text": "if you could see in complete darkness?"
 },
 {
  "i": 206,
  "start": 406.22,
  "end": 407.04,
  "text": "Tell us in the comments."
 },
 {
  "i": 207,
  "start": 407.76,
  "end": 410.24,
  "text": "And if you would trust that tiny white spark..."
 },
 {
  "i": 208,
  "start": 410.66,
  "end": 413.06,
  "text": "hit like, and subscribe for more What Ifs."
 }
]