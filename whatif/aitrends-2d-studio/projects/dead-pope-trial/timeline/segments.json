[
 {
  "line": 1,
  "text": "A pope once put a dead pope on trial.",
  "start": 0.186,
  "end": 2.121
 },
 {
  "line": 2,
  "text": "The dead pope lost.",
  "start": 3.107,
  "end": 4.165
 },
 {
  "line": 3,
  "text": "Rome, eight ninety-seven.",
  "start": 4.58,
  "end": 5.702
 },
 {
  "line": 4,
  "text": "Pope Stephen the Sixth has his predecessor, Formosus, dug up.",
  "start": 6.14,
  "end": 9.695
 },
 {
  "line": 5,
  "text": "He'd been dead for nine months.",
  "start": 10.136,
  "end": 11.597
 },
 {
  "line": 6,
  "text": "They dress him in his papal robes, and sit him on a throne.",
  "start": 12.012,
  "end": 15.144
 },
 {
  "line": 7,
  "text": "Wait.",
  "start": 15.57,
  "end": 16.047
 },
 {
  "line": 7,
  "text": "How does a dead man defend himself?",
  "start": 16.446,
  "end": 18.227
 },
 {
  "line": 8,
  "text": "You see, a deacon stands next to him and answers for him.",
  "start": 18.646,
  "end": 21.745
 },
 {
  "line": 9,
  "text": "Badly.",
  "start": 22.708,
  "end": 23.277
 },
 {
  "line": 10,
  "text": "Verdict: guilty.",
  "start": 23.731,
  "end": 24.721
 },
 {
  "line": 10,
  "text": "Everything he did as pope?",
  "start": 25.132,
  "end": 26.395
 },
 {
  "line": 10,
  "text": "Cancelled.",
  "start": 26.807,
  "end": 27.448
 },
 {
  "line": 11,
  "text": "Months later, a new pope cancelled the verdict...",
  "start": 27.886,
  "end": 30.293
 },
 {
  "line": 12,
  "text": "and banned putting dead people on trial.",
  "start": 31.253,
  "end": 33.138
 },
 {
  "line": 13,
  "text": "Subscribe for more.",
  "start": 33.569,
  "end": 34.634
 }
]