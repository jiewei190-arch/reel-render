[
 {
  "i": 0,
  "start": 0.0,
  "end": 1.34,
  "text": "Sharks are older than trees."
 },
 {
  "i": 1,
  "start": 1.86,
  "end": 2.68,
  "text": "Let that sink in."
 },
 {
  "i": 2,
  "start": 3.32,
  "end": 5.92,
  "text": "Sharks have been around for about 450 million years."
 },
 {
  "i": 3,
  "start": 6.34,
  "end": 6.5,
  "text": "Trees?"
 },
 {
  "i": 4,
  "start": 7.02,
  "end": 9.04,
  "text": "Only 350 to 390 million."
 },
 {
  "i": 5,
  "start": 9.76,
  "end": 13.26,
  "text": "Sharks were swimming for 60 million years before the first tree grew on land."
 },
 {
  "i": 6,
  "start": 13.88,
  "end": 16.9,
  "text": "They're older than dinosaurs by about 200 million years."
 },
 {
  "i": 7,
  "start": 17.18,
  "end": 18.3,
  "text": "Older than the Atlantic Ocean."
 },
 {
  "i": 8,
  "start": 19.02,
  "end": 21.04,
  "text": "They've survived all FIVE mass extinctions..."
 },
 {
  "i": 9,
  "start": 22.22,
  "end": 23.86,
  "text": "including the one that killed the dinosaurs."
 },
 {
  "i": 10,
  "start": 24.64,
  "end": 26.76,
  "text": "Meaning the scariest thing in the ocean..."
 },
 {
  "i": 11,
  "start": 27.55,
  "end": 29.62,
  "text": "is also the most experienced thing on Earth."
 },
 {
  "i": 12,
  "start": 30.5,
  "end": 31.48,
  "text": "Trees are the new kids."
 },
 {
  "i": 13,
  "start": 32.06,
  "end": 33.12,
  "text": "Sharks just let them stay."
 },
 {
  "i": 14,
  "start": 34.1,
  "end": 34.72,
  "text": "Subscribe for more."
 }
]