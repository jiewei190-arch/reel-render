[
 {
  "i": 0,
  "start": 0.0,
  "end": 2.34,
  "text": "On Venus, you'd be crushed, cooked and dissolved."
 },
 {
  "i": 1,
  "start": 2.96,
  "end": 3.62,
  "text": "In that order?"
 },
 {
  "i": 2,
  "start": 4.6,
  "end": 4.88,
  "text": "No."
 },
 {
  "i": 3,
  "start": 5.44,
  "end": 6.1,
  "text": "All at once."
 },
 {
  "i": 4,
  "start": 6.6,
  "end": 7.12,
  "text": "Wait, how?"
 },
 {
  "i": 5,
  "start": 7.66,
  "end": 11.76,
  "text": "You see, the air there presses down over ninety times harder than on Earth."
 },
 {
  "i": 6,
  "start": 12.28,
  "end": 14.46,
  "text": "Like standing three thousand feet underwater."
 },
 {
  "i": 7,
  "start": 15.06,
  "end": 18.1,
  "text": "The ground is four hundred and sixty-four degrees Celsius."
 },
 {
  "i": 8,
  "start": 18.7,
  "end": 19.74,
  "text": "Hot enough to melt lead."
 },
 {
  "i": 9,
  "start": 20.34,
  "end": 23.6,
  "text": "That's hotter than Mercury, and Mercury is closer to the Sun."
 },
 {
  "i": 10,
  "start": 24.14,
  "end": 24.96,
  "text": "And on the way down?"
 },
 {
  "i": 11,
  "start": 25.6,
  "end": 26.86,
  "text": "Clouds of sulfuric acid."
 },
 {
  "i": 12,
  "start": 27.74,
  "end": 29.1,
  "text": "Luckily, you get beamed out."
 },
 {
  "i": 13,
  "start": 29.1,
  "end": 31.52,
  "text": "The longest any probe has lasted there?"
 },
 {
  "i": 14,
  "start": 31.52,
  "end": 33.64,
  "text": "One hundred and twenty-seven minutes."
 },
 {
  "i": 15,
  "start": 34.2,
  "end": 35.04,
  "text": "Subscribe for more."
 }
]