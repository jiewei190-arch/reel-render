[
 {
  "i": 0,
  "start": 0.0,
  "end": 2.94,
  "text": "A town called Boring teamed up with a village called Dull."
 },
 {
  "i": 1,
  "start": 3.5,
  "end": 4.7,
  "text": "These are real places."
 },
 {
  "i": 2,
  "start": 5.46,
  "end": 6.42,
  "text": "Boring is in Oregon."
 },
 {
  "i": 3,
  "start": 6.42,
  "end": 9.12,
  "text": "Its motto: the most exciting place to live."
 },
 {
  "i": 4,
  "start": 9.8,
  "end": 10.62,
  "text": "Dull is in Scotland."
 },
 {
  "i": 5,
  "start": 11.58,
  "end": 12.58,
  "text": "Population: about 84."
 },
 {
  "i": 6,
  "start": 13.02,
  "end": 16.82,
  "text": "In 2012, a Scottish woman on a cycling holiday rode through Boring..."
 },
 {
  "i": 7,
  "start": 16.82,
  "end": 18.46,
  "text": "and had an idea."
 },
 {
  "i": 8,
  "start": 19.1,
  "end": 20.28,
  "text": "Boring's planning group voted."
 },
 {
  "i": 9,
  "start": 20.62,
  "end": 21.06,
  "text": "Unanimous."
 },
 {
  "i": 10,
  "start": 21.66,
  "end": 23.42,
  "text": "Boring and Dull, a pair for the ages."
 },
 {
  "i": 11,
  "start": 24.12,
  "end": 25.32,
  "text": "But here's the part..."
 },
 {
  "i": 12,
  "start": 25.78,
  "end": 26.68,
  "text": "now they throw a party."
 },
 {
  "i": 13,
  "start": 27.24,
  "end": 29.78,
  "text": "Boring and Dull Day, every August 9th."
 },
 {
  "i": 14,
  "start": 29.78,
  "end": 30.16,
  "text": "Yes."
 },
 {
  "i": 15,
  "start": 30.76,
  "end": 31.42,
  "text": "With bagpipes."
 },
 {
  "i": 16,
  "start": 32.0,
  "end": 34.66,
  "text": "Then, in 2013, a third town joined."
 },
 {
  "i": 17,
  "start": 35.06,
  "end": 35.12,
  "text": "Bland."
 },
 {
  "i": 18,
  "start": 35.7,
  "end": 36.9,
  "text": "As in, Bland, Australia."
 },
 {
  "i": 19,
  "start": 37.56,
  "end": 40.22,
  "text": "Together, they're the League of Extraordinary Communities."
 },
 {
  "i": 20,
  "start": 41.02,
  "end": 41.9,
  "text": "Also known as..."
 },
 {
  "i": 21,
  "start": 41.9,
  "end": 43.66,
  "text": "the Trinity of Tedium."
 },
 {
  "i": 22,
  "start": 44.3,
  "end": 45.24,
  "text": "Subscribe for more."
 }
]