[
 {
  "i": 0,
  "start": 0.0,
  "end": 2.12,
  "text": "What if the Earth stopped spinning for one second?"
 },
 {
  "i": 1,
  "start": 2.72,
  "end": 6.46,
  "text": "Right now, the ground under you is racing east, and you can't feel it."
 },
 {
  "i": 2,
  "start": 6.8,
  "end": 7.44,
  "text": "Then it stops."
 },
 {
  "i": 3,
  "start": 8.06,
  "end": 8.52,
  "text": "Instantly."
 },
 {
  "i": 4,
  "start": 9.18,
  "end": 9.76,
  "text": "But you don't."
 },
 {
  "i": 5,
  "start": 10.32,
  "end": 11.12,
  "text": "Neither does the air."
 },
 {
  "i": 6,
  "start": 11.68,
  "end": 12.52,
  "text": "Neither do the oceans."
 },
 {
  "i": 7,
  "start": 13.14,
  "end": 14.62,
  "text": "So how fast are you still going?"
 },
 {
  "i": 8,
  "start": 15.14,
  "end": 18.88,
  "text": "At the equator, about sixteen hundred seventy kilometers an hour."
 },
 {
  "i": 9,
  "start": 19.44,
  "end": 20.24,
  "text": "Faster than a jet."
 },
 {
  "i": 10,
  "start": 20.84,
  "end": 23.32,
  "text": "Everything not bolted to bedrock flies east."
 },
 {
  "i": 11,
  "start": 24.08,
  "end": 25.12,
  "text": "Subscribe for more."
 }
]