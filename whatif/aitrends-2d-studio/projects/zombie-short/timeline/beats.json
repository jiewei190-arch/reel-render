[
 {
  "i": 0,
  "start": 0.0,
  "speechStart": 0.0,
  "speechEnd": 2.3,
  "text": "The zombie apocalypse starts on a Tuesday.",
  "end": 3.09
 },
 {
  "i": 1,
  "start": 3.09,
  "speechStart": 3.24,
  "speechEnd": 8.38,
  "text": "Your only survival skill is ordering takeout. Day one.",
  "end": 8.23
 },
 {
  "i": 2,
  "start": 8.23,
  "speechStart": 8.38,
  "speechEnd": 13.2,
  "text": "You barricade the door with a beanbag. The zombies push it over. Gently.",
  "end": 14.75
 },
 {
  "i": 3,
  "start": 14.75,
  "speechStart": 14.9,
  "speechEnd": 16.2,
  "text": "Day two.",
  "end": 16.05
 },
 {
  "i": 4,
  "start": 16.05,
  "speechStart": 16.2,
  "speechEnd": 20.34,
  "text": "You sneak past them in squeaky shoes. Squeak. Squeak.",
  "end": 20.19
 },
 {
  "i": 5,
  "start": 20.19,
  "speechStart": 20.34,
  "speechEnd": 23.54,
  "text": "Forty heads turn. You run.",
  "end": 23.39
 },
 {
  "i": 6,
  "start": 23.39,
  "speechStart": 23.54,
  "speechEnd": 25.02,
  "text": "Mina runs faster.",
  "end": 25.67
 },
 {
  "i": 7,
  "start": 25.67,
  "speechStart": 25.82,
  "speechEnd": 29.72,
  "text": "Biscuit is already on the roof. Then your phone buzzes.",
  "end": 30.29
 },
 {
  "i": 8,
  "start": 30.29,
  "speechStart": 30.44,
  "speechEnd": 32.8,
  "text": "Your takeout, from Tuesday, is finally here.",
  "end": 33.33
 },
 {
  "i": 9,
  "start": 33.33,
  "speechStart": 33.48,
  "speechEnd": 37.82,
  "text": "The scooter pulls up, and every zombie on the street stops. And sniffs.",
  "end": 38.57
 },
 {
  "i": 10,
  "start": 38.57,
  "speechStart": 38.72,
  "speechEnd": 41.88,
  "text": "Turns out zombies don't want brains. They want fries.",
  "end": 43.23
 },
 {
  "i": 11,
  "start": 43.23,
  "speechStart": 43.38,
  "speechEnd": 46.62,
  "text": "So you do the one thing you're good at. You order more.",
  "end": 47.12
 },
 {
  "i": 12,
  "start": 47.12,
  "speechStart": 47.27,
  "speechEnd": 48.94,
  "text": "Day thirty.",
  "end": 48.79
 },
 {
  "i": 13,
  "start": 48.79,
  "speechStart": 48.94,
  "speechEnd": 55.06,
  "text": "You run the only delivery service in the apocalypse. Five stars. The zombies always tip.",
  "end": 54.91
 },
 {
  "i": 14,
  "start": 54.91,
  "speechStart": 55.06,
  "speechEnd": 59.72,
  "text": "In shoes. Would you survive? Tell me your one skill.",
  "end": 60.29
 },
 {
  "i": 15,
  "start": 60.29,
  "speechStart": 60.44,
  "speechEnd": 61.88,
  "text": "Full What If stories on the channel.",
  "end": 62.68
 }
]