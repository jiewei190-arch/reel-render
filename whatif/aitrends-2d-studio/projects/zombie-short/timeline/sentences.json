 },
 {
  "i": 9,
  "start": 18.7,
  "end": 19.68,
  "text": "Mistake number one."
 },
 {
  "i": 10,
  "start": 20.48,
  "end": 21.74,
  "text": "You turn on your flashlight."
 },
 {
  "i": 11,
  "start": 22.84,
  "end": 24.16,
  "text": "Something hits the front glass."
 },
 {
  "i": 12,
  "start": 24.94,
  "end": 25.72,
  "text": "Then another."
 },
 {
  "i": 13,
  "start": 26.64,
  "end": 27.46,
  "text": "Then a hundred."
 },
 {
  "i": 14,
  "start": 29.48,
  "end": 30.46,
  "text": "Mistake number two."
 },
 {
  "i": 15,
  "start": 31.42,
  "end": 34.94,
  "text": "You run to the back, into the freezer room, and pull the door shut."
 },
 {
  "i": 16,
  "start": 36.22,
  "end": 36.22,
  "text": "Cold."
 },
 {
  "i": 17,
  "start": 37.16,
  "end": 37.6,
  "text": "Dark."
 },
 {
  "i": 18,
  "start": 38.82,
  "end": 39.08,
  "text": "Silent."
 },
 {
  "i": 19,
  "start": 40.1,
  "end": 40.4,
  "text": "Safe."
 },
 {
  "i": 20,
  "start": 41.46,
  "end": 42.6,
  "text": "Mistake number three."
 },
 {
  "i": 21,
  "start": 43.46,
  "end": 47.64,
  "text": "The door only opens from the outside."
 },
 {
  "i": 22,
  "start": 47.64,
  "end": 48.04,
  "text": "Hours pass."
 },
 {
  "i": 23,
  "start": 49.08,
  "end": 49.86,
  "text": "Your phone dies."
 },
 {
  "i": 24,
  "start": 50.86,
  "end": 51.52,
  "text": "Then, a knock."
 },
 {
  "i": 25,
  "start": 52.68,
  "end": 52.86,
  "text": "Slow."
 },
 {
  "i": 26,
  "start": 53.88,
  "end": 54.36,
  "text": "Patient."
 },
 {
  "i": 27,
  "start": 55.58,
  "end": 55.58,
  "text": "Hey."
 },
 {
  "i": 28,
  "start": 55.6,
  "end": 55.96,
  "text": "It's me."
 },
 {
  "i": 29,
  "start": 56.06,
  "end": 56.58,
  "text": "Open up."
 },
 {
  "i": 30,
  "start": 57.68,
  "end": 58.34,
  "text": "It's Dev."
 },
 {
  "i": 31,
  "start": 59.2,
  "end": 61.26,
  "text": "But Dev didn't make it out on day one."
 },
 {
  "i": 32,
  "start": 62.16,
  "end": 63.24,
  "text": "Would you open the door?"
 }
]