[
 {
  "i": 0,
  "start": 0.0,
  "end": 2.1,
  "text": "One man hiccuped for 68 years..."
 },
 {
  "i": 1,
  "start": 3.0,
  "end": 3.0,
  "text": "straight."
 },
 {
  "i": 2,
  "start": 3.66,
  "end": 6.8,
  "text": "In 1922, farmer Charles Osborne reportedly went down..."
 },
 {
  "i": 3,
  "start": 7.14,
  "end": 8.86,
  "text": "under a 350-pound hog."
 },
 {
  "i": 4,
  "start": 9.34,
  "end": 10.5,
  "text": "Then he started hiccuping."
 },
 {
  "i": 5,
  "start": 10.78,
  "end": 11.84,
  "text": "And he did not..."
 },
 {
  "i": 6,
  "start": 12.4,
  "end": 12.7,
  "text": "stop."
 },
 {
  "i": 7,
  "start": 13.2,
  "end": 15.78,
  "text": "According to Guinness, 20 to 40 times a minute..."
 },
 {
  "i": 8,
  "start": 16.32,
  "end": 17.72,
  "text": "day and night, for decades."
 },
 {
  "i": 9,
  "start": 18.5,
  "end": 19.12,
  "text": "Doctors tried."
 },
 {
  "i": 10,
  "start": 19.64,
  "end": 20.18,
  "text": "Nothing lasted."
 },
 {
  "i": 11,
  "start": 20.68,
  "end": 21.3,
  "text": "His longest break?"
 },
 {
  "i": 12,
  "start": 21.68,
  "end": 22.28,
  "text": "Reportedly..."
 },
 {
  "i": 13,
  "start": 22.28,
  "end": 23.22,
  "text": "50 hours."
 },
 {
  "i": 14,
  "start": 23.98,
  "end": 25.1,
  "text": "But here's the part..."
 },
 {
  "i": 15,
  "start": 25.5,
  "end": 26.64,
  "text": "he lived a normal life anyway."
 },
 {
  "i": 16,
  "start": 27.24,
  "end": 29.36,
  "text": "He married twice, and reportedly had eight kids."
 },
 {
  "i": 17,
  "start": 30.0,
  "end": 30.78,
  "text": "One doctor's guess?"
 },
 {
  "i": 18,
  "start": 31.18,
  "end": 33.42,
  "text": "Lifting that hog popped a tiny blood vessel in his brain."
 },
 {
  "i": 19,
  "start": 34.26,
  "end": 36.18,
  "text": "Guinness called it the longest attack of hiccups ever."
 },
 {
  "i": 20,
  "start": 36.52,
  "end": 38.16,
  "text": "Over 400 million hiccups."
 },
 {
  "i": 21,
  "start": 38.9,
  "end": 41.18,
  "text": "Then, in 1990, after 68 years..."
 },
 {
  "i": 22,
  "start": 41.88,
  "end": 42.54,
  "text": "they just stopped."
 },
 {
  "i": 23,
  "start": 43.44,
  "end": 44.46,
  "text": "Subscribe for more."
 }
]