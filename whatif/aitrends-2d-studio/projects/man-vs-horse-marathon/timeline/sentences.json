[
 {
  "i": 0,
  "start": 0.0,
  "end": 2.04,
  "text": "Every year in Wales, people race horses..."
 },
 {
  "i": 1,
  "start": 2.04,
  "end": 3.02,
  "text": "on foot."
 },
 {
  "i": 2,
  "start": 3.34,
  "end": 6.38,
  "text": "It started in 1980, with an argument in a Welsh pub."
 },
 {
  "i": 3,
  "start": 6.94,
  "end": 9.64,
  "text": "Over a long distance, could a human keep up with a horse?"
 },
 {
  "i": 4,
  "start": 10.12,
  "end": 11.36,
  "text": "The landlord overheard..."
 },
 {
  "i": 5,
  "start": 11.36,
  "end": 13.52,
  "text": "and set up a race to find out."
 },
 {
  "i": 6,
  "start": 13.52,
  "end": 17.76,
  "text": "22 miles over the Welsh hills: runners versus horses and riders."
 },
 {
  "i": 7,
  "start": 18.24,
  "end": 20.34,
  "text": "For 25 years, the horses won."
 },
 {
  "i": 8,
  "start": 20.34,
  "end": 21.0,
  "text": "Every."
 },
 {
  "i": 9,
  "start": 21.0,
  "end": 21.58,
  "text": "Single."
 },
 {
  "i": 10,
  "start": 21.58,
  "end": 22.18,
  "text": "Time."
 },
 {
  "i": 11,
  "start": 22.94,
  "end": 24.14,
  "text": "But here's the part..."
 },
 {
  "i": 12,
  "start": 24.52,
  "end": 27.64,
  "text": "in 2004, a runner named Huw Lobb beat them all."
 },
 {
  "i": 13,
  "start": 28.18,
  "end": 29.06,
  "text": "By about 2 minutes."
 },
 {
  "i": 14,
  "start": 29.06,
  "end": 31.76,
  "text": "And he took home a 25,000 pound prize."
 },
 {
  "i": 15,
  "start": 32.32,
  "end": 36.74,
  "text": "Since then, humans have won just 4 more times, most recently in 2025."
 },
 {
  "i": 16,
  "start": 37.62,
  "end": 39.1,
  "text": "Humans: 5 wins."
 },
 {
  "i": 17,
  "start": 39.64,
  "end": 41.32,
  "text": "Horses: pretty much all the rest."
 },
 {
  "i": 18,
  "start": 42.42,
  "end": 43.04,
  "text": "Subscribe for more."
 }
]