[
 {
  "i": 0,
  "start": 0.0,
  "end": 1.62,
  "text": "The CIA built a spy cat."
 },
 {
  "i": 1,
  "start": 2.2,
  "end": 6.56,
  "text": "In the 1960s, they hid a microphone in its ear and an antenna in its fur."
 },
 {
  "i": 2,
  "start": 7.3,
  "end": 9.34,
  "text": "Reportedly, it cost millions of dollars."
 },
 {
  "i": 3,
  "start": 10.04,
  "end": 12.34,
  "text": "First mission: spy on two men in a park."
 },
 {
  "i": 4,
  "start": 12.98,
  "end": 13.96,
  "text": "The cat had other plans..."
 },
 {
  "i": 5,
  "start": 15.0,
  "end": 15.88,
  "text": "it kept getting distracted."
 },
 {
  "i": 6,
  "start": 15.88,
  "end": 17.02,
  "text": "And hungry."
 },
 {
  "i": 7,
  "start": 17.78,
  "end": 22.28,
  "text": "The CIA's memo: it \"would not lend itself\" to their \"highly specialized needs.\""
 },
 {
  "i": 8,
  "start": 23.08,
  "end": 23.56,
  "text": "Translation..."
 },
 {
  "i": 9,
  "start": 24.46,
  "end": 25.8,
  "text": "you can't train a cat."
 }
]