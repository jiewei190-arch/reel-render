[
 {
  "i": 0,
  "start": 0.0,
  "end": 2.52,
  "text": "In 1970, Oregon removed a dead whale..."
 },
 {
  "i": 1,
  "start": 2.52,
  "end": 4.56,
  "text": "with dynamite."
 },
 {
  "i": 2,
  "start": 4.96,
  "end": 8.06,
  "text": "A 45-foot sperm whale had washed up on the beach in Florence, Oregon."
 },
 {
  "i": 3,
  "start": 8.06,
  "end": 11.44,
  "text": "8 tons, rotting, and the state highway department got the job."
 },
 {
  "i": 4,
  "start": 11.82,
  "end": 14.74,
  "text": "The plan: blow it to bits, and let the seagulls clean up."
 },
 {
  "i": 5,
  "start": 14.96,
  "end": 17.14,
  "text": "So they used half a ton of dynamite."
 },
 {
  "i": 6,
  "start": 17.52,
  "end": 18.64,
  "text": "A crowd gathered to watch."
 },
 {
  "i": 7,
  "start": 18.64,
  "end": 20.12,
  "text": "3..."
 },
 {
  "i": 8,
  "start": 20.12,
  "end": 21.6,
  "text": "2..."
 },
 {
  "i": 9,
  "start": 21.6,
  "end": 23.08,
  "text": "1..."
 },
 {
  "i": 10,
  "start": 23.08,
  "end": 24.28,
  "text": "But here's the part..."
 },
 {
  "i": 11,
  "start": 24.68,
  "end": 25.7,
  "text": "the whale came back down."
 },
 {
  "i": 12,
  "start": 26.2,
  "end": 27.56,
  "text": "Chunks of blubber rained on the crowd."
 },
 {
  "i": 13,
  "start": 27.88,
  "end": 29.18,
  "text": "One crushed a brand-new car."
 },
 {
  "i": 14,
  "start": 29.18,
  "end": 30.9,
  "text": "Nobody was seriously hurt."
 },
 {
  "i": 15,
  "start": 31.4,
  "end": 32.14,
  "text": "The seagulls?"
 },
 {
  "i": 16,
  "start": 32.14,
  "end": 32.82,
  "text": "Scared off."
 },
 {
  "i": 17,
  "start": 33.44,
  "end": 34.32,
  "text": "And most of the whale..."
 },
 {
  "i": 18,
  "start": 34.32,
  "end": 35.7,
  "text": "was still there."
 },
 {
  "i": 19,
  "start": 35.7,
  "end": 40.82,
  "text": "50 years later, the town named a park after it: Exploding Whale Memorial Park."
 },
 {
  "i": 20,
  "start": 41.42,
  "end": 42.32,
  "text": "Subscribe for more."
 }
]