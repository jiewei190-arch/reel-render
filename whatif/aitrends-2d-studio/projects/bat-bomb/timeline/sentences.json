[
 {
  "i": 0,
  "start": 0.0,
  "end": 0.72,
  "text": "The U.S."
 },
 {
  "i": 1,
  "start": 0.72,
  "end": 2.02,
  "text": "military built a bomb out of bats."
 },
 {
  "i": 2,
  "start": 2.5,
  "end": 3.48,
  "text": "World War Two."
 },
 {
  "i": 3,
  "start": 3.48,
  "end": 4.44,
  "text": "Project X-Ray."
 },
 {
  "i": 4,
  "start": 4.44,
  "end": 7.86,
  "text": "The plan: a million bats, each carrying a tiny timed firebomb."
 },
 {
  "i": 5,
  "start": 7.86,
  "end": 8.98,
  "text": "Drop them over Japan."
 },
 {
  "i": 6,
  "start": 9.42,
  "end": 10.26,
  "text": "They'd roost in attics..."
 },
 {
  "i": 7,
  "start": 10.54,
  "end": 11.14,
  "text": "and then ignite."
 },
 {
  "i": 8,
  "start": 11.5,
  "end": 14.32,
  "text": "In May 1943, armed bats escaped during a test..."
 },
 {
  "i": 9,
  "start": 14.84,
  "end": 16.4,
  "text": "and set their own air base on fire."
 },
 {
  "i": 10,
  "start": 16.78,
  "end": 17.54,
  "text": "About two years."
 },
 {
  "i": 11,
  "start": 17.98,
  "end": 19.14,
  "text": "About 2 million dollars."
 },
 {
  "i": 12,
  "start": 19.14,
  "end": 20.58,
  "text": "It was canceled in 1944."
 },
 {
  "i": 13,
  "start": 21.1,
  "end": 22.52,
  "text": "The atomic bomb project took priority."
 },
 {
  "i": 14,
  "start": 23.0,
  "end": 24.52,
  "text": "The bat bomb was never used in combat."
 }
]