[
 {
  "i": 0,
  "start": 0.0,
  "end": 2.48,
  "text": "You drop a penny off the Empire State Building."
 },
 {
  "i": 1,
  "start": 3.04,
  "end": 4.56,
  "text": "Everyone says it would kill someone."
 },
 {
  "i": 2,
  "start": 5.4,
  "end": 6.06,
  "text": "It won't."
 },
 {
  "i": 3,
  "start": 6.46,
  "end": 7.0,
  "text": "Wait, how?"
 },
 {
  "i": 4,
  "start": 7.52,
  "end": 10.64,
  "text": "You see, a penny is flat and light, so it flutters, like a leaf."
 },
 {
  "i": 5,
  "start": 11.12,
  "end": 12.14,
  "text": "The air pushes back."
 },
 {
  "i": 6,
  "start": 12.66,
  "end": 14.98,
  "text": "After about fifty feet, it stops speeding up."
 },
 {
  "i": 7,
  "start": 15.48,
  "end": 16.0,
  "text": "Top speed?"
 },
 {
  "i": 8,
  "start": 16.64,
  "end": 18.16,
  "text": "About twenty-five miles an hour."
 },
 {
  "i": 9,
  "start": 18.66,
  "end": 21.98,
  "text": "With no air at all, it would hit two hundred and eight."
 },
 {
  "i": 10,
  "start": 21.98,
  "end": 23.08,
  "text": "Luckily, we have air."
 },
 {
  "i": 11,
  "start": 23.6,
  "end": 26.64,
  "text": "One physicist says it would feel like a flick on the forehead."
 },
 {
  "i": 12,
  "start": 26.64,
  "end": 28.66,
  "text": "And not even a hard one."
 },
 {
  "i": 13,
  "start": 29.08,
  "end": 30.6,
  "text": "Please don't test this on Tomas."
 },
 {
  "i": 14,
  "start": 31.3,
  "end": 32.22,
  "text": "Subscribe for more."
 }
]