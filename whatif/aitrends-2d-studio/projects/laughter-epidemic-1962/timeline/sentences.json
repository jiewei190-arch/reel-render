[
 {
  "i": 0,
  "start": 0.0,
  "end": 0.8,
  "text": "In 1962,"
 },
 {
  "i": 1,
  "start": 1.68,
  "end": 3.3,
  "text": "laughing shut down 14 schools."
 },
 {
  "i": 2,
  "start": 3.8,
  "end": 4.94,
  "text": "January thirtieth."
 },
 {
  "i": 3,
  "start": 4.94,
  "end": 7.9,
  "text": "A girls' boarding school in Kashasha, in what is now Tanzania."
 },
 {
  "i": 4,
  "start": 8.46,
  "end": 10.0,
  "text": "Three students started laughing..."
 },
 {
  "i": 5,
  "start": 10.52,
  "end": 12.14,
  "text": "and couldn't stop."
 },
 {
  "i": 6,
  "start": 12.44,
  "end": 15.36,
  "text": "It spread to 95 of the school's 159 students."
 },
 {
  "i": 7,
  "start": 15.76,
  "end": 17.04,
  "text": "Some attacks lasted hours."
 },
 {
  "i": 8,
  "start": 17.4,
  "end": 18.22,
  "text": "Some lasted days."
 },
 {
  "i": 9,
  "start": 18.6,
  "end": 20.08,
  "text": "In March, the school had to close."
 },
 {
  "i": 10,
  "start": 20.5,
  "end": 21.54,
  "text": "But it didn't stop there..."
 },
 {
  "i": 11,
  "start": 21.88,
  "end": 24.12,
  "text": "It spread to a village where several of the girls lived."
 },
 {
  "i": 12,
  "start": 24.56,
  "end": 26.32,
  "text": "217 people were affected."
 },
 {
  "i": 13,
  "start": 26.72,
  "end": 27.76,
  "text": "Then more villages."
 },
 {
  "i": 14,
  "start": 28.36,
  "end": 28.86,
  "text": "More schools."
 },
 {
  "i": 15,
  "start": 28.86,
  "end": 30.66,
  "text": "About 1,000 people in total."
 },
 {
  "i": 16,
  "start": 31.26,
  "end": 32.3,
  "text": "14 schools shut down."
 },
 {
  "i": 17,
  "start": 32.84,
  "end": 33.58,
  "text": "It wasn't funny."
 },
 {
  "i": 18,
  "start": 34.04,
  "end": 36.32,
  "text": "The laughing came with crying, fainting and pain."
 },
 {
  "i": 19,
  "start": 37.06,
  "end": 38.14,
  "text": "Doctors called it mass hysteria."
 },
 {
  "i": 20,
  "start": 38.76,
  "end": 40.92,
  "text": "It took about 18 months to finally fade away."
 }
]