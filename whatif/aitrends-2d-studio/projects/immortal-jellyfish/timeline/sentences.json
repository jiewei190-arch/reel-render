[
 {
  "i": 0,
  "start": 0.0,
  "end": 2.8,
  "text": "There's a jellyfish that refuses to die of OLD AGE."
 },
 {
  "i": 1,
  "start": 3.28,
  "end": 3.46,
  "text": "EVER."
 },
 {
  "i": 2,
  "start": 4.02,
  "end": 7.64,
  "text": "When the immortal jellyfish gets INJURED, or starts STARVING, it doesn't die."
 },
 {
  "i": 3,
  "start": 8.06,
  "end": 9.1,
  "text": "It hits the RESET BUTTON."
 },
 {
  "i": 4,
  "start": 9.64,
  "end": 13.76,
  "text": "It melts into a blob, sinks to the seafloor, and transforms back into a BABY."
 },
 {
  "i": 5,
  "start": 14.36,
  "end": 15.26,
  "text": "Then it grows up again."
 },
 {
  "i": 6,
  "start": 15.68,
  "end": 16.08,
  "text": "And again."
 },
 {
  "i": 7,
  "start": 16.48,
  "end": 16.9,
  "text": "And again."
 },
 {
  "i": 8,
  "start": 17.4,
  "end": 19.52,
  "text": "It's called TRANSDIFFERENTIATION."
 },
 {
  "i": 9,
  "start": 19.52,
  "end": 23.5,
  "text": "Imagine a butterfly turning back into a caterpillar every time life got hard."
 },
 {
  "i": 10,
  "start": 23.96,
  "end": 27.74,
  "text": "It's smaller than your pinky nail, and in theory, it can do this FOREVER."
 },
 {
  "i": 11,
  "start": 28.26,
  "end": 28.86,
  "text": "The catch?"
 },
 {
  "i": 12,
  "start": 29.34,
  "end": 30.38,
  "text": "Fish and turtles eat it."
 },
 {
  "i": 13,
  "start": 30.6,
  "end": 31.78,
  "text": "Immortal, but also..."
 },
 {
  "i": 14,
  "start": 32.74,
  "end": 33.04,
  "text": "LUNCH."
 },
 {
  "i": 15,
  "start": 33.8,
  "end": 34.84,
  "text": "It cheats old age..."
 },
 {
  "i": 16,
  "start": 35.88,
  "end": 37.68,
  "text": "and it doesn't even have a brain."
 },
 {
  "i": 17,
  "start": 38.38,
  "end": 39.34,
  "text": "Subscribe for more."
 }
]