[
 {
  "i": 0,
  "start": 0.0,
  "end": 2.04,
  "text": "A con man sold the Eiffel Tower."
 },
 {
  "i": 1,
  "start": 2.68,
  "end": 2.8,
  "text": "Twice."
 },
 {
  "i": 2,
  "start": 3.4,
  "end": 6.68,
  "text": "In 1925, Victor Lustig forged government letterhead."
 },
 {
  "i": 3,
  "start": 7.08,
  "end": 9.76,
  "text": "He told 6 scrap dealers the tower was being torn down."
 },
 {
  "i": 4,
  "start": 10.36,
  "end": 11.76,
  "text": "Andre Poisson paid, plus a bribe."
 },
 {
  "i": 5,
  "start": 12.36,
  "end": 13.16,
  "text": "Lustig fled the country."
 },
 {
  "i": 6,
  "start": 13.16,
  "end": 15.9,
  "text": "Poisson was too embarrassed to call the cops."
 },
 {
  "i": 7,
  "start": 16.52,
  "end": 19.0,
  "text": "So Lustig came back, and reportedly sold it..."
 },
 {
  "i": 8,
  "start": 19.68,
  "end": 20.04,
  "text": "AGAIN."
 },
 {
  "i": 9,
  "start": 20.56,
  "end": 21.66,
  "text": "He did end up in Alcatraz."
 },
 {
  "i": 10,
  "start": 22.26,
  "end": 22.92,
  "text": "Not for the tower."
 },
 {
  "i": 11,
  "start": 23.28,
  "end": 23.92,
  "text": "For counterfeiting."
 }
]