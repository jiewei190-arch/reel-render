[
 {
  "i": 0,
  "start": 0.0,
  "end": 3.1,
  "text": "This shrimp punches so fast, the water around it briefly boils."
 },
 {
  "i": 1,
  "start": 3.62,
  "end": 4.96,
  "text": "Meet the peacock mantis shrimp."
 },
 {
  "i": 2,
  "start": 5.22,
  "end": 7.72,
  "text": "Small, but it hits with thousands of times its body weight."
 },
 {
  "i": 3,
  "start": 8.08,
  "end": 10.42,
  "text": "Its club fires at 83 kilometers per hour."
 },
 {
  "i": 4,
  "start": 10.86,
  "end": 13.26,
  "text": "Scientists compare it to a bullet fired from a handgun."
 },
 {
  "i": 5,
  "start": 13.88,
  "end": 14.8,
  "text": "But here's the weird part."
 },
 {
  "i": 6,
  "start": 15.18,
  "end": 17.7,
  "text": "The strike is so fast, the pressure around it crashes."
 },
 {
  "i": 7,
  "start": 18.22,
  "end": 19.74,
  "text": "The water turns into vapor bubbles."
 },
 {
  "i": 8,
  "start": 20.14,
  "end": 22.42,
  "text": "Like boiling, but from pressure, not heat."
 },
 {
  "i": 9,
  "start": 22.92,
  "end": 24.2,
  "text": "Then the bubbles collapse..."
 },
 {
  "i": 10,
  "start": 24.8,
  "end": 26.24,
  "text": "and hit the target a second time."
 },
 {
  "i": 11,
  "start": 26.54,
  "end": 27.6,
  "text": "One punch, two hits."
 },
 {
  "i": 12,
  "start": 28.1,
  "end": 29.0,
  "text": "But it gets stranger."
 },
 {
  "i": 13,
  "start": 29.34,
  "end": 31.86,
  "text": "The collapsing bubbles give off a tiny flash of light."
 },
 {
  "i": 14,
  "start": 32.46,
  "end": 33.68,
  "text": "Snail shells crack like eggs."
 },
 {
  "i": 15,
  "start": 34.14,
  "end": 36.3,
  "text": "And the biggest ones can even break aquarium glass."
 },
 {
  "i": 16,
  "start": 36.96,
  "end": 38.6,
  "text": "So whatever you do..."
 },
 {
  "i": 17,
  "start": 39.2,
  "end": 40.3,
  "text": "never tap on its tank."
 },
 {
  "i": 18,
  "start": 41.1,
  "end": 41.7,
  "text": "Subscribe for more."
 }
]