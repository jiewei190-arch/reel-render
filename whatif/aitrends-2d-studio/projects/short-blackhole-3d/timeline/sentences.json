[
 {
  "i": 0,
  "start": 0.0,
  "end": 1.52,
  "text": "What if you fell into a black hole?"
 },
 {
  "i": 1,
  "start": 2.02,
  "end": 2.8,
  "text": "At first, nothing."
 },
 {
  "i": 2,
  "start": 3.4,
  "end": 4.1,
  "text": "You just fall."
 },
 {
  "i": 3,
  "start": 4.62,
  "end": 6.94,
  "text": "But gravity pulls your feet harder than your head."
 },
 {
  "i": 4,
  "start": 7.44,
  "end": 8.18,
  "text": "And it gets worse."
 },
 {
  "i": 5,
  "start": 8.84,
  "end": 12.3,
  "text": "Near a small black hole, that pull stretches you thin like spaghetti."
 },
 {
  "i": 6,
  "start": 13.38,
  "end": 14.92,
  "text": "Scientists really call it spaghettification."
 },
 {
  "i": 7,
  "start": 15.56,
  "end": 22.34,
  "text": "But fall into a giant one, millions of suns heavy, and you'd cross the point of no return without even noticing."
 },
 {
  "i": 8,
  "start": 22.94,
  "end": 23.7,
  "text": "Which one would you pick?"
 },
 {
  "i": 9,
  "start": 24.03,
  "end": 25.08,
  "text": "Subscribe for more."
 }
]