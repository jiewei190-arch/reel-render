  "end": 2.52,
  "text": "A cat was mayor of an Alaska town for 20 years."
 },
 {
  "i": 1,
  "start": 3.16,
  "end": 4.58,
  "text": "Talkeetna, 1997."
 },
 {
  "i": 2,
  "start": 5.68,
  "end": 7.26,
  "text": "Voters reportedly wrote in Stubbs."
 },
 {
  "i": 3,
  "start": 7.66,
  "end": 8.28,
  "text": "It was honorary..."
 },
 {
  "i": 4,
  "start": 9.14,
  "end": 10.42,
  "text": "but nobody told Stubbs."
 },
 {
  "i": 5,
  "start": 10.84,
  "end": 12.58,
  "text": "His office was the general store."
 },
 {
  "i": 6,
  "start": 13.06,
  "end": 14.78,
  "text": "He drank catnip water from a wine glass."
 },
 {
  "i": 7,
  "start": 15.6,
  "end": 17.7,
  "text": "30 to 40 tourists a day came to meet him."
 },
 {
  "i": 8,
  "start": 18.12,
  "end": 21.04,
  "text": "He survived a dog, a fryer, and a BB gun."
 },
 {
  "i": 9,
  "start": 21.58,
  "end": 23.72,
  "text": "The best politician Alaska ever had..."
 },
 {
  "i": 10,
  "start": 24.34,
  "end": 24.68,
  "text": "Allegedly."
 }
]