[
 {
  "i": 0,
  "start": 0.0,
  "end": 2.84,
  "text": "Pigeons steering missiles: a real World War 2 plan."
 },
 {
  "i": 1,
  "start": 3.96,
  "end": 3.96,
  "text": "1943."
 },
 {
  "i": 2,
  "start": 4.86,
  "end": 6.72,
  "text": "Psychologist Skinner's plan sounded like..."
 },
 {
  "i": 3,
  "start": 6.72,
  "end": 7.32,
  "text": "this."
 },
 {
  "i": 4,
  "start": 7.8,
  "end": 12.34,
  "text": "Three pigeons in tiny cockpits watched a screen of the ground ahead, and pecked at the target to steer."
 },
 {
  "i": 5,
  "start": 12.8,
  "end": 15.74,
  "text": "Show them two targets, and at least two birds would agree."
 },
 {
  "i": 6,
  "start": 16.36,
  "end": 16.74,
  "text": "Majority rules."
 },
 {
  "i": 7,
  "start": 17.34,
  "end": 20.72,
  "text": "One bird reportedly pecked more than 10,000 times in 45 minutes."
 },
 {
  "i": 8,
  "start": 21.12,
  "end": 21.36,
  "text": "Committed."
 },
 {
  "i": 9,
  "start": 21.7,
  "end": 24.08,
  "text": "Officials reportedly called it eccentric and impractical..."
 },
 {
  "i": 10,
  "start": 24.62,
  "end": 26.5,
  "text": "then chipped in 25,000 dollars anyway."
 },
 {
  "i": 11,
  "start": 27.3,
  "end": 28.36,
  "text": "But here's the part..."
 },
 {
  "i": 12,
  "start": 28.36,
  "end": 30.46,
  "text": "the pigeon demo reportedly worked."
 },
 {
  "i": 13,
  "start": 31.2,
  "end": 32.36,
  "text": "Officials stayed skeptical anyway."
 },
 {
  "i": 14,
  "start": 32.92,
  "end": 34.54,
  "text": "In 1944, they cancelled it."
 },
 {
  "i": 15,
  "start": 34.8,
  "end": 39.62,
  "text": "The Navy revived it as Project Orcon, until electronic guidance won in 1953."
 },
 {
  "i": 16,
  "start": 40.44,
  "end": 43.38,
  "text": "And six years later, Skinner's pigeons were still pecking."
 },
 {
  "i": 17,
  "start": 43.92,
  "end": 44.86,
  "text": "Subscribe for more."
 }
]