[
 {
  "i": 0,
  "start": 0.0,
  "end": 3.52,
  "text": "In 1997, the ocean made a noise nobody could explain."
 },
 {
  "i": 1,
  "start": 3.96,
  "end": 6.5,
  "text": "Underwater microphones were listening for volcanoes in the Pacific."
 },
 {
  "i": 2,
  "start": 6.88,
  "end": 7.9,
  "text": "Instead, they caught..."
 },
 {
  "i": 3,
  "start": 7.9,
  "end": 8.72,
  "text": "this."
 },
 {
  "i": 4,
  "start": 8.72,
  "end": 11.92,
  "text": "Ultra-low, extremely loud, and about a minute long."
 },
 {
  "i": 5,
  "start": 12.48,
  "end": 15.5,
  "text": "Sped up 16 times so humans could hear it, it went..."
 },
 {
  "i": 6,
  "start": 15.5,
  "end": 16.3,
  "text": "bloop."
 },
 {
  "i": 7,
  "start": 16.74,
  "end": 20.4,
  "text": "Sensors about 3,000 miles apart picked it up, from the remote South Pacific."
 },
 {
  "i": 8,
  "start": 20.98,
  "end": 24.24,
  "text": "Reportedly, it was far louder than a blue whale, the loudest known animal."
 },
 {
  "i": 9,
  "start": 24.74,
  "end": 28.64,
  "text": "So people guessed: a giant sea creature nobody had ever seen."
 },
 {
  "i": 10,
  "start": 29.2,
  "end": 30.42,
  "text": "But here's the part..."
 },
 {
  "i": 11,
  "start": 30.86,
  "end": 32.86,
  "text": "in 2005, NOAA found the source."
 },
 {
  "i": 12,
  "start": 33.46,
  "end": 34.12,
  "text": "Not a sea monster."
 },
 {
  "i": 13,
  "start": 34.52,
  "end": 35.34,
  "text": "An icequake."
 },
 {
  "i": 14,
  "start": 35.34,
  "end": 38.94,
  "text": "An iceberg, cracking and breaking away from an Antarctic glacier."
 },
 {
  "i": 15,
  "start": 39.56,
  "end": 40.02,
  "text": "The monster..."
 },
 {
  "i": 16,
  "start": 40.02,
  "end": 41.58,
  "text": "was ice."
 },
 {
  "i": 17,
  "start": 42.38,
  "end": 43.32,
  "text": "Subscribe for more."
 }
]