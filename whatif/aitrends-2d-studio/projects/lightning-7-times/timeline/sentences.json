  "text": "This man was struck by lightning 7 times."
 },
 {
  "i": 1,
  "start": 2.62,
  "end": 3.08,
  "text": "Roy Sullivan."
 },
 {
  "i": 2,
  "start": 3.6,
  "end": 5.02,
  "text": "A park ranger in Shenandoah."
 },
 {
  "i": 3,
  "start": 5.4,
  "end": 7.54,
  "text": "From 1942 to 1977."
 },
 {
  "i": 4,
  "start": 8.06,
  "end": 10.14,
  "text": "Once, it knocked him out while driving..."
 },
 {
  "i": 5,
  "start": 10.74,
  "end": 11.9,
  "text": "and the truck kept rolling."
 },
 {
  "i": 6,
  "start": 12.42,
  "end": 12.64,
  "text": "Fishing."
 },
 {
  "i": 7,
  "start": 13.32,
  "end": 13.94,
  "text": "His front yard."
 },
 {
  "i": 8,
  "start": 14.48,
  "end": 15.5,
  "text": "It set his hair on fire."
 },
 {
  "i": 9,
  "start": 16.02,
  "end": 16.5,
  "text": "The odds?"
 },
 {
  "i": 10,
  "start": 16.88,
  "end": 19.92,
  "text": "By one estimate, about 1 in 10 septillion."
 },
 {
  "i": 11,
  "start": 20.42,
  "end": 22.02,
  "text": "He said a storm cloud chased him."
 },
 {
  "i": 12,
  "start": 22.44,
  "end": 24.16,
  "text": "He still holds the Guinness World Record."
 }
