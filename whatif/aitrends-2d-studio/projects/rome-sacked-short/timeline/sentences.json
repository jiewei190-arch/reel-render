[
 {
  "i": 0,
  "start": 0.15,
  "end": 1.735,
  "text": "August 24th, 410."
 },
 {
  "i": 1,
  "start": 2.255,
  "end": 5.355,
  "text": "Nobody has broken into Rome in almost eight hundred years."
 },
 {
  "i": 2,
  "start": 5.795,
  "end": 7.455,
  "text": "So this guard is very relaxed."
 },
 {
  "i": 3,
  "start": 7.935,
  "end": 9.375,
  "text": "Then the Salarian Gate opens."
 },
 {
  "i": 4,
  "start": 10.055,
  "end": 11.155,
  "text": "Some say, from the inside."
 },
 {
  "i": 5,
  "start": 11.695,
  "end": 12.715,
  "text": "The Visigoths are in."
 },
 {
  "i": 6,
  "start": 13.115,
  "end": 15.475,
  "text": "For three days, the Eternal City gets looted."
 },
 {
  "i": 7,
  "start": 15.955,
  "end": 19.795,
  "text": "Two years earlier, Rome paid them off with three thousand pounds of pepper."
 },
 {
  "i": 8,
  "start": 20.275,
  "end": 21.915,
  "text": "This time, pepper won't fix it."
 },
 {
  "i": 9,
  "start": 22.315,
  "end": 22.935,
  "text": "And the emperor?"
 },
 {
  "i": 10,
  "start": 23.515,
  "end": 24.595,
  "text": "He's not even in Rome."
 },
 {
  "i": 11,
  "start": 25.115,
  "end": 26.075,
  "text": "He's in Ravenna."
 },
 {
  "i": 12,
  "start": 26.515,
  "end": 28.375,
  "text": "Told that Rome has perished, he panics."
 },
 {
  "i": 13,
  "start": 28.855,
  "end": 29.595,
  "text": "About his chicken."
 },
 {
  "i": 14,
  "start": 30.235,
  "end": 30.795,
  "text": "Named Roma."
 },
 {
  "i": 15,
  "start": 31.375,
  "end": 32.375,
  "text": "Or so the story goes."
 },
 {
  "i": 16,
  "start": 33.055,
  "end": 35.615,
  "text": "How did the greatest empire on Earth end up here?"
 },
 {
  "i": 17,
  "start": 36.135,
  "end": 37.315,
  "text": "Subscribe to find out."
 }
]