[
 {
  "i": 0,
  "start": 0.0,
  "end": 4.44,
  "text": "In 1977, a telescope caught a signal so weird someone wrote \"Wow!\""
 },
 {
  "i": 1,
  "start": 5.12,
  "end": 8.1,
  "text": "Ohio's Big Ear radio telescope was listening for alien signals."
 },
 {
  "i": 2,
  "start": 8.56,
  "end": 11.9,
  "text": "Its printout was code: numbers meant weak, letters meant strong."
 },
 {
  "i": 3,
  "start": 12.36,
  "end": 16.66,
  "text": "Then, on August 15, it printed: 6, E, Q, U, J, 5."
 },
 {
  "i": 4,
  "start": 16.66,
  "end": 19.36,
  "text": "That U was about 30 standard deviations above the noise."
 },
 {
  "i": 5,
  "start": 20.02,
  "end": 22.5,
  "text": "Days later, Jerry Ehman circled it and wrote: \"Wow!\""
 },
 {
  "i": 6,
  "start": 22.94,
  "end": 26.92,
  "text": "It lasted 72 seconds, exactly as long as Big Ear could watch one spot."
 },
 {
  "i": 7,
  "start": 26.92,
  "end": 28.54,
  "text": "They listened again for decades."
 },
 {
  "i": 8,
  "start": 29.2,
  "end": 29.42,
  "text": "Nothing."
 },
 {
  "i": 9,
  "start": 30.1,
  "end": 30.64,
  "text": "Comets got blamed."
 },
 {
  "i": 10,
  "start": 31.2,
  "end": 32.08,
  "text": "Astronomers said nope."
 },
 {
  "i": 11,
  "start": 32.68,
  "end": 33.72,
  "text": "But here's the part..."
 },
 {
  "i": 12,
  "start": 34.18,
  "end": 37.92,
  "text": "a 2024 study says a cold hydrogen cloud may have suddenly flared."
 },
 {
  "i": 13,
  "start": 38.44,
  "end": 39.06,
  "text": "Still unconfirmed."
 },
 {
  "i": 14,
  "start": 39.72,
  "end": 41.5,
  "text": "But in 2012, someone replied anyway..."
 },
 {
  "i": 15,
  "start": 42.2,
  "end": 43.4,
  "text": "with over 10,000 tweets."
 },
 {
  "i": 16,
  "start": 44.16,
  "end": 45.04,
  "text": "Subscribe for more."
 }
]