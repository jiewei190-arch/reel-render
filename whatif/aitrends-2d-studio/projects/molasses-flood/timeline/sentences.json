[
 {
  "i": 0,
  "start": 0.0,
  "end": 1.74,
  "text": "You've heard the phrase slow as molasses."
 },
 {
  "i": 1,
  "start": 2.58,
  "end": 5.8,
  "text": "Nobody mentions the time molasses killed 21 people."
 },
 {
  "i": 2,
  "start": 6.76,
  "end": 8.92,
  "text": "January 15th, 1919, Boston."
 },
 {
  "i": 3,
  "start": 9.7,
  "end": 13.12,
  "text": "A 50-foot steel tank holding 2.3 million gallons of molasses"
 },
 {
  "i": 4,
  "start": 14.28,
  "end": 14.72,
  "text": "rips open."
 },
 {
  "i": 5,
  "start": 15.36,
  "end": 19.04,
  "text": "What comes out is a 15-foot wave moving 35 miles per hour."
 },
 {
  "i": 6,
  "start": 19.94,
  "end": 21.4,
  "text": "That's faster than Usain Bolt."
 },
 {
  "i": 7,
  "start": 21.94,
  "end": 25.48,
  "text": "It flattens buildings and twists the elevated train tracks like spaghetti."
 },
 {
  "i": 8,
  "start": 26.22,
  "end": 26.98,
  "text": "21 people dead."
 },
 {
  "i": 9,
  "start": 27.44,
  "end": 28.32,
  "text": "150 injured."
 },
 {
  "i": 10,
  "start": 29.28,
  "end": 31.26,
  "text": "The company blamed anarchist bombers."
 },
 {
  "i": 11,
  "start": 32.08,
  "end": 33.28,
  "text": "The court said: no."
 },
 {
  "i": 12,
  "start": 34.18,
  "end": 35.64,
  "text": "You just built a garbage tank."
 },
 {
  "i": 13,
  "start": 36.34,
  "end": 41.16,
  "text": "And on hot days, locals swore the neighborhood smelled like molasses for decades."
 },
 {
  "i": 14,
  "start": 42.32,
  "end": 43.06,
  "text": "Slow as molasses?"
 },
 {
  "i": 15,
  "start": 44.2,
  "end": 45.74,
  "text": "Biggest lie, in history."
 },
 {
  "i": 16,
  "start": 46.5,
  "end": 47.44,
  "text": "Subscribe for more."
 }
]