[
 {
  "i": 0,
  "start": 0.05,
  "end": 0.83,
  "text": "Mrs."
 },
 {
  "i": 1,
  "start": 1.99,
  "end": 4.95,
  "text": "Hale pays you fifty dollars to watch the house tonight."
 },
 {
  "i": 2,
  "start": 5.95,
  "end": 7.33,
  "text": "On the fridge, she left a note."
 },
 {
  "i": 3,
  "start": 8.23,
  "end": 8.89,
  "text": "Four rules."
 },
 {
  "i": 4,
  "start": 10.87,
  "end": 11.33,
  "text": "Rule one."
 },
 {
  "i": 5,
  "start": 12.29,
  "end": 13.87,
  "text": "Never open the basement door."
 },
 {
  "i": 6,
  "start": 14.89,
  "end": 15.75,
  "text": "Whatever you hear."
 },
 {
  "i": 7,
  "start": 17.69,
  "end": 18.19,
  "text": "Rule two."
 },
 {
  "i": 8,
  "start": 19.19,
  "end": 21.79,
  "text": "If the hallway light goes off, don't touch the switch."
 },
 {
  "i": 9,
  "start": 22.85,
  "end": 23.41,
  "text": "Just wait."
 },
 {
  "i": 10,
  "start": 24.15,
  "end": 26.01,
  "text": "Rule three."
 },
 {
  "i": 11,
  "start": 27.05,
  "end": 28.39,
  "text": "Keep the baby monitor on."
 },
 {
  "i": 12,
  "start": 29.17,
  "end": 29.87,
  "text": "All night."
 },
 {
  "i": 13,
  "start": 31.85,
  "end": 32.59,
  "text": "Ten past eleven."
 },
 {
  "i": 14,
  "start": 33.61,
  "end": 35.41,
  "text": "Something knocks on the basement door."
 },
 {
  "i": 15,
  "start": 36.35,
  "end": 36.99,
  "text": "Three times."
 },
 {
  "i": 16,
  "start": 37.95,
  "end": 38.69,
  "text": "You don't move."
 },
 {
  "i": 17,
  "start": 39.69,
  "end": 40.39,
  "text": "Eleven forty."
 },
 {
  "i": 18,
  "start": 41.43,
  "end": 42.75,
  "text": "The hallway light goes off."
 },
 {
  "i": 19,
  "start": 43.61,
  "end": 44.15,
  "text": "You wait."
 },
 {
  "i": 20,
  "start": 45.05,
  "end": 46.15,
  "text": "It comes back on."
 },
 {
  "i": 21,
  "start": 47.09,
  "end": 48.37,
  "text": "Then the monitor crackles."
 },
 {
  "i": 22,
  "start": 48.37,
  "end": 52.07,
  "text": "Can you come tuck me in?"
 },
 {
  "i": 23,
  "start": 52.07,
  "end": 55.47,
  "text": "You're halfway up the stairs when you turn the note over."
 },
 {
  "i": 24,
  "start": 57.21,
  "end": 57.61,
  "text": "Rule four."
 },
 {
  "i": 25,
  "start": 58.67,
  "end": 59.99,
  "text": "There are no kids in this house."
 },
 {
  "i": 26,
  "start": 59.99,
  "end": 60.04,
  "text": "I can see you on the stairs."
 }
]