[
 {
  "i": 0,
  "start": 0.08,
  "end": 2.24,
  "text": "Three a.m."
 },
 {
  "i": 1,
  "start": 2.24,
  "end": 4.66,
  "text": "Every phone on your street screams at once."
 },
 {
  "i": 2,
  "start": 5.18,
  "end": 6.1,
  "text": "Emergency alert."
 },
 {
  "i": 3,
  "start": 6.1,
  "end": 7.76,
  "text": "Three rules."
 },
 {
  "i": 4,
  "start": 9.82,
  "end": 11.2,
  "text": "Rule one."
 },
 {
  "i": 5,
  "start": 11.2,
  "end": 11.92,
  "text": "Stay inside."
 },
 {
  "i": 6,
  "start": 13.04,
  "end": 13.98,
  "text": "Cover every window."
 },
 {
  "i": 7,
  "start": 15.82,
  "end": 17.4,
  "text": "Rule two."
 },
 {
  "i": 8,
  "start": 17.4,
  "end": 19.64,
  "text": "If it looks like morning outside, it isn't."
 },
 {
  "i": 9,
  "start": 20.56,
  "end": 21.06,
  "text": "Don't look."
 },
 {
  "i": 10,
  "start": 22.9,
  "end": 24.48,
  "text": "Rule three."
 },
 {
  "i": 11,
  "start": 24.48,
  "end": 27.56,
  "text": "If someone knocks, count your family before you answer."
 },
 {
  "i": 12,
  "start": 28.96,
  "end": 31.2,
  "text": "You tape cardboard over the windows."
 },
 {
  "i": 13,
  "start": 32.22,
  "end": 34.46,
  "text": "Your little brother falls asleep on the couch."
 },
 {
  "i": 14,
  "start": 34.46,
  "end": 37.2,
  "text": "Four a.m."
 },
 {
  "i": 15,
  "start": 37.2,
  "end": 38.74,
  "text": "Light pours in under the front door."
 },
 {
  "i": 16,
  "start": 39.88,
  "end": 40.88,
  "text": "White and warm, like sunrise."
 },
 {
  "i": 17,
  "start": 42.12,
  "end": 42.74,
  "text": "Then a knock."
 },
 {
  "i": 18,
  "start": 43.92,
  "end": 44.34,
  "text": "Sweetheart?"
 },
 {
  "i": 19,
  "start": 44.52,
  "end": 45.04,
  "text": "It's Mom."
 },
 {
  "i": 20,
  "start": 45.6,
  "end": 46.32,
  "text": "The sun's up."
 },
 {
  "i": 21,
  "start": 46.46,
  "end": 47.04,
  "text": "Come and see."
 },
 {
  "i": 22,
  "start": 48.28,
  "end": 49.36,
  "text": "Mom is asleep upstairs."
 },
 {
  "i": 23,
  "start": 50.38,
  "end": 51.22,
  "text": "You're almost sure."
 },
 {
  "i": 24,
  "start": 52.24,
  "end": 53.76,
  "text": "So you count."
 },
 {
  "i": 25,
  "start": 54.84,
  "end": 55.52,
  "text": "Mom, upstairs."
 },
 {
  "i": 26,
  "start": 56.76,
  "end": 57.32,
  "text": "Dad, upstairs."
 },
 {
  "i": 27,
  "start": 58.46,
  "end": 59.58,
  "text": "Your brother, on the couch."
 },
 {
  "i": 28,
  "start": 60.58,
  "end": 60.82,
  "text": "You."
 },
 {
  "i": 29,
  "start": 60.82,
  "end": 62.28,
  "text": "Four."
 },
 {
  "i": 30,
  "start": 62.28,
  "end": 63.74,
  "text": "Five."
 }
]