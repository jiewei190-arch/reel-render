  "end": 2.16,
  "text": "Coca-Cola had cocaine in it."
 },
 {
  "i": 1,
  "start": 2.4,
  "end": 7.02,
  "text": "In 1886, pharmacist John Pemberton brewed it with coca leaves, and sold it as medicine."
 },
 {
  "i": 2,
  "start": 7.6,
  "end": 10.06,
  "text": "Around 1903, the cocaine came out."
 },
 {
  "i": 3,
  "start": 10.54,
  "end": 12.64,
  "text": "But Coke reportedly still uses the leaf."
 },
 {
  "i": 4,
  "start": 13.24,
  "end": 15.2,
  "text": "A New Jersey company strips the cocaine out."
 },
 {
  "i": 5,
  "start": 15.66,
  "end": 16.4,
  "text": "Coke keeps the flavor."
 },
 {
  "i": 6,
  "start": 17.0,
  "end": 17.92,
  "text": "Still made with coca."
 },
 {
  "i": 7,
  "start": 18.38,
  "end": 18.66,
  "text": "Just..."
 },
 {
  "i": 8,
  "start": 18.66,
  "end": 20.34,
  "text": "the legal part."
 },
 {
  "i": 9,
  "start": 20.92,
  "end": 21.92,
  "text": "Subscribe for more."
 }
]