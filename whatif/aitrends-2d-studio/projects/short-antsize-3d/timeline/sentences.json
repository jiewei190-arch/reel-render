 },
 {
  "i": 10,
  "start": 21.64,
  "end": 23.44,
  "text": "For you, water is scarier than gravity."
 },
 {
  "i": 11,
  "start": 23.96,
  "end": 24.8,
  "text": "Would you risk it?"
 },
 {
  "i": 12,
