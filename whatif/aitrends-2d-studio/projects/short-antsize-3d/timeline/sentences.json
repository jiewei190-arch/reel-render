  "end": 1.76,
  "text": "What if you shrank to the size of an ant?"
 },
 {
  "i": 1,
  "start": 2.46,
  "end": 3.38,
  "text": "Grass becomes a forest."
 },
 {
  "i": 2,
  "start": 3.9,
  "end": 5.76,
  "text": "Then a gust throws you off a skyscraper."
 },
 {
  "i": 3,
  "start": 6.34,
