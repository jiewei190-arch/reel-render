[
 {
  "i": 0,
  "start": 0.0,
  "end": 1.18,
  "text": "A pilot flew to Ireland..."
 },
 {
  "i": 1,
  "start": 1.18,
  "end": 3.46,
  "text": "and said he was heading for California."
 },
 {
  "i": 2,
  "start": 4.3,
  "end": 4.74,
  "text": "1938."
 },
 {
  "i": 3,
  "start": 5.48,
  "end": 7.48,
  "text": "Douglas Corrigan wanted to fly across the Atlantic."
 },
 {
  "i": 4,
  "start": 8.16,
  "end": 8.78,
  "text": "Officials said no."
 },
 {
  "i": 5,
  "start": 9.14,
  "end": 10.9,
  "text": "His plane was a nine-year-old Curtiss Robin."
 },
 {
  "i": 6,
  "start": 11.4,
  "end": 11.84,
  "text": "No radio."
 },
 {
  "i": 7,
  "start": 12.52,
  "end": 14.9,
  "text": "Extra fuel tanks reportedly blocked his view straight ahead."
 },
 {
  "i": 8,
  "start": 15.4,
  "end": 18.6,
  "text": "So on July 17th, he filed a flight plan to California."
 },
 {
  "i": 9,
  "start": 19.2,
  "end": 20.28,
  "text": "He took off from New York."
 },
 {
  "i": 10,
  "start": 20.72,
  "end": 21.52,
  "text": "California is west."
 },
 {
  "i": 11,
  "start": 21.92,
  "end": 22.5,
  "text": "He went east."
 },
 {
  "i": 12,
  "start": 22.5,
  "end": 25.9,
  "text": "28 hours later, he landed in Dublin, Ireland."
 },
 {
  "i": 13,
  "start": 26.6,
  "end": 29.38,
  "text": "He said he got lost in the clouds and misread his compass."
 },
 {
  "i": 14,
  "start": 30.42,
  "end": 31.52,
  "text": "But here's the part..."
 },
 {
  "i": 15,
  "start": 31.84,
  "end": 34.38,
  "text": "his license was suspended only until his ship got home."
 },
 {
  "i": 16,
  "start": 35.0,
  "end": 36.36,
  "text": "New York threw him a ticker-tape parade."
 },
 {
  "i": 17,
  "start": 36.86,
  "end": 38.64,
  "text": "And publicly, he never admitted a thing."
 },
 {
  "i": 18,
  "start": 39.38,
  "end": 40.32,
  "text": "Subscribe for more."
 }
]