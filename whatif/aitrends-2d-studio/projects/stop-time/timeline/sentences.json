[
 {
  "i": 0,
  "start": 0.0,
  "end": 0.8,
  "text": "Tuesday."
 },
 {
  "i": 1,
  "start": 1.68,
  "end": 2.0,
  "text": "Breakfast."
 },
 {
  "i": 2,
  "start": 3.02,
  "end": 7.72,
  "text": "Mina knocks her orange juice off the table, and without thinking, you snap your fingers."
 },
 {
  "i": 3,
  "start": 8.62,
  "end": 9.64,
  "text": "Everything goes black."
 },
 {
  "i": 4,
  "start": 10.8,
  "end": 10.8,
  "text": "Silent."
 },
 {
  "i": 5,
  "start": 11.54,
  "end": 13.12,
  "text": "You can't even see your own hand."
 },
 {
  "i": 6,
  "start": 13.8,
  "end": 14.66,
  "text": "You count to ten."
 },
 {
  "i": 7,
  "start": 15.44,
  "end": 19.12,
  "text": "Then the light comes back, the juice lands, and Mina's socks are orange."
 },
 {
  "i": 8,
  "start": 20.04,
  "end": 21.92,
  "text": "Nobody knows why your snap does this."
 },
 {
  "i": 9,
  "start": 22.64,
  "end": 23.36,
  "text": "Not even you."
 },
 {
  "i": 10,
  "start": 24.12,
  "end": 25.74,
  "text": "Let's see what ten seconds can do."
 },
 {
  "i": 11,
  "start": 27.98,
  "end": 29.2,
  "text": "You tell Dev and Mina."
 },
 {
  "i": 12,
  "start": 29.84,
  "end": 30.82,
  "text": "Dev starts filming."
 },
 {
  "i": 13,
  "start": 31.76,
  "end": 32.92,
  "text": "Mina starts her stopwatch."
 },
 {
  "i": 14,
  "start": 33.78,
  "end": 34.92,
  "text": "To them, nothing happened."
 },
 {
  "i": 15,
  "start": 35.66,
  "end": 39.08,
  "text": "One moment you were in your chair, the next, you were standing in a puddle."
 },
 {
  "i": 16,
  "start": 39.78,
  "end": 40.76,
  "text": "But why was it dark?"
 },
 {
  "i": 17,
  "start": 41.52,
  "end": 42.4,
  "text": "The lights were on."
 },
 {
  "i": 18,
  "start": 43.12,
  "end": 43.94,
  "text": "The sun was out."
 },
 {
  "i": 19,
  "start": 45.54,
  "end": 47.2,
  "text": "Light is the fastest thing there is."
 },
 {
  "i": 20,
  "start": 47.84,
  "end": 50.7,
  "text": "About three hundred thousand kilometres every second."
 },
 {
  "i": 21,
  "start": 51.56,
  "end": 52.92,
  "text": "Even so, it has to travel."
 },
 {
  "i": 22,
  "start": 53.78,
  "end": 57.52,
  "text": "Sunlight takes about eight minutes and twenty seconds to get here from the Sun."
 },
 {
  "i": 23,
  "start": 58.26,
  "end": 62.36,
  "text": "You see when light lands inside your eye, on the back wall, called the retina."
 },
 {
  "i": 24,
  "start": 63.08,
  "end": 67.48,
  "text": "Freeze the light, and every bit of it hangs in the air, between the window and your eyes."
 },
 {
  "i": 25,
  "start": 68.38,
  "end": 69.08,
  "text": "None of it arrives."
 },
 {
  "i": 26,
  "start": 69.84,
  "end": 71.72,
  "text": "So frozen time wouldn't look frozen."
 },
 {
  "i": 27,
  "start": 72.38,
  "end": 73.9,
  "text": "It would look like nothing at all."
 },
 {
  "i": 28,
  "start": 75.44,
  "end": 76.08,
  "text": "Second snap."
 },
 {
  "i": 29,
  "start": 76.94,
  "end": 78.6,
  "text": "This time, the snap seems to have learned."
 },
 {
  "i": 30,
  "start": 79.3,
  "end": 80.32,
  "text": "The light keeps moving."
 },
 {
  "i": 31,
  "start": 81.06,
  "end": 81.94,
  "text": "And it's beautiful."
 },
 {
  "i": 32,
  "start": 82.94,
  "end": 84.44,
  "text": "Juice drops hang like glass beads."
 },
 {
  "i": 33,
  "start": 85.38,
  "end": 87.38,
  "text": "Dev is frozen mid-sneeze."
 },
 {
  "i": 34,
  "start": 87.38,
  "end": 89.18,
  "text": "Biscuit is mid-leap, aiming at the butter."
 },
 {
  "i": 35,
  "start": 89.96,
  "end": 92.32,
  "text": "You step forward, and walk into something soft."
 },
 {
  "i": 36,
  "start": 93.04,
  "end": 94.4,
  "text": "Like a mattress you can't see."
 },
 {
  "i": 37,
  "start": 95.04,
  "end": 95.94,
  "text": "You try to gasp."
 },
 {
  "i": 38,
  "start": 96.84,
  "end": 97.76,
  "text": "Nothing comes in."
 },
 {
  "i": 39,
  "start": 99.06,
  "end": 101.72,
  "text": "Air looks like nothing, but it's packed with molecules."
 },
 {
  "i": 40,
  "start": 102.58,
  "end": 108.68,
  "text": "In one cubic centimetre, about the size of a fingertip, there are around twenty-five billion billion."
 },
 {
  "i": 41,
  "start": 109.26,
  "end": 110.56,
  "text": "And they never sit still."
 },
 {
  "i": 42,
  "start": 111.3,
  "end": 117.62,
  "text": "At room temperature, they zoom around at roughly five hundred metres a second, faster than a jet airliner."
 },
 {
  "i": 43,
  "start": 118.4,
  "end": 119.9,
  "text": "All that bumping is air pressure."
 },
 {
  "i": 44,
  "start": 120.62,
  "end": 126.38,
  "text": "When you breathe in, your diaphragm makes room in your chest, and the air outside pushes itself in."
 },
 {
  "i": 45,
  "start": 127.42,
  "end": 129.0,
  "text": "Frozen molecules can't push anything."
 },
 {
  "i": 46,
  "start": 129.0,
  "end": 131.3,
  "text": "So nothing flows into your lungs."
 },
 {
  "i": 47,
  "start": 132.08,
  "end": 132.8,
  "text": "And air is heavy."
 },
 {
  "i": 48,
  "start": 133.62,
  "end": 136.88,
  "text": "The air in a small kitchen weighs about as much as you do."
 },
 {
  "i": 49,
  "start": 137.56,
  "end": 142.14,
  "text": "If every molecule stayed stuck, you couldn't open a door, or even move your hand."
 },
 {
  "i": 50,
  "start": 142.14,
  "end": 143.96,
  "text": "You'd be a statue too."
 },
 {
  "i": 51,
  "start": 144.78,
  "end": 147.3,
  "text": "Luckily, ten seconds of holding your breath is fine."
 },
 {
  "i": 52,
  "start": 148.04,
  "end": 150.74,
  "text": "You count, cheeks puffed, until the world starts again."
 },
 {
  "i": 53,
  "start": 151.88,
  "end": 152.84,
  "text": "Third snap."
 },
 {
  "i": 54,
  "start": 153.66,
  "end": 154.84,
  "text": "Now the air around you moves."
 },
 {
  "i": 55,
  "start": 155.6,
  "end": 156.26,
  "text": "You can breathe."
 },
 {
  "i": 56,
  "start": 157.1,
  "end": 157.74,
  "text": "You can walk."
 },
 {
  "i": 57,
  "start": 158.64,
  "end": 162.16,
  "text": "Biscuit is still frozen mid-leap, paws out, inches from the butter."
 },
 {
  "i": 58,
  "start": 162.9,
  "end": 166.2,
  "text": "You gently lift her out of the air, and set her down on the floor."
 },
 {
  "i": 59,
  "start": 167.06,
  "end": 167.56,
  "text": "Butter saved."
 },
 {
  "i": 60,
  "start": 168.46,
  "end": 169.24,
  "text": "Time restarts."
 },
 {
  "i": 61,
  "start": 170.0,
  "end": 175.42,
  "text": "And Biscuit shoots sideways across the tiles like a furry hockey puck, straight into the bin."
 },
 {
  "i": 62,
  "start": 177.04,
  "end": 183.04,
  "text": "Newton's first law: a moving thing keeps moving the same way, unless a force pushes or pulls it."
 },
 {
  "i": 63,
  "start": 183.68,
  "end": 184.98,
  "text": "Moving things carry momentum."
 },
 {
  "i": 64,
  "start": 185.8,
  "end": 187.3,
  "text": "It's their mass times their speed."
 },
 {
  "i": 65,
  "start": 188.02,
  "end": 190.34,
  "text": "A heavier or faster thing is harder to stop."
 },
 {
  "i": 66,
  "start": 191.16,
  "end": 193.28,
  "text": "Picking Biscuit up didn't take her speed away."
 },
 {
  "i": 67,
  "start": 194.08,
  "end": 196.38,
  "text": "In our story, freezing doesn't delete motion."
 },
 {
  "i": 68,
  "start": 197.08,
  "end": 198.12,
  "text": "It saves it for later."
 },
 {
  "i": 69,
  "start": 198.96,
  "end": 202.02,
  "text": "To stop a moving thing, you have to push against its motion."
 },
 {
  "i": 70,
  "start": 202.74,
  "end": 203.9,
  "text": "Like a goalkeeper's gloves."
 },
 {
  "i": 71,
  "start": 204.74,
  "end": 207.94,
  "text": "Biscuit climbs out of the bin and gives you a long, cold look."
 },
 {
  "i": 72,
  "start": 209.58,
  "end": 210.18,
  "text": "Fourth snap."
 },
 {
  "i": 73,
  "start": 210.18,
  "end": 211.94,
  "text": "Ten quiet seconds."
 },
 {
  "i": 74,
  "start": 212.66,
  "end": 213.72,
  "text": "Then time restarts."
 },
 {
  "i": 75,
  "start": 214.38,
  "end": 215.98,
  "text": "You glance up at the kitchen clock."
 },
 {
  "i": 76,
  "start": 216.56,
  "end": 218.04,
  "text": "The second hand doesn't move."
 },
 {
  "i": 77,
  "start": 218.74,
  "end": 219.58,
  "text": "Your heart jumps."
 },
 {
  "i": 78,
  "start": 220.38,
  "end": 221.12,
  "text": "Is it still frozen?"
 },
 {
  "i": 79,
  "start": 222.08,
  "end": 222.66,
  "text": "Then it ticks."
 },
 {
  "i": 80,
  "start": 223.42,
  "end": 224.24,
  "text": "And ticks again."
 },
 {
  "i": 81,
  "start": 224.24,
  "end": 226.76,
  "text": "Normal."
 },
 {
  "i": 82,
  "start": 226.76,
  "end": 228.12,
  "text": "That has a real name."
 },
 {
  "i": 83,
  "start": 228.84,
  "end": 229.88,
  "text": "The stopped clock illusion."
 },
 {
  "i": 84,
  "start": 230.74,
  "end": 231.7,
  "text": "Your eyes don't glide."
 },
 {
  "i": 85,
  "start": 232.5,
  "end": 234.3,
  "text": "They jump, about three times a second."
 },
 {
  "i": 86,
  "start": 235.1,
  "end": 236.66,
  "text": "During each jump, the view is a blur."
 },
 {
  "i": 87,
  "start": 237.44,
  "end": 238.72,
  "text": "Your brain hides the blur."
 },
 {
  "i": 88,
  "start": 239.42,
  "end": 241.92,
  "text": "It fills the gap with whatever your eyes land on."
 },
 {
  "i": 89,
  "start": 242.52,
  "end": 245.06,
  "text": "So the first tick you see seems to last too long."
 },
 {
  "i": 90,
  "start": 245.82,
  "end": 253.24,
  "text": "In 2001, scientists in London showed the brain stretches that moment back in time, to just before your eyes moved."
 },
 {
  "i": 91,
  "start": 254.02,
  "end": 255.36,
  "text": "Everyone has frozen a clock."
 },
 {
  "i": 92,
  "start": 256.3,
  "end": 257.3,
  "text": "Just for a split second."
 },
 {
  "i": 93,
  "start": 259.0,
  "end": 262.56,
  "text": "That evening, Mina checks your big black watch against the oven clock."
 },
 {
  "i": 94,
  "start": 263.44,
  "end": 265.48,
  "text": "\"Yours is forty seconds fast,\" she says."
 },
 {
  "i": 95,
  "start": 266.26,
  "end": 266.82,
  "text": "Four snaps."
 },
 {
  "i": 96,
  "start": 266.82,
  "end": 268.5,
  "text": "Ten seconds each."
 },
 {
  "i": 97,
  "start": 269.32,
  "end": 272.1,
  "text": "You've lived forty seconds more than everyone else today."
 },
 {
  "i": 98,
  "start": 273.56,
  "end": 275.0,
  "text": "In real life, that happens."
 },
 {
  "i": 99,
  "start": 275.84,
  "end": 276.94,
  "text": "Just much, much smaller."
 },
 {
  "i": 100,
  "start": 277.92,
  "end": 283.08,
  "text": "Satellites for GPS, the system behind maps on phones, carry super-accurate clocks."
 },
 {
  "i": 101,
  "start": 283.88,
  "end": 287.74,
  "text": "Up there, gravity is weaker, so their clocks tick a tiny bit faster."
 },
 {
  "i": 102,
  "start": 288.36,
  "end": 290.84,
  "text": "They're also moving fast, which slows them a little."
 },
 {
  "i": 103,
  "start": 291.52,
  "end": 297.48,
  "text": "Add it up, and they gain about thirty-eight millionths of a second every day, compared to clocks down here."
 },
 {
  "i": 104,
  "start": 298.14,
  "end": 299.36,
  "text": "Einstein predicted it."
 },
 {
  "i": 105,
  "start": 299.94,
  "end": 305.48,
  "text": "If engineers didn't correct for it, your map would soon be off by kilometres."
 },
 {
  "i": 106,
  "start": 305.48,
  "end": 306.06,
  "text": "Wednesday."
 },
 {
  "i": 107,
  "start": 306.92,
  "end": 307.46,
  "text": "Breakfast."
 },
 {
  "i": 108,
  "start": 308.4,
  "end": 311.16,
  "text": "Biscuit leaps for the butter again, and hits the milk jug."
 },
 {
  "i": 109,
  "start": 311.8,
  "end": 315.32,
  "text": "It tips off the table, straight towards Mina's school project."
 },
 {
  "i": 110,
  "start": 316.14,
  "end": 316.48,
  "text": "Snap."
 },
 {
  "i": 111,
  "start": 317.4,
  "end": 317.94,
  "text": "Light: moving."
 },
 {
  "i": 112,
  "start": 318.82,
  "end": 319.38,
  "text": "Air: moving."
 },
 {
  "i": 113,
  "start": 320.18,
  "end": 321.0,
  "text": "You take a breath."
 },
 {
  "i": 114,
  "start": 321.86,
  "end": 322.4,
  "text": "Rule three."
 },
 {
  "i": 115,
  "start": 323.1,
  "end": 324.56,
  "text": "You can't just put the jug back."
 },
 {
  "i": 116,
  "start": 325.26,
  "end": 326.24,
  "text": "It would still be falling."
 },
 {
  "i": 117,
  "start": 327.06,
  "end": 331.98,
  "text": "So you slide Mina's project away, and put the big mixing bowl underneath the jug."
 },
 {
  "i": 118,
  "start": 332.74,
  "end": 333.54,
  "text": "Time restarts."
 },
 {
  "i": 119,
  "start": 334.34,
  "end": 334.66,
  "text": "Splash."
 },
 {
  "i": 120,
  "start": 335.58,
  "end": 336.98,
  "text": "Every drop lands in the bowl."
 },
 {
  "i": 121,
  "start": 337.9,
  "end": 339.28,
  "text": "Mina looks at her dry project."
 },
 {
  "i": 122,
  "start": 340.02,
  "end": 340.72,
  "text": "Then at you."
 },
 {
  "i": 123,
  "start": 341.46,
  "end": 342.5,
  "text": "Then at her stopwatch."
 },
 {
  "i": 124,
  "start": 342.5,
  "end": 344.66,
  "text": "\"Zero point zero seconds.\""
 },
 {
  "i": 125,
  "start": 346.26,
  "end": 349.66,
  "text": "But during those ten seconds, something moved that shouldn't have."
 },
 {
  "i": 126,
  "start": 350.4,
  "end": 350.82,
  "text": "Biscuit."
 },
 {
  "i": 127,
  "start": 351.56,
  "end": 354.88,
  "text": "She blinked at you, stretched, and walked across the frozen kitchen."
 },
 {
  "i": 128,
  "start": 355.78,
  "end": 359.38,
  "text": "Maybe that's why cats always appear in places they couldn't have reached."
 },
 {
  "i": 129,
  "start": 360.06,
  "end": 361.08,
  "text": "Next morning, you snap."
 },
 {
  "i": 130,
  "start": 361.94,
  "end": 362.6,
  "text": "Nothing happens."
 },
 {
  "i": 131,
  "start": 363.48,
  "end": 364.32,
  "text": "Your snap is gone."
 },
 {
  "i": 132,
  "start": 365.24,
  "end": 366.2,
  "text": "Biscuit flicks her tail."
 },
 {
  "i": 133,
  "start": 367.04,
  "end": 369.76,
  "text": "And somehow, she's already on the table, eating your toast."
 },
 {
  "i": 134,
  "start": 371.3,
  "end": 373.42,
  "text": "In real life, nobody can stop time."
 },
 {
  "i": 135,
  "start": 374.1,
  "end": 378.3,
  "text": "And if it did stop, you'd be stuck in the dark, unable to breathe or move."
 },
 {
  "i": 136,
  "start": 379.0,
  "end": 380.44,
  "text": "But scientists have stopped light."
 },
 {
  "i": 137,
  "start": 381.26,
  "end": 390.98,
  "text": "In 2001, at Harvard, Lene Hau's team trapped a pulse of light in a cloud of super-cold atoms for about a thousandth of a second, then let it go again."
 },
 {
  "i": 138,
  "start": 391.78,
  "end": 393.74,
  "text": "Your brain stretches moments every day."
 },
 {
  "i": 139,
  "start": 394.44,
  "end": 397.22,
  "text": "And satellite clocks really do run at a different speed."
 },
 {
  "i": 140,
  "start": 397.98,
  "end": 401.38,
  "text": "So if you had ten frozen seconds, what would you do with them?"
 },
 {
  "i": 141,
  "start": 402.02,
  "end": 402.96,
  "text": "Tell us in the comments."
 },
 {
  "i": 142,
  "start": 403.8,
  "end": 405.38,
  "text": "And subscribe for more What Ifs."
 }
]