[
 {
  "i": 0,
  "start": 0.193,
  "end": 2.377,
  "text": "A newspaper said bat-people lived on the Moon."
 },
 {
  "i": 1,
  "start": 3.31,
  "end": 4.326,
  "text": "And people bought it."
 },
 {
  "i": 2,
  "start": 4.786,
  "end": 6.736,
  "text": "New York, August 1835."
 },
 {
  "i": 3,
  "start": 7.261,
  "end": 8.801,
  "text": "The Sun runs a front-page scoop."
 },
 {
  "i": 4,
  "start": 9.265,
  "end": 13.252,
  "text": "It says the famous astronomer John Herschel has seen life on the Moon."
 },
 {
  "i": 5,
  "start": 13.743,
  "end": 15.042,
  "text": "Through a giant new telescope."
 },
 {
  "i": 6,
  "start": 15.614,
  "end": 16.957,
  "text": "First, animals like bison."
 },
 {
  "i": 7,
  "start": 17.457,
  "end": 18.37,
  "text": "Then, unicorns."
 },
 {
  "i": 8,
  "start": 18.813,
  "end": 21.827,
  "text": "Then beavers, walking on two legs, carrying their babies."
 },
 {
  "i": 9,
  "start": 22.248,
  "end": 23.022,
  "text": "And finally..."
 },
 {
  "i": 10,
  "start": 23.525,
  "end": 24.012,
  "text": "people."
 },
 {
  "i": 11,
  "start": 24.466,
  "end": 25.331,
  "text": "With bat wings."
 },
 {
  "i": 12,
  "start": 25.765,
  "end": 26.186,
  "text": "Wait."
 },
 {
  "i": 13,
  "start": 26.64,
  "end": 27.861,
  "text": "Did Herschel really see that?"
 },
 {
  "i": 14,
  "start": 28.831,
  "end": 31.887,
  "text": "You see, Herschel was in South Africa, and had no idea."
 },
 {
  "i": 15,
  "start": 32.361,
  "end": 33.813,
  "text": "A writer at the Sun made it up."
 },
 {
  "i": 16,
  "start": 34.276,
  "end": 36.434,
  "text": "To poke fun at people, and to sell papers."
 },
 {
  "i": 17,
  "start": 36.87,
  "end": 41.211,
  "text": "According to one account, the story sold 60,000 copies as a pamphlet."
 },
 {
  "i": 18,
  "start": 41.688,
  "end": 42.29,
  "text": "And the Sun?"
 },
 {
  "i": 19,
  "start": 42.757,
  "end": 44.128,
  "text": "It never admitted it was fake."
 },
 {
  "i": 20,
  "start": 44.607,
  "end": 45.647,
  "text": "Subscribe for more."
 }
]