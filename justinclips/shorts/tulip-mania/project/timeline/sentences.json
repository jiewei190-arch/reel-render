[
 {
  "i": 0,
  "start": 0.0,
  "end": 1.88,
  "text": "A flower once cost more than a house."
 },
 {
  "i": 1,
  "start": 2.82,
  "end": 4.14,
  "text": "Holland, the 1630s."
 },
 {
  "i": 2,
  "start": 4.52,
  "end": 5.72,
  "text": "Everyone wanted tulips."
 },
 {
  "i": 3,
  "start": 6.24,
  "end": 8.48,
  "text": "The rarest ones had wild flame stripes..."
 },
 {
  "i": 4,
  "start": 9.24,
  "end": 10.0,
  "text": "caused by a virus."
 },
 {
  "i": 5,
  "start": 10.62,
  "end": 12.4,
  "text": "People traded bulbs still in the ground..."
 },
 {
  "i": 6,
  "start": 13.1,
  "end": 13.54,
  "text": "on paper..."
 },
 {
  "i": 7,
  "start": 14.32,
  "end": 15.32,
  "text": "in taverns."
 },
 {
  "i": 8,
  "start": 15.48,
  "end": 18.0,
  "text": "One bulb reportedly sold for 10,000 guilders."
 },
 {
  "i": 9,
  "start": 18.46,
  "end": 20.46,
  "text": "A craftsman made about 300 a year."
 },
 {
  "i": 10,
  "start": 20.94,
  "end": 22.9,
  "text": "Then, in February 1637..."
 },
 {
  "i": 11,
  "start": 23.5,
  "end": 24.4,
  "text": "the market crashed."
 },
 {
  "i": 12,
  "start": 24.4,
  "end": 26.72,
  "text": "But a historian who checked the records..."
 },
 {
  "i": 13,
  "start": 26.72,
  "end": 28.9,
  "text": "couldn't find anyone who went bankrupt."
 }
]