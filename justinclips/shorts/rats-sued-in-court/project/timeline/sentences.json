[
 {
  "i": 0,
  "start": 0.0,
  "end": 1.32,
  "text": "Rats once got sued."
 },
 {
  "i": 1,
  "start": 2.0,
  "end": 3.02,
  "text": "And they got a lawyer."
 },
 {
  "i": 2,
  "start": 3.68,
  "end": 5.38,
  "text": "France, the early 1500s."
 },
 {
  "i": 3,
  "start": 5.74,
  "end": 8.18,
  "text": "Rats reportedly ate the barley around Autun."
 },
 {
  "i": 4,
  "start": 8.18,
  "end": 9.68,
  "text": "So a court summoned the rats."
 },
 {
  "i": 5,
  "start": 10.34,
  "end": 10.8,
  "text": "The rats..."
 },
 {
  "i": 6,
  "start": 10.8,
  "end": 12.16,
  "text": "did not show up."
 },
 {
  "i": 7,
  "start": 12.44,
  "end": 15.7,
  "text": "Their lawyer said that was unfair: his clients lived in lots of villages."
 },
 {
  "i": 8,
  "start": 16.38,
  "end": 18.26,
  "text": "Then he said they couldn't come safely..."
 },
 {
  "i": 9,
  "start": 18.8,
  "end": 20.18,
  "text": "because of the town's cats."
 },
 {
  "i": 10,
  "start": 20.74,
  "end": 22.2,
  "text": "He wanted the cats kept indoors."
 },
 {
  "i": 11,
  "start": 22.82,
  "end": 24.08,
  "text": "The owners said no."
 },
 {
  "i": 12,
  "start": 24.08,
  "end": 26.74,
  "text": "So the case was reportedly thrown out."
 }
]