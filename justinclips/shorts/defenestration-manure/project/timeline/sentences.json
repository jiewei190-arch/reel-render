[
 {
  "i": 0,
  "start": 0.0,
  "end": 2.06,
  "text": "Three men got thrown out of a castle window."
 },
 {
  "i": 1,
  "start": 2.88,
  "end": 3.94,
  "text": "Prague, 1618."
 },
 {
  "i": 2,
  "start": 4.8,
  "end": 6.24,
  "text": "Angry nobles stormed the castle."
 },
 {
  "i": 3,
  "start": 6.8,
  "end": 9.16,
  "text": "They grabbed two royal governors and their secretary..."
 },
 {
  "i": 4,
  "start": 9.92,
  "end": 10.74,
  "text": "and out they went."
 },
 {
  "i": 5,
  "start": 11.26,
  "end": 12.68,
  "text": "About 70 feet down."
 },
 {
  "i": 6,
  "start": 13.08,
  "end": 14.08,
  "text": "All three survived."
 },
 {
  "i": 7,
  "start": 14.74,
  "end": 15.98,
  "text": "Catholics said angels caught them."
 },
 {
  "i": 8,
  "start": 16.52,
  "end": 17.5,
  "text": "Later pamphlets said..."
 },
 {
  "i": 9,
  "start": 18.04,
  "end": 19.52,
  "text": "they landed in a pile of manure."
 },
 {
  "i": 10,
  "start": 20.14,
  "end": 22.42,
  "text": "Historians think that part was probably made up."
 },
 {
  "i": 11,
  "start": 22.8,
  "end": 24.48,
  "text": "But the secretary got a noble title..."
 },
 {
  "i": 12,
  "start": 25.4,
  "end": 26.02,
  "text": "Baron von Hohenfall."
 },
 {
  "i": 13,
  "start": 26.6,
  "end": 27.52,
  "text": "Baron of High Fall."
 }
]