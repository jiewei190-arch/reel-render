[
 {
  "i": 0,
  "start": 0.0,
  "end": 2.66,
  "text": "In 1876, it rained meat in Kentucky."
 },
 {
  "i": 1,
  "start": 3.32,
  "end": 5.52,
  "text": "Chunks fell from a clear blue sky onto a farm."
 },
 {
  "i": 2,
  "start": 5.94,
  "end": 8.08,
  "text": "A woman making soap outside watched it land."
 },
 {
  "i": 3,
  "start": 8.52,
  "end": 10.44,
  "text": "Two men reportedly tasted it..."
 },
 {
  "i": 4,
  "start": 10.76,
  "end": 11.8,
  "text": "and guessed mutton."
 },
 {
  "i": 5,
  "start": 12.22,
  "end": 12.82,
  "text": "Or venison."
 },
 {
  "i": 6,
  "start": 12.82,
  "end": 16.02,
  "text": "Lab tests later found lung, muscle and cartilage."
 },
 {
  "i": 7,
  "start": 16.56,
  "end": 18.12,
  "text": "The most popular explanation?"
 },
 {
  "i": 8,
  "start": 18.88,
  "end": 19.28,
  "text": "Vultures."
 },
 {
  "i": 9,
  "start": 20.04,
  "end": 21.14,
  "text": "Throwing up mid-flight."
 }
]