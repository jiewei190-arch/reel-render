  "end": 2.08,
  "text": "Legend says two cities went to war over a bucket."
 },
 {
  "i": 1,
  "start": 2.76,
  "end": 3.7,
  "text": "The truth is pettier."
 },
 {
  "i": 2,
  "start": 4.36,
  "end": 8.58,
  "text": "In 1325, Bologna sent about 32,000 soldiers after little Modena."
 },
 {
  "i": 3,
  "start": 9.22,
  "end": 10.34,
  "text": "Modena had about 7,000..."
 },
 {
  "i": 4,
  "start": 10.34,
  "end": 11.56,
  "text": "and won."
 },
 {
  "i": 5,
  "start": 12.18,
  "end": 13.82,
  "text": "Then they reportedly marched to Bologna's gates..."
 },
 {
  "i": 6,
  "start": 14.6,
