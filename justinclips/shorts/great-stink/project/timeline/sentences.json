[
 {
  "i": 0,
  "start": 0.0,
  "end": 2.64,
  "text": "London stank so bad, Parliament had to act."
 },
 {
  "i": 1,
  "start": 3.28,
  "end": 4.58,
  "text": "Summer 1858."
 },
 {
  "i": 2,
  "start": 5.06,
  "end": 6.22,
  "text": "A heatwave hit the Thames."
 },
 {
  "i": 3,
  "start": 6.74,
  "end": 7.94,
  "text": "And the Thames..."
 },
 {
  "i": 4,
  "start": 7.94,
  "end": 9.68,
  "text": "was full of London's sewage."
 },
 {
  "i": 5,
  "start": 10.36,
  "end": 11.84,
  "text": "Parliament sits right on the river."
 },
 {
  "i": 6,
  "start": 12.3,
  "end": 14.16,
  "text": "So they soaked the curtains with chemicals."
 },
 {
  "i": 7,
  "start": 14.78,
  "end": 16.84,
  "text": "They even talked about moving Parliament out of London."
 },
 {
  "i": 8,
  "start": 17.42,
  "end": 20.04,
  "text": "Instead, they passed a new sewer law in about seven weeks."
 },
 {
  "i": 9,
  "start": 21.0,
  "end": 24.5,
  "text": "Engineer Joseph Bazalgette built 82 miles of giant sewers."
 },
 {
  "i": 10,
  "start": 24.98,
  "end": 26.34,
  "text": "London still uses them today."
 }
]