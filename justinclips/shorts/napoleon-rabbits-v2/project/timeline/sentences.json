[
 {
  "i": 0,
  "start": 0.0,
  "end": 1.32,
  "text": "Napoleon once lost a battle."
 },
 {
  "i": 1,
  "start": 1.32,
  "end": 2.06,
  "text": "To rabbits."
 },
 {
  "i": 2,
  "start": 2.68,
  "end": 5.42,
  "text": "After a peace treaty, his chief of staff threw a rabbit hunt."
 },
 {
  "i": 3,
  "start": 5.92,
  "end": 6.76,
  "text": "Hundreds of rabbits."
 },
 {
  "i": 4,
  "start": 7.14,
  "end": 8.38,
  "text": "Some accounts say thousands."
 },
 {
  "i": 5,
  "start": 8.96,
  "end": 10.0,
  "text": "The cages opened..."
 },
 {
  "i": 6,
  "start": 10.0,
  "end": 11.92,
  "text": "and the rabbits charged."
 },
 {
  "i": 7,
  "start": 12.32,
  "end": 12.92,
  "text": "At Napoleon."
 },
 {
  "i": 8,
  "start": 13.56,
  "end": 14.36,
  "text": "Tame farm rabbits."
 },
 {
  "i": 9,
  "start": 15.18,
  "end": 16.18,
  "text": "They thought he had food."
 },
 {
  "i": 10,
  "start": 16.64,
  "end": 19.28,
  "text": "A general wrote that the conqueror of conquerors..."
 },
 {
  "i": 11,
  "start": 19.28,
  "end": 20.2,
  "text": "retreated."
 },
 {
  "i": 12,
  "start": 20.92,
  "end": 21.72,
  "text": "He fled to his carriage."
 },
 {
  "i": 13,
  "start": 22.2,
  "end": 23.7,
  "text": "Some reportedly hopped in after him."
 }
]