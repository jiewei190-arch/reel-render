[
 {
  "i": 0,
  "start": 0.0,
  "end": 1.9,
  "text": "A man sold a country that didn't exist."
 },
 {
  "i": 1,
  "start": 2.44,
  "end": 7.0,
  "text": "In 1822, Gregor MacGregor told London he ruled a land called Poyais."
 },
 {
  "i": 2,
  "start": 7.0,
  "end": 9.22,
  "text": "He printed a guidebook, its own money..."
 },
 {
  "i": 3,
  "start": 9.8,
  "end": 11.12,
  "text": "and sold its government bonds."
 },
 {
  "i": 4,
  "start": 12.14,
  "end": 14.0,
  "text": "Investors bought about 200,000 pounds of them."
 },
 {
  "i": 5,
  "start": 14.54,
  "end": 16.92,
  "text": "Then about 250 settlers sailed there."
 },
 {
  "i": 6,
  "start": 17.3,
  "end": 17.82,
  "text": "They found..."
 },
 {
  "i": 7,
  "start": 17.82,
  "end": 19.0,
  "text": "jungle."
 },
 {
  "i": 8,
  "start": 19.46,
  "end": 20.04,
  "text": "No towns."
 },
 {
  "i": 9,
  "start": 20.46,
  "end": 20.94,
  "text": "No capital."
 },
 {
  "i": 10,
  "start": 21.28,
  "end": 21.74,
  "text": "No country."
 },
 {
  "i": 11,
  "start": 22.38,
  "end": 23.3,
  "text": "It went very badly."
 },
 {
  "i": 12,
  "start": 23.3,
  "end": 25.76,
  "text": "MacGregor was later tried for fraud in France..."
 },
 {
  "i": 13,
  "start": 26.26,
  "end": 27.56,
  "text": "and acquitted."
 }
]