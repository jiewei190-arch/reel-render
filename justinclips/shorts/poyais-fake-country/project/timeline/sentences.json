[
 {
  "i": 0,
  "start": 0.0,
  "end": 1.66,
  "text": "A man sold a country that didn't exist."
 },
 {
  "i": 1,
  "start": 2.14,
  "end": 6.14,
  "text": "In 1822, Gregor MacGregor told London he ruled a land called Poyais."
 },
 {
  "i": 2,
  "start": 6.52,
  "end": 8.1,
  "text": "He printed a guidebook, its own money..."
 },
 {
  "i": 3,
  "start": 8.2,
  "end": 9.18,
  "text": "and sold its government bonds."
 },
 {
  "i": 4,
  "start": 10.0,
  "end": 12.06,
  "text": "Investors bought about 200,000 pounds of them."
 },
 {
  "i": 5,
  "start": 12.4,
  "end": 14.52,
  "text": "Then about 250 settlers sailed there."
 },
 {
  "i": 6,
  "start": 14.92,
  "end": 15.28,
  "text": "They found..."
 },
 {
  "i": 7,
  "start": 15.28,
  "end": 15.6,
  "text": "jungle."
 },
 {
  "i": 8,
  "start": 15.78,
  "end": 16.22,
  "text": "No towns."
 },
 {
  "i": 9,
  "start": 16.52,
  "end": 16.96,
  "text": "No capital."
 },
 {
  "i": 10,
  "start": 17.16,
  "end": 17.62,
  "text": "No country."
 },
 {
  "i": 11,
  "start": 17.96,
  "end": 18.8,
  "text": "It went very badly."
 },
 {
  "i": 12,
  "start": 19.32,
  "end": 20.96,
  "text": "MacGregor was later tried for fraud in France..."
 },
 {
  "i": 13,
  "start": 20.96,
  "end": 21.42,
  "text": "and acquitted."
 }
]