[
 {
  "i": 0,
  "start": 0.0,
  "end": 2.68,
  "text": "America and Britain almost went to war over a pig."
 },
 {
  "i": 1,
  "start": 3.24,
  "end": 7.58,
  "text": "In 1859, on an island both sides claimed, a British company's pig got into an American's garden."
 },
 {
  "i": 2,
  "start": 7.98,
  "end": 8.5,
  "text": "He shot it."
 },
 {
  "i": 3,
  "start": 8.82,
  "end": 9.88,
  "text": "He offered 10 dollars."
 },
 {
  "i": 4,
  "start": 9.88,
  "end": 11.08,
  "text": "The British wanted 100."
 },
 {
  "i": 5,
  "start": 11.58,
  "end": 12.62,
  "text": "Britain threatened to arrest him..."
 },
 {
  "i": 6,
  "start": 13.02,
  "end": 14.06,
  "text": "so America sent soldiers."
 },
 {
  "i": 7,
  "start": 14.52,
  "end": 17.46,
  "text": "Soon, 461 American troops faced five British warships."
 },
 {
  "i": 8,
  "start": 18.14,
  "end": 18.96,
  "text": "Nobody fired a shot."
 },
 {
  "i": 9,
  "start": 19.48,
  "end": 20.32,
  "text": "The only casualty..."
 },
 {
  "i": 10,
  "start": 20.32,
  "end": 21.4,
  "text": "was the pig."
 }
]