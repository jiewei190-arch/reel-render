[
 {
  "i": 0,
  "start": 0.0,
  "end": 2.3,
  "text": "In 1970, Oregon blew up a whale."
 },
 {
  "i": 1,
  "start": 2.76,
  "end": 5.02,
  "text": "An explosives guy said 20 sticks would do it."
 },
 {
  "i": 2,
  "start": 5.36,
  "end": 6.78,
  "text": "They used..."
 },
 {
  "i": 3,
  "start": 6.78,
  "end": 7.44,
  "text": "20 cases."
 },
 {
  "i": 4,
  "start": 8.0,
  "end": 11.92,
  "text": "The news said the blast blasted blubber beyond all believable bounds."
 },
 {
  "i": 5,
  "start": 12.56,
  "end": 14.42,
  "text": "One chunk reportedly flew a quarter mile..."
 },
 {
  "i": 6,
  "start": 15.16,
  "end": 16.94,
  "text": "and crushed a brand new car."
 },
 {
  "i": 7,
  "start": 17.48,
  "end": 18.1,
  "text": "Most of the whale..."
 },
 {
  "i": 8,
  "start": 18.1,
  "end": 19.42,
  "text": "was still there."
 },
 {
  "i": 9,
  "start": 19.88,
  "end": 21.02,
  "text": "Oregon now buries whales."
 },
 {
  "i": 10,
  "start": 21.48,
  "end": 23.3,
  "text": "And named a park after this one..."
 },
 {
  "i": 11,
  "start": 23.94,
  "end": 25.34,
  "text": "Exploding Whale Memorial Park."
 }
]