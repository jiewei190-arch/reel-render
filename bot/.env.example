# Copy to bot/.env (git-ignored) and fill in. Never commit or paste these keys anywhere.
# Claude: by default reelbot uses the Claude Code CLI logged in on this PC (your Claude subscription, no API key).
# Leave ANTHROPIC_API_KEY empty for that. To use the paid API instead, set REELBOT_CLAUDE_BACKEND=api and the key.
# REELBOT_CLAUDE_BACKEND=cli
# REELBOT_CLAUDE_CLI=C:\Users\jiewe\AppData\Roaming\npm\claude.cmd
ANTHROPIC_API_KEY=
# Gemini is OPTIONAL and off by default (free mode: research + fact-check use Claude Code's web search,
# the voice listen-back is a local faster-whisper check, the AI editor uses Claude on stills).
# To use Gemini as well: REELBOT_USE_GEMINI=1 and a billed GEMINI_API_KEY.
# REELBOT_USE_GEMINI=1
GEMINI_API_KEY=
ELEVENLABS_API_KEY=

# Paths on the PC (defaults shown)
# REELBOT_RENDER_ROOT=C:\Users\jiewe\rr-v1\finance\render-pc   (default if it exists; blocky-render is an old copy)
# REELBOT_SHORTS_DIR=C:\Users\jiewe\reel-render\bot\work\shorts
# REELBOT_AUDIO_DIR=C:\Users\jiewe\toon3d-audio
# REELBOT_ANALYTICS_DIR=C:\Users\jiewe\analytics-raw\analytics\raw
# REELBOT_OUTPUT_DIR=C:\Users\jiewe\Videos\BlockMoney
# REELBOT_BASH=C:\Program Files\Git\bin\bash.exe

# Models (defaults shown)
# REELBOT_CLAUDE_MODEL=claude-opus-5-5
# REELBOT_CLAUDE_EFFORT=high
# REELBOT_GEMINI_MODEL=gemini-3.8-flash
# REELBOT_ELEVEN_MODEL=eleven_v4

# Cloud rendering on AWS Lambda (optional; steps in aws/SETUP.md). Paste your own keys here, never in chat.
# REMOTION_AWS_ACCESS_KEY_ID=
# REMOTION_AWS_SECRET_ACCESS_KEY=
# REMOTION_AWS_REGION=us-east-1
# REELBOT_RENDER_ON=pc          # or lambda
# REELBOT_MOTION_BLUR=0         # default off (4x faster renders); 1 = smooth motion blur, PC and Lambda

# Claude: API credits first, then your Claude plan (default when a key is set = "auto").
# When the key's credit or monthly spend cap runs out, the same call is redone through the Claude Code login
# (subscription) and the API is tried again after REELBOT_API_RETRY_HOURS. Paste the key yourself; never in chat.
# ANTHROPIC_API_KEY=
# ANTHROPIC_API_KEY_2=        # more keys are used one after another (_2, _3, ... up to _20)
# ANTHROPIC_API_KEY_3=
# REELBOT_CLAUDE_BACKEND=auto        # auto | api (key only) | cli (plan only)
# REELBOT_API_RETRY_HOURS=12
