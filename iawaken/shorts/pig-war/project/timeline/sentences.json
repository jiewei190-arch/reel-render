[
 {
  "i": 0,
  "start": 0.0,
  "end": 2.98,
  "text": "America and Britain almost went to war over a pig."
 },
 {
  "i": 1,
  "start": 4.0,
  "end": 5.4,
  "text": "The pig was the only casualty."
 },
 {
  "i": 2,
  "start": 5.94,
  "end": 7.58,
  "text": "It's eighteen fifty-nine."
 },
 {
  "i": 3,
  "start": 7.58,
  "end": 8.98,
  "text": "Both countries claim one island."
 },
 {
  "i": 4,
  "start": 9.44,
  "end": 12.74,
  "text": "A British company's pig eats an American farmer's potatoes."
 },
 {
  "i": 5,
  "start": 13.28,
  "end": 14.14,
  "text": "So he shoots it."
 },
 {
  "i": 6,
  "start": 14.6,
  "end": 16.02,
  "text": "Britain threatens to arrest him."
 },
 {
  "i": 7,
  "start": 16.4,
  "end": 17.46,
  "text": "The US Army lands."
 },
 {
  "i": 8,
  "start": 18.04,
  "end": 19.0,
  "text": "Britain sends warships."
 },
 {
  "i": 9,
  "start": 19.88,
  "end": 20.92,
  "text": "All over one pig."
 },
 {
  "i": 10,
  "start": 21.42,
  "end": 24.24,
  "text": "But a British admiral refuses to fight over a pig."
 },
 {
  "i": 11,
  "start": 24.66,
  "end": 26.26,
  "text": "So both armies share the island."
 },
 {
  "i": 12,
  "start": 26.7,
  "end": 27.48,
  "text": "For twelve years."
 },
 {
  "i": 13,
  "start": 28.04,
  "end": 29.7,
  "text": "Then Germany's emperor settles it."
 },
 {
  "i": 14,
  "start": 30.12,
  "end": 31.26,
  "text": "The US gets the island."
 },
 {
  "i": 15,
  "start": 32.18,
  "end": 33.82,
  "text": "And the pig gets a bronze statue."
 },
 {
  "i": 16,
  "start": 34.32,
  "end": 35.62,
  "text": "With a potato in its mouth."
 },
 {
  "i": 17,
  "start": 36.12,
  "end": 37.04,
  "text": "Subscribe for more."
 }
]