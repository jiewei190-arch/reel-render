[
 {
  "i": 0,
  "start": 0.0,
  "end": 1.34,
  "text": "You have about ten seconds."
 },
 {
  "i": 1,
  "start": 1.78,
  "end": 2.4,
  "text": "Use them."
 },
 {
  "i": 2,
  "start": 2.92,
  "end": 4.02,
  "text": "You just stepped into space."
 },
 {
  "i": 3,
  "start": 4.62,
  "end": 5.22,
  "text": "No suit."
 },
 {
  "i": 4,
  "start": 6.02,
  "end": 7.02,
  "text": "But you don't explode."
 },
 {
  "i": 5,
  "start": 7.62,
  "end": 8.44,
  "text": "That's a movie thing."
 },
 {
  "i": 6,
  "start": 8.94,
  "end": 10.22,
  "text": "You don't freeze solid either."
 },
 {
  "i": 7,
  "start": 10.88,
  "end": 12.66,
  "text": "Space is basically a giant thermos."
 },
 {
  "i": 8,
  "start": 13.14,
  "end": 14.24,
  "text": "The spit on your tongue, though?"
 },
 {
  "i": 9,
  "start": 15.1,
  "end": 15.66,
  "text": "That boils."
 },
 {
  "i": 10,
  "start": 16.34,
  "end": 17.4,
  "text": "In 1966,"
 },
 {
  "i": 11,
  "start": 18.24,
  "end": 20.6,
  "text": "a NASA test volunteer felt it bubbling..."
 },
 {
  "i": 12,
  "start": 21.02,
  "end": 22.3,
  "text": "right before he blacked out."
 },
 {
  "i": 13,
  "start": 22.78,
  "end": 26.2,
  "text": "Because about ten seconds in, your brain runs out of oxygen."
 },
 {
  "i": 14,
  "start": 26.77,
  "end": 27.48,
  "text": "Lights out."
 },
 {
  "i": 15,
  "start": 27.98,
  "end": 28.68,
  "text": "That volunteer?"
 },
 {
  "i": 16,
  "start": 29.3,
  "end": 31.8,
  "text": "They pumped the air back in, in under ninety seconds."
 },
 {
  "i": 17,
  "start": 32.68,
  "end": 33.54,
  "text": "He woke up fine."
 },
 {
  "i": 18,
  "start": 34.12,
  "end": 35.08,
  "text": "Subscribe for more."
 }
