[
 {
  "i": 0,
  "start": 0.0,
  "end": 1.32,
  "text": "You have about ten seconds."
 },
 {
  "i": 1,
  "start": 1.8,
  "end": 2.4,
  "text": "Use them."
 },
 {
  "i": 2,
  "start": 2.92,
  "end": 4.02,
  "text": "You just stepped into space."
 },
 {
  "i": 3,
  "start": 4.62,
  "end": 5.22,
  "text": "No suit."
 },
 {
  "i": 4,
  "start": 5.96,
  "end": 7.02,
  "text": "But you don't explode."
 },
 {
  "i": 5,
  "start": 7.64,
  "end": 8.44,
  "text": "That's a movie thing."
 },
 {
  "i": 6,
  "start": 8.96,
  "end": 10.22,
  "text": "You don't freeze solid either."
 },
 {
  "i": 7,
  "start": 10.88,
  "end": 12.68,
  "text": "Space is basically a giant thermos."
 },
 {
  "i": 8,
  "start": 13.16,
  "end": 14.22,
  "text": "The spit on your tongue, though?"
 },
 {
  "i": 9,
  "start": 15.14,
  "end": 15.64,
  "text": "That boils."
 },
 {
  "i": 10,
  "start": 16.34,
  "end": 20.26,
  "text": "In nineteen sixty-six, a NASA test volunteer felt it bubbling..."
 },
 {
  "i": 11,
  "start": 20.7,
  "end": 21.98,
  "text": "right before he blacked out."
 },
 {
  "i": 12,
  "start": 22.44,
  "end": 25.86,
  "text": "Because about ten seconds in, your brain runs out of oxygen."
 },
 {
  "i": 13,
  "start": 26.43,
  "end": 27.12,
  "text": "Lights out."
 },
 {
  "i": 14,
  "start": 27.64,
  "end": 28.32,
  "text": "That volunteer?"
 },
 {
  "i": 15,
  "start": 28.96,
  "end": 31.46,
  "text": "They pumped the air back in, in under ninety seconds."
 },
 {
  "i": 16,
  "start": 32.34,
  "end": 33.2,
  "text": "He woke up fine."
 },
 {
  "i": 17,
  "start": 33.76,
  "end": 34.72,
  "text": "Subscribe for more."
 }
]