[
 {
  "i": 0,
  "start": 0.0,
  "end": 1.42,
  "text": "His college banned dogs."
 },
 {
  "i": 1,
  "start": 1.82,
  "end": 2.74,
  "text": "So he got a bear."
 },
 {
  "i": 2,
  "start": 3.3,
  "end": 6.12,
  "text": "According to legend, the rules said nothing about bears."
 },
 {
  "i": 3,
  "start": 6.76,
  "end": 10.66,
  "text": "This is the poet Lord Byron, a student at Trinity College, Cambridge."
 },
 {
  "i": 4,
  "start": 11.44,
  "end": 11.64,
  "text": "Dogs?"
 },
 {
  "i": 5,
  "start": 12.4,
  "end": 12.8,
  "text": "Not allowed."
 },
 {
  "i": 6,
  "start": 13.6,
  "end": 14.16,
  "text": "Bears?"
 },
 {
  "i": 7,
  "start": 14.84,
  "end": 15.62,
  "text": "Apparently fine."
 },
 {
  "i": 8,
  "start": 16.18,
  "end": 21.18,
  "text": "In eighteen-oh-seven, he wrote to a friend: I have a new friend, the finest in the world."
 },
 {
  "i": 9,
  "start": 22.16,
  "end": 22.8,
  "text": "A tame bear."
 },
 {
  "i": 10,
  "start": 23.34,
  "end": 25.3,
  "text": "They asked him what he planned to do with it."
 },
 {
  "i": 11,
  "start": 25.94,
  "end": 27.72,
  "text": "He said it should sit for a fellowship."
 },
 {
  "i": 12,
  "start": 28.52,
  "end": 31.46,
  "text": "Cambridge is still telling the story two hundred years later."
 },
 {
  "i": 13,
  "start": 32.0,
  "end": 32.88,
  "text": "Subscribe for more."
 }
]