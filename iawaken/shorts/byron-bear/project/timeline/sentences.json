[
 {
  "i": 0,
  "start": 0.0,
  "end": 1.42,
  "text": "His college banned dogs."
 },
 {
  "i": 1,
  "start": 1.82,
  "end": 2.76,
  "text": "So he got a bear."
 },
 {
  "i": 2,
  "start": 3.34,
  "end": 6.14,
  "text": "According to legend, the rules said nothing about bears."
 },
 {
  "i": 3,
  "start": 6.78,
  "end": 10.66,
  "text": "This is the poet Lord Byron, a student at Trinity College, Cambridge."
 },
 {
  "i": 4,
  "start": 11.42,
  "end": 11.64,
  "text": "Dogs?"
 },
 {
  "i": 5,
  "start": 12.42,
  "end": 12.82,
  "text": "Not allowed."
 },
 {
  "i": 6,
  "start": 13.6,
  "end": 14.16,
  "text": "Bears?"
 },
 {
  "i": 7,
  "start": 14.86,
  "end": 15.62,
  "text": "Apparently fine."
 },
 {
  "i": 8,
  "start": 16.18,
  "end": 22.04,
  "text": "In 1807, he wrote to a friend: I have a new friend, the finest in the world."
 },
 {
  "i": 9,
  "start": 23.02,
  "end": 23.66,
  "text": "A tame bear."
 },
 {
  "i": 10,
  "start": 24.22,
  "end": 26.14,
  "text": "They asked him what he planned to do with it."
 },
 {
  "i": 11,
  "start": 26.77,
  "end": 28.58,
  "text": "He said it should sit for a fellowship."
 },
 {
  "i": 12,
  "start": 29.5,
  "end": 32.32,
  "text": "Cambridge is still telling the story two hundred years later."
 },
 {
  "i": 13,
  "start": 32.86,
  "end": 33.74,
  "text": "Subscribe for more."
 }
]