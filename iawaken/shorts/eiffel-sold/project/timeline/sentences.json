[
 {
  "i": 0,
  "start": 0.0,
  "end": 1.6,
  "text": "This man sold the Eiffel Tower."
 },
 {
  "i": 1,
  "start": 2.1,
  "end": 2.36,
  "text": "Twice."
 },
 {
  "i": 2,
  "start": 3.62,
  "end": 4.52,
  "text": "He didn't own it."
 },
 {
  "i": 3,
  "start": 4.82,
  "end": 6.14,
  "text": "Paris, 1925."
 },
 {
  "i": 4,
  "start": 7.04,
  "end": 9.72,
  "text": "Victor Lustig poses as a French government official."
 },
 {
  "i": 5,
  "start": 10.2,
  "end": 12.9,
  "text": "He tells scrap dealers the city will tear the tower down."
 },
 {
  "i": 6,
  "start": 12.9,
  "end": 14.7,
  "text": "Seven thousand tons of metal."
 },
 {
  "i": 7,
  "start": 15.2,
  "end": 15.68,
  "text": "For sale."
 },
 {
  "i": 8,
  "start": 16.3,
  "end": 18.24,
  "text": "One dealer, André Poisson, pays up."
 },
 {
  "i": 9,
  "start": 18.74,
  "end": 19.44,
  "text": "Lustig vanishes."
 },
 {
  "i": 10,
  "start": 20.1,
  "end": 23.36,
  "text": "According to the story, Poisson was too embarrassed to tell anyone."
 },
 {
  "i": 11,
  "start": 24.28,
  "end": 27.24,
  "text": "So Lustig came back, and ran the exact same scam."
 },
 {
  "i": 12,
  "start": 27.24,
  "end": 28.04,
  "text": "Again."
 },
 {
  "i": 13,
  "start": 28.68,
  "end": 30.4,
  "text": "This time, a dealer went to the police."
 },
 {
  "i": 14,
  "start": 31.6,
  "end": 32.16,
  "text": "Lustig just..."
 },
 {
  "i": 15,
  "start": 32.78,
  "end": 33.52,
  "text": "left the country."
 },
 {
  "i": 16,
  "start": 34.02,
  "end": 34.38,
  "text": "Again."
 },
 {
  "i": 17,
  "start": 35.0,
  "end": 35.86,
  "text": "Subscribe for more."
 }
]