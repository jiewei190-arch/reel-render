[
 {
  "i": 0,
  "start": 0.0,
  "end": 1.6,
  "text": "This man sold the Eiffel Tower."
 },
 {
  "i": 1,
  "start": 2.12,
  "end": 2.34,
  "text": "Twice."
 },
 {
  "i": 2,
  "start": 3.56,
  "end": 4.46,
  "text": "He didn't own it."
 },
 {
  "i": 3,
  "start": 4.82,
  "end": 6.76,
  "text": "Paris, nineteen twenty-five."
 },
 {
  "i": 4,
  "start": 6.76,
  "end": 9.42,
  "text": "Victor Lustig poses as a French government official."
 },
 {
  "i": 5,
  "start": 9.88,
  "end": 12.58,
  "text": "He tells scrap dealers the city will tear the tower down."
 },
 {
  "i": 6,
  "start": 12.58,
  "end": 14.4,
  "text": "Seven thousand tons of metal."
 },
 {
  "i": 7,
  "start": 14.94,
  "end": 15.38,
  "text": "For sale."
 },
 {
  "i": 8,
  "start": 16.0,
  "end": 17.94,
  "text": "One dealer, André Poisson, pays up."
 },
 {
  "i": 9,
  "start": 18.42,
  "end": 19.12,
  "text": "Lustig vanishes."
 },
 {
  "i": 10,
  "start": 19.78,
  "end": 23.06,
  "text": "According to the story, Poisson was too embarrassed to tell anyone."
 },
 {
  "i": 11,
  "start": 23.96,
  "end": 26.94,
  "text": "So Lustig came back, and ran the exact same scam."
 },
 {
  "i": 12,
  "start": 26.94,
  "end": 27.74,
  "text": "Again."
 },
 {
  "i": 13,
  "start": 28.38,
  "end": 30.12,
  "text": "This time, a dealer went to the police."
 },
 {
  "i": 14,
  "start": 31.3,
  "end": 31.88,
  "text": "Lustig just..."
 },
 {
  "i": 15,
  "start": 32.5,
  "end": 33.22,
  "text": "left the country."
 },
 {
  "i": 16,
  "start": 33.72,
  "end": 34.08,
  "text": "Again."
 },
 {
  "i": 17,
  "start": 34.7,
  "end": 35.56,
  "text": "Subscribe for more."
 }
]