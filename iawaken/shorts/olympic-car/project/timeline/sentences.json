[
 {
  "i": 0,
  "start": 0.0,
  "end": 2.3,
  "text": "The Olympic marathon winner rode in a car."
 },
 {
  "i": 1,
  "start": 2.72,
  "end": 3.84,
  "text": "He crossed the line first."
 },
 {
  "i": 2,
  "start": 4.52,
  "end": 5.46,
  "text": "Then someone noticed."
 },
 {
  "i": 3,
  "start": 6.06,
  "end": 8.5,
  "text": "Fred Lorz quit at mile nine, and hopped in a car."
 },
 {
  "i": 4,
  "start": 8.9,
  "end": 10.9,
  "text": "When it broke down, he jogged the rest."
 },
 {
  "i": 5,
  "start": 11.42,
  "end": 15.96,
  "text": "The real winner, Thomas Hicks, was kept going with strychnine, egg whites, and brandy."
 },
 {
  "i": 6,
  "start": 16.62,
  "end": 18.2,
  "text": "1904 sports science."
 },
 {
  "i": 7,
  "start": 18.62,
  "end": 24.88,
  "text": "And according to legend, a Cuban runner stopped for some rotten apples, took a nap, and still finished fourth."
 },
 {
  "i": 8,
  "start": 25.56,
  "end": 26.16,
  "text": "The winning time?"
 },
 {
  "i": 9,
  "start": 26.68,
  "end": 28.08,
  "text": "The slowest in Olympic history."
 },
 {
  "i": 10,
  "start": 28.75,
  "end": 29.9,
  "text": "By almost half an hour."
 },
 {
  "i": 11,
  "start": 30.36,
  "end": 31.42,
  "text": "Subscribe for more."
 }
]