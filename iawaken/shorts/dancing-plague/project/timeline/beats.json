[
 {
  "i": 0,
  "start": 0.0,
  "speechStart": 0.0,
  "speechEnd": 2.08,
  "text": "In 1518,",
  "end": 2.33
 },
 {
  "i": 1,
  "start": 2.33,
  "speechStart": 2.48,
  "speechEnd": 5.58,
  "text": "a whole city couldn't stop dancing. The doctors' cure?",
  "end": 6.53
 },
 {
  "i": 2,
  "start": 6.53,
  "speechStart": 6.68,
  "speechEnd": 7.34,
  "text": "More dancing.",
  "end": 7.19
 },
 {
  "i": 3,
  "start": 7.19,
  "speechStart": 7.34,
  "speechEnd": 8.8,
  "text": "Strasbourg, July.",
  "end": 9.27
 },
 {
  "i": 4,
  "start": 9.27,
  "speechStart": 9.42,
  "speechEnd": 12.26,
  "text": "A woman named Frau Troffea starts dancing in the street.",
  "end": 12.63
 },
 {
  "i": 5,
  "start": 12.63,
  "speechStart": 12.78,
  "speechEnd": 13.24,
  "text": "For days.",
  "end": 13.71
 },
 {
  "i": 6,
  "start": 13.71,
  "speechStart": 13.86,
  "speechEnd": 15.02,
  "text": "Then dozens join her.",
  "end": 15.55
 },
 {
  "i": 7,
  "start": 15.55,
  "speechStart": 15.7,
  "speechEnd": 18.28,
  "text": "According to chronicles, maybe four hundred.",
  "end": 18.13
 },
 {
  "i": 8,
  "start": 18.13,
  "speechStart": 18.28,
  "speechEnd": 19.56,
  "text": "Doctors blame hot blood.",
  "end": 19.87
 },
 {
  "i": 9,
  "start": 19.87,
  "speechStart": 20.02,
  "speechEnd": 23.34,
  "text": "So the city builds a stage... and hires a band.",
  "end": 23.73
 },
 {
  "i": 10,
  "start": 23.73,
  "speechStart": 23.88,
  "speechEnd": 24.78,
  "text": "It made things worse.",
  "end": 25.17
 },
 {
  "i": 11,
  "start": 25.17,
  "speechStart": 25.32,
  "speechEnd": 26.24,
  "text": "So they banned music.",
  "end": 26.09
 },
 {
  "i": 12,
  "start": 26.09,
  "speechStart": 26.24,
  "speechEnd": 28.36,
  "text": "Historians think it was stress:",
  "end": 28.59
 },
 {
  "i": 13,
  "start": 28.59,
  "speechStart": 28.74,
  "speechEnd": 30.42,
  "text": "famine, sickness and fear,",
  "end": 30.27
 },
 {
  "i": 14,
  "start": 30.27,
  "speechStart": 30.42,
  "speechEnd": 31.94,
  "text": "spreading person to person.",
  "end": 32.35
 },
 {
  "i": 15,
  "start": 32.35,
  "speechStart": 32.5,
  "speechEnd": 35.42,
  "text": "And it all started with one step. Subscribe for more.",
  "end": 36.92
 }
]