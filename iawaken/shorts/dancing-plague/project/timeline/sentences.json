[
 {
  "i": 0,
  "start": 0.0,
  "end": 3.04,
  "text": "In fifteen eighteen, a whole city couldn't stop dancing."
 },
 {
  "i": 1,
  "start": 3.56,
  "end": 4.36,
  "text": "The doctors' cure?"
 },
 {
  "i": 2,
  "start": 5.46,
  "end": 6.12,
  "text": "More dancing."
 },
 {
  "i": 3,
  "start": 6.12,
  "end": 7.56,
  "text": "Strasbourg, July."
 },
 {
  "i": 4,
  "start": 8.16,
  "end": 11.06,
  "text": "A woman named Frau Troffea starts dancing in the street."
 },
 {
  "i": 5,
  "start": 11.56,
  "end": 12.0,
  "text": "For days."
 },
 {
  "i": 6,
  "start": 12.64,
  "end": 13.78,
  "text": "Then dozens join her."
 },
 {
  "i": 7,
  "start": 14.48,
  "end": 17.1,
  "text": "According to chronicles, maybe four hundred."
 },
 {
  "i": 8,
  "start": 17.1,
  "end": 18.34,
  "text": "Doctors blame hot blood."
 },
 {
  "i": 9,
  "start": 18.88,
  "end": 20.22,
  "text": "So the city builds a stage..."
 },
 {
  "i": 10,
  "start": 21.2,
  "end": 22.12,
  "text": "and hires a band."
 },
 {
  "i": 11,
  "start": 22.66,
  "end": 23.56,
  "text": "It made things worse."
 },
 {
  "i": 12,
  "start": 24.2,
  "end": 25.02,
  "text": "So they banned music."
 },
 {
  "i": 13,
  "start": 25.78,
  "end": 30.72,
  "text": "Historians think it was stress: famine, sickness and fear, spreading person to person."
 },
 {
  "i": 14,
  "start": 31.28,
  "end": 32.76,
  "text": "And it all started with one step."
 },
 {
  "i": 15,
  "start": 33.32,
  "end": 34.2,
  "text": "Subscribe for more."
 }
]